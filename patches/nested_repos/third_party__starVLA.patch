+class PatchStructureLossTest(unittest.TestCase):
+    def test_projection_free_loss_is_rotation_invariant(self):
+        torch.manual_seed(17)
+        student = torch.randn(2, 7, 5, requires_grad=True)
+        rotation, _ = torch.linalg.qr(torch.randn(5, 5))
+        teacher = (student.detach() @ rotation).requires_grad_(True)
+        loss = patch_structure_alignment_loss(student, teacher)
+        self.assertAlmostEqual(float(loss), 0.0, places=6)
+        loss.backward()
+        self.assertIsNotNone(student.grad)
+        self.assertIsNone(teacher.grad)
