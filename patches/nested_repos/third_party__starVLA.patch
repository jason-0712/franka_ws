index 0000000..68b10ae
--- /dev/null
+++ b/starVLA/model/modules/spatial_forcing/action_conditioning.py
@@ -0,0 +1,328 @@
+"""Training-only-teacher, RGB-only zero-gated action conditioning."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+import math
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+def _find_image_token_spans(
+    input_ids: torch.Tensor,
+    image_token_id: int,
+    expected_num_views: int,
+) -> list[list[torch.Tensor]]:
+    if input_ids.ndim != 2:
+        raise ValueError(f"input_ids must have shape [B,L], got {tuple(input_ids.shape)}")
+    spans_by_sample: list[list[torch.Tensor]] = []
+    for sample_index in range(input_ids.shape[0]):
+        positions = torch.where(input_ids[sample_index] == image_token_id)[0]
+        if positions.numel() == 0:
+            raise ValueError(f"Sample {sample_index} contains no image tokens")
+        split_points = torch.where(torch.diff(positions) > 1)[0] + 1
+        spans = list(torch.tensor_split(positions, split_points.cpu().tolist()))
+        if len(spans) != expected_num_views:
+            raise ValueError(
+                f"Sample {sample_index} exposes {len(spans)} image-token spans, "
+                f"expected {expected_num_views}"
+            )
+        spans_by_sample.append(spans)
+    return spans_by_sample
+
+
+class _PerViewGatedCrossAttention(nn.Module):
+    def __init__(
+        self,
+        *,
+        hidden_dim: int,
+        attention_dim: int,
+        num_heads: int,
+        num_views: int,
+        dropout: float,
+        gate_init: float,
+    ) -> None:
+        super().__init__()
+        if attention_dim % num_heads:
+            raise ValueError("attention_dim must be divisible by num_heads")
+        self.attention_dim = int(attention_dim)
+        self.num_heads = int(num_heads)
+        self.head_dim = self.attention_dim // self.num_heads
+        self.num_views = int(num_views)
+        self.query_norm = nn.LayerNorm(hidden_dim)
+        self.spatial_norm = nn.LayerNorm(hidden_dim)
+        self.q_proj = nn.Linear(hidden_dim, attention_dim)
+        self.k_proj = nn.Linear(hidden_dim, attention_dim)
+        self.v_proj = nn.Linear(hidden_dim, attention_dim)
+        self.out_proj = nn.Linear(attention_dim, hidden_dim)
+        self.dropout = nn.Dropout(dropout)
+        self.gates = nn.Parameter(torch.full((num_views,), float(gate_init)))
+
+    def attention_update(
+        self,
+        query_tokens: torch.Tensor,
+        spatial_tokens: torch.Tensor,
+    ) -> torch.Tensor:
+        batch_size, query_count, _ = query_tokens.shape
+
+        def split_heads(tensor: torch.Tensor) -> torch.Tensor:
+            return tensor.reshape(
+                batch_size, -1, self.num_heads, self.head_dim
+            ).transpose(1, 2)
+
+        query = split_heads(self.q_proj(self.query_norm(query_tokens)))
+        key = split_heads(self.k_proj(self.spatial_norm(spatial_tokens)))
+        value = split_heads(self.v_proj(self.spatial_norm(spatial_tokens)))
+        scores = torch.matmul(query, key.transpose(-2, -1)) * (self.head_dim**-0.5)
+        weights = self.dropout(F.softmax(scores, dim=-1))
+        update = torch.matmul(weights, value)
+        update = update.transpose(1, 2).reshape(
+            batch_size, query_count, self.attention_dim
+        )
+        return self.dropout(self.out_proj(update))
+
+    def forward(
+        self,
+        query_tokens: torch.Tensor,
+        spatial_tokens: torch.Tensor,
+        *,
+        view_index: int,
+        gate_multiplier: float = 1.0,
+    ) -> torch.Tensor:
+        if not 0 <= view_index < self.num_views:
+            raise IndexError(f"view_index={view_index} is outside configured views")
+        gate_multiplier = float(gate_multiplier)
+        if not math.isfinite(gate_multiplier) or gate_multiplier < 0.0:
+            raise ValueError("gate_multiplier must be finite and non-negative")
+        update = self.attention_update(query_tokens, spatial_tokens)
+        gate = torch.tanh(self.gates[view_index]).to(dtype=update.dtype)
+        gate = gate * gate_multiplier
+        return query_tokens + gate * update
+
+
+class ZeroGatedSpatialActionConditioner(nn.Module):
+    """Fuse intermediate RGB spatial tokens into the DiT context.
+
+    The module only rewrites Qwen image-token positions.  Language and other
+    sequence tokens are untouched.  With every gate initialized to zero the
+    returned tensor is exactly equal to ``last_hidden``; no extra context token
+    is appended, so the downstream DiT attention normalizer is also unchanged.
+    """
+
+    def __init__(
+        self,
+        *,
+        hidden_dim: int,
+        num_views: int,
+        attention_dim: int = 256,
+        num_heads: int = 4,
+        dropout: float = 0.0,
+        gate_init: float = 0.0,
+        trainable: bool = True,
+    ) -> None:
+        super().__init__()
+        self.num_views = int(num_views)
+        self.fuser = _PerViewGatedCrossAttention(
+            hidden_dim=int(hidden_dim),
+            attention_dim=int(attention_dim),
+            num_heads=int(num_heads),
+            num_views=self.num_views,
+            dropout=float(dropout),
+            gate_init=float(gate_init),
+        )
+        self.set_trainable(trainable)
+
+    def set_trainable(self, trainable: bool) -> None:
+        self.trainable = bool(trainable)
+        for parameter in self.parameters():
+            parameter.requires_grad_(self.trainable)
+
+    @property
+    def gates(self) -> torch.Tensor:
+        return self.fuser.gates
+
+    def effective_gates(self, gate_multiplier: float = 1.0) -> torch.Tensor:
+        gate_multiplier = float(gate_multiplier)
+        if not math.isfinite(gate_multiplier) or gate_multiplier < 0.0:
+            raise ValueError("gate_multiplier must be finite and non-negative")
+        return torch.tanh(self.gates) * gate_multiplier
+
+    def forward(
+        self,
+        last_hidden: torch.Tensor,
+        input_ids: torch.Tensor,
+        student_views: Sequence[torch.Tensor],
+        *,
+        image_token_id: int,
+        gate_multiplier: float = 1.0,
+    ) -> torch.Tensor:
+        if last_hidden.ndim != 3:
+            raise ValueError(
+                f"last_hidden must have shape [B,L,D], got {tuple(last_hidden.shape)}"
+            )
+        if input_ids.shape != last_hidden.shape[:2]:
+            raise ValueError(
+                f"input_ids shape {tuple(input_ids.shape)} does not match "
+                f"last_hidden {tuple(last_hidden.shape[:2])}"
+            )
+        if len(student_views) != self.num_views:
+            raise ValueError(
+                f"Expected {self.num_views} ordered student views, got {len(student_views)}"
+            )
+        for view_index, tokens in enumerate(student_views):
+            if tokens.ndim != 3:
+                raise ValueError(
+                    f"student view {view_index} must have shape [B,N,D], "
+                    f"got {tuple(tokens.shape)}"
+                )
+            if tokens.shape[0] != last_hidden.shape[0]:
+                raise ValueError(
+                    f"student view {view_index} batch={tokens.shape[0]} does not "
+                    f"match last_hidden batch={last_hidden.shape[0]}"
+                )
+            if tokens.shape[2] != last_hidden.shape[2]:
+                raise ValueError(
+                    f"student view {view_index} dim={tokens.shape[2]} does not "
+                    f"match last_hidden dim={last_hidden.shape[2]}"
+                )
+
+        input_ids = input_ids.to(device=last_hidden.device)
+        spans_by_sample = _find_image_token_spans(
+            input_ids,
+            image_token_id=int(image_token_id),
+            expected_num_views=self.num_views,
+        )
+        fused_samples: list[torch.Tensor] = []
+        for sample_index, spans in enumerate(spans_by_sample):
+            sample_hidden = last_hidden[sample_index]
+            for view_index, positions in enumerate(spans):
+                positions = positions.to(device=last_hidden.device)
+                query = last_hidden[sample_index : sample_index + 1].index_select(
+                    1, positions
+                )
+                spatial_tokens = student_views[view_index][
+                    sample_index : sample_index + 1
+                ]
+                fused_query = self.fuser(
+                    query,
+                    spatial_tokens,
+                    view_index=view_index,
+                    gate_multiplier=gate_multiplier,
+                )
+                sample_hidden = sample_hidden.index_copy(0, positions, fused_query[0])
+            fused_samples.append(sample_hidden)
+        return torch.stack(fused_samples, dim=0)
+
+    @torch.inference_mode()
+    def numerical_survival_stats(
+        self,
+        last_hidden: torch.Tensor,
+        input_ids: torch.Tensor,
+        student_views: Sequence[torch.Tensor],
+        *,
+        image_token_id: int,
+        gate_multipliers: Sequence[float],
+    ) -> list[dict[str, float | int]]:
+        """Measure whether the learned residual survives BF16 accumulation.
+
+        The normal forward path is not modified.  For each sample/view/scale,
+        this method reconstructs the current BF16 addition and compares the
+        residual magnitude with the local BF16 unit-in-the-last-place (ULP).
+        """
+        multipliers = [float(value) for value in gate_multipliers]
+        if not multipliers:
+            raise ValueError("gate_multipliers must not be empty")
+        if any(
+            not math.isfinite(value) or value < 0.0 for value in multipliers
+        ):
+            raise ValueError("gate multipliers must be finite and non-negative")
+        if len(student_views) != self.num_views:
+            raise ValueError(
+                f"Expected {self.num_views} ordered student views, got {len(student_views)}"
+            )
+
+        input_ids = input_ids.to(device=last_hidden.device)
+        spans_by_sample = _find_image_token_spans(
+            input_ids,
+            image_token_id=int(image_token_id),
+            expected_num_views=self.num_views,
+        )
+        records: list[dict[str, float | int]] = []
+        bf16_zero_ulp = float(2.0**-133)
+        for sample_index, spans in enumerate(spans_by_sample):
+            for view_index, positions in enumerate(spans):
+                positions = positions.to(device=last_hidden.device)
+                query = last_hidden[sample_index : sample_index + 1].index_select(
+                    1, positions
+                )
+                spatial_tokens = student_views[view_index][
+                    sample_index : sample_index + 1
+                ]
+                update = self.fuser.attention_update(query, spatial_tokens)
+                query_bf16 = query.to(dtype=torch.bfloat16)
+                update_bf16 = update.to(dtype=torch.bfloat16)
+                query_fp32 = query_bf16.float()
+                absolute_query = query_fp32.abs()
+                exponent = torch.floor(
+                    torch.log2(absolute_query.clamp_min(torch.finfo(torch.float32).tiny))
+                )
+                bf16_ulp = torch.pow(2.0, exponent - 7.0)
+                bf16_ulp = torch.where(
+                    absolute_query == 0.0,
+                    torch.full_like(bf16_ulp, bf16_zero_ulp),
+                    bf16_ulp,
+                )
+                gate_fp32 = torch.tanh(self.gates[view_index]).float()
+                gate_bf16 = gate_fp32.to(dtype=torch.bfloat16)
+
+                for multiplier in multipliers:
+                    residual_fp32 = gate_fp32 * multiplier * update.float()
+                    residual_bf16 = (gate_bf16 * multiplier) * update_bf16
+                    fused_bf16 = query_bf16 + residual_bf16
+                    changed = fused_bf16 != query_bf16
+                    ratio = residual_fp32.abs() / bf16_ulp
+                    records.append(
+                        {
+                            "sample_index": sample_index,
+                            "view_index": view_index,
+                            "multiplier": multiplier,
+                            "effective_gate": float(
+                                (gate_fp32 * multiplier).detach().cpu().item()
+                            ),
+                            "element_count": int(query.numel()),
+                            "changed_count": int(changed.sum().detach().cpu().item()),
+                            "nonzero_residual_count": int(
+                                (residual_bf16 != 0).sum().detach().cpu().item()
+                            ),
+                            "ratio_ge_half_ulp_count": int(
+                                (ratio >= 0.5).sum().detach().cpu().item()
+                            ),
+                            "ratio_ge_one_ulp_count": int(
+                                (ratio >= 1.0).sum().detach().cpu().item()
+                            ),
+                            "residual_abs_sum": float(
+                                residual_fp32.abs().sum().detach().cpu().item()
+                            ),
+                            "residual_abs_max": float(
+                                residual_fp32.abs().max().detach().cpu().item()
+                            ),
+                            "bf16_ulp_sum": float(
+                                bf16_ulp.sum().detach().cpu().item()
+                            ),
+                            "residual_to_ulp_sum": float(
+                                ratio.sum().detach().cpu().item()
+                            ),
+                            "residual_to_ulp_max": float(
+                                ratio.max().detach().cpu().item()
+                            ),
+                            "query_l2_sq_sum": float(
+                                query_fp32.square().sum().detach().cpu().item()
+                            ),
+                            "residual_l2_sq_sum": float(
+                                residual_fp32.square().sum().detach().cpu().item()
+                            ),
+                        }
+                    )
+        return records
