@@ -0,0 +1,229 @@
+# Copyright 2025 starVLA community. All rights reserved.
+# Licensed under the MIT License, Version 1.0 (the "License");
+"""QwenGR00T with a frozen Depth Anything V2 spatial-prior branch."""
+
+from __future__ import annotations
+
+from contextlib import nullcontext
+from dataclasses import dataclass, field
+from typing import List, Optional, Tuple
+
+import numpy as np
+import torch
+
+from deployment.model_server.tools.image_tools import to_pil_preserve
+from starVLA.model.framework.share_tools import merge_framework_config
+from starVLA.model.framework.VLM4A.QwenGR00T import QwenGR00TDefaultConfig, Qwen_GR00T
+from starVLA.model.modules.spatial import (
+    FrozenDepthAnythingV2Encoder,
+    GatedSpatialCrossAttention,
+    GeometryTokenProjector,
+    fuse_visual_tokens_by_view,
+)
+from starVLA.model.tools import FRAMEWORK_REGISTRY
+from starVLA.training.trainer_utils.trainer_tools import resize_images
+
+
+@dataclass
+class QwenGR00TSpatialDefaultConfig(QwenGR00TDefaultConfig):
+    """Defaults for the geometry-conditioned Franka QwenGR00T variant."""
+
+    name: str = "QwenGR00TSpatial"
+    spatial: dict = field(
+        default_factory=lambda: {
+            "depth_model_id": "depth-anything/Depth-Anything-V2-Small-hf",
+            "local_files_only": False,
+            "expected_num_views": 2,
+            "grid_size": [14, 14],
+            "use_bf16": True,
+            "geometry_dim": 256,
+            "projector_hidden_dim": 128,
+            "attention_dim": 256,
+            "num_heads": 4,
+            "dropout": 0.0,
+            # Zero is intentional: the freshly added branch is exactly an
+            # identity map when a baseline QwenGR00T checkpoint is loaded.
+            "gate_init": 0.0,
+            "image_token": "<|image_pad|>",
+            "image_token_id_fallback": 151655,
+        }
+    )
+
+
+@FRAMEWORK_REGISTRY.register("QwenGR00TSpatial")
+class Qwen_GR00T_Spatial(Qwen_GR00T):
+    """Dual-RGB QwenGR00T conditioned on frozen relative-depth geometry."""
+
+    def __init__(self, config: Optional[dict] = None, **kwargs) -> None:
+        # Pre-merge spatial defaults.  Qwen_GR00T's own merge keeps extra
+        # framework keys, so the original action/Qwen construction stays intact.
+        config = merge_framework_config(QwenGR00TSpatialDefaultConfig, config)
+        super().__init__(config=config, **kwargs)
+
+        spatial_cfg = self.config.framework.spatial
+        self.expected_num_views = int(spatial_cfg.expected_num_views)
+        grid_size = tuple(int(value) for value in spatial_cfg.grid_size)
+        hidden_size = int(self.qwen_vl_interface.model.config.hidden_size)
+        geometry_dim = int(spatial_cfg.geometry_dim)
+
+        self.geometry_encoder = FrozenDepthAnythingV2Encoder(
+            model_id=str(spatial_cfg.depth_model_id),
+            grid_size=grid_size,
+            use_bf16=bool(spatial_cfg.use_bf16),
+            local_files_only=bool(spatial_cfg.local_files_only),
+        )
+        self.geometry_projector = GeometryTokenProjector(
+            input_dim=self.geometry_encoder.output_dim,
+            geometry_dim=geometry_dim,
+            num_views=self.expected_num_views,
+            hidden_dim=int(spatial_cfg.projector_hidden_dim),
+        )
+        self.spatial_fuser = GatedSpatialCrossAttention(
+            rgb_dim=hidden_size,
+            geometry_dim=geometry_dim,
+            attention_dim=int(spatial_cfg.attention_dim),
+            num_heads=int(spatial_cfg.num_heads),
+            num_views=self.expected_num_views,
+            dropout=float(spatial_cfg.dropout),
+            gate_init=float(spatial_cfg.gate_init),
+        )
+        self.image_token_id = self._resolve_image_token_id(
+            token=str(spatial_cfg.image_token),
+            fallback=int(spatial_cfg.image_token_id_fallback),
+        )
+
+    def _resolve_image_token_id(self, token: str, fallback: int) -> int:
+        tokenizer = self.qwen_vl_interface.processor.tokenizer
+        token_id = tokenizer.convert_tokens_to_ids(token)
+        unknown_id = getattr(tokenizer, "unk_token_id", None)
+        if token_id is None or token_id == unknown_id:
+            token_id = fallback
+        return int(token_id)
+
+    @staticmethod
+    def _cuda_autocast(dtype: torch.dtype):
+        if not torch.cuda.is_available() or dtype == torch.float32:
+            return nullcontext()
+        return torch.autocast(device_type="cuda", dtype=dtype)
+
+    def _validate_views(self, batch_images: List[list]) -> None:
+        view_counts = [len(images) for images in batch_images]
+        if any(count != self.expected_num_views for count in view_counts):
+            raise ValueError(
+                f"QwenGR00TSpatial requires exactly {self.expected_num_views} ordered views per sample; "
+                f"got {view_counts}"
+            )
+
+    def _encode_and_fuse(
+        self,
+        batch_images: List[list],
+        instructions: List[str],
+    ) -> tuple[torch.Tensor, torch.Tensor | None]:
+        self._validate_views(batch_images)
+        qwen_inputs = self.qwen_vl_interface.build_qwenvl_inputs(
+            images=batch_images,
+            instructions=instructions,
+        )
+        backbone_attention_mask = qwen_inputs.get("attention_mask", None)
+
+        with self._cuda_autocast(torch.bfloat16):
+            qwenvl_outputs = self.qwen_vl_interface(
+                **qwen_inputs,
+                output_attentions=False,
+                output_hidden_states=True,
+                return_dict=True,
+            )
+            last_hidden = qwenvl_outputs.hidden_states[-1]
+
+        raw_geometry, geometry_mask = self.geometry_encoder(batch_images)
+        raw_geometry = raw_geometry.to(device=last_hidden.device, dtype=last_hidden.dtype)
+        geometry_mask = geometry_mask.to(device=last_hidden.device, dtype=torch.bool)
+        input_ids = qwen_inputs["input_ids"].to(device=last_hidden.device)
+
+        with self._cuda_autocast(torch.bfloat16):
+            geometry_tokens = self.geometry_projector(raw_geometry)
+            last_hidden = fuse_visual_tokens_by_view(
+                last_hidden=last_hidden,
+                input_ids=input_ids,
+                image_token_id=self.image_token_id,
+                geometry_tokens=geometry_tokens,
+                geometry_mask=geometry_mask,
+                fuser=self.spatial_fuser,
+            )
+        return last_hidden, backbone_attention_mask
+
+    def spatial_gate_values(self) -> np.ndarray:
+        """Return effective per-camera residual gates for logging/debugging."""
+
+        return torch.tanh(self.spatial_fuser.gates.detach()).float().cpu().numpy()
+
+    def forward(self, examples: List[dict] = None, **kwargs) -> Tuple:
+        batch_images = [example["image"] for example in examples]
+        instructions = [example["lang"] for example in examples]
+        actions = [example["action"] for example in examples]
+        state = [example["state"] for example in examples] if "state" in examples[0] else None
+
+        last_hidden, backbone_attention_mask = self._encode_and_fuse(batch_images, instructions)
+
+        with self._cuda_autocast(torch.float32):
+            actions = torch.tensor(np.array(actions), device=last_hidden.device, dtype=last_hidden.dtype)
+            actions_target = actions[:, -self.action_horizon :, :]
+            repeated_diffusion_steps = int(self.config.framework.action_model.get("repeated_diffusion_steps", 4))
+            actions_target_repeated = actions_target.repeat(repeated_diffusion_steps, 1, 1)
+            last_hidden_repeated = last_hidden.repeat(repeated_diffusion_steps, 1, 1)
+
+            repeated_attention_mask = None
+            if backbone_attention_mask is not None:
+                repeated_attention_mask = backbone_attention_mask.repeat(repeated_diffusion_steps, 1).to(
+                    device=last_hidden.device,
+                    dtype=torch.bool,
+                )
+
+            state_repeated = None
+            if state is not None:
+                state_tensor = torch.tensor(np.array(state), device=last_hidden.device, dtype=last_hidden.dtype)
+                state_repeated = state_tensor.repeat(repeated_diffusion_steps, 1, 1)
+
+            action_loss = self.action_model(
+                last_hidden_repeated,
+                actions_target_repeated,
+                state_repeated,
+                encoder_attention_mask=repeated_attention_mask,
+            )
+
+        return {
+            "action_loss": action_loss,
+            "spatial_gate_primary": torch.tanh(self.spatial_fuser.gates[0]).detach(),
+            "spatial_gate_wrist": torch.tanh(self.spatial_fuser.gates[1]).detach(),
+        }
+
+    @torch.inference_mode()
+    def predict_action(self, examples: List[dict], **kwargs: str) -> dict:
+        if not isinstance(examples, list):
+            examples = [examples]
+        batch_images = [to_pil_preserve(example["image"]) for example in examples]
+        instructions = [example["lang"] for example in examples]
+        state = [example["state"] for example in examples] if "state" in examples[0] else None
+
+        train_obs_image_size = getattr(self.config.datasets.vla_data, "obs_image_size", None)
+        if train_obs_image_size:
+            batch_images = resize_images(batch_images, target_size=train_obs_image_size)
+
+        last_hidden, backbone_attention_mask = self._encode_and_fuse(batch_images, instructions)
+        if backbone_attention_mask is not None:
+            backbone_attention_mask = backbone_attention_mask.to(device=last_hidden.device, dtype=torch.bool)
+        state_tensor = (
+            torch.from_numpy(np.array(state)).to(last_hidden.device, dtype=last_hidden.dtype)
+            if state is not None
+            else None
+        )
+
+        with self._cuda_autocast(torch.float32):
+            pred_actions = self.action_model.predict_action(
+                last_hidden,
+                state_tensor,
+                encoder_attention_mask=backbone_attention_mask,
+            )
+        # NumPy has no native bfloat16 dtype.  The spatial smoke freezes Qwen,
+        # so the flow head can legitimately return bf16 here; export as fp32.
+        return {"normalized_actions": pred_actions.detach().float().cpu().numpy()}
