+"""Unit and static contract tests for Phase-C action conditioning."""
+
+from pathlib import Path
+import unittest
+
+import torch
+
+from starVLA.model.modules.spatial_forcing.action_conditioning import (
+    ZeroGatedSpatialActionConditioner,
+)
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+
+def fixture(trainable=True):
+    torch.manual_seed(29)
+    module = ZeroGatedSpatialActionConditioner(
+        hidden_dim=8,
+        num_views=2,
+        attention_dim=8,
+        num_heads=2,
+        dropout=0.0,
+        gate_init=0.0,
+        trainable=trainable,
+    )
+    hidden = torch.randn(2, 8, 8, requires_grad=True)
+    input_ids = torch.tensor(
+        [[1, 99, 99, 2, 99, 99, 3, 3], [1, 99, 99, 2, 99, 99, 3, 3]]
+    )
+    views = [
+        torch.randn(2, 3, 8, requires_grad=True),
+        torch.randn(2, 4, 8, requires_grad=True),
+    ]
+    return module, hidden, input_ids, views
+
+
+class ZeroGateConditionerTest(unittest.TestCase):
+    def test_zero_gate_is_exact_identity(self):
+        module, hidden, input_ids, views = fixture(trainable=True)
+        output = module(hidden, input_ids, views, image_token_id=99)
+        self.assertTrue(torch.equal(output, hidden))
+        self.assertTrue(torch.equal(module.effective_gates(), torch.zeros(2)))
+
+    def test_zero_gate_updates_gate_but_not_projection_on_first_step(self):
+        module, hidden, input_ids, views = fixture(trainable=True)
+        output = module(hidden, input_ids, views, image_token_id=99)
+        loss = output.square().mean()
+        loss.backward()
+        self.assertIsNotNone(module.gates.grad)
+        self.assertGreater(float(module.gates.grad.abs().sum()), 0.0)
+        projection_grad = module.fuser.out_proj.weight.grad
+        self.assertIsNotNone(projection_grad)
+        self.assertEqual(float(projection_grad.abs().sum()), 0.0)
+
+    def test_open_gate_changes_only_image_spans(self):
+        module, hidden, input_ids, views = fixture(trainable=True)
+        with torch.no_grad():
+            module.gates.fill_(0.2)
+        output = module(hidden, input_ids, views, image_token_id=99)
+        image_positions = input_ids == 99
+        self.assertGreater(float((output[image_positions] - hidden[image_positions]).abs().sum()), 0.0)
+        self.assertTrue(torch.equal(output[~image_positions], hidden[~image_positions]))
+
+    def test_gate_multiplier_zero_disables_a_learned_gate_exactly(self):
+        module, hidden, input_ids, views = fixture(trainable=False)
+        with torch.no_grad():
+            module.gates.copy_(torch.tensor([0.2, -0.3]))
+        output = module(
+            hidden,
+            input_ids,
+            views,
+            image_token_id=99,
+            gate_multiplier=0.0,
+        )
+        self.assertTrue(torch.equal(output, hidden))
+        self.assertTrue(
+            torch.equal(module.effective_gates(0.0), torch.zeros_like(module.gates))
+        )
+
+    def test_gate_multiplier_scales_only_the_spatial_residual(self):
+        module, hidden, input_ids, views = fixture(trainable=False)
+        with torch.no_grad():
+            module.gates.copy_(torch.tensor([0.2, -0.3]))
+        output_one = module(
+            hidden,
+            input_ids,
+            views,
+            image_token_id=99,
+            gate_multiplier=1.0,
+        )
+        output_two = module(
+            hidden,
+            input_ids,
+            views,
+            image_token_id=99,
+            gate_multiplier=2.0,
+        )
+        self.assertTrue(
+            torch.allclose(output_two - hidden, 2.0 * (output_one - hidden))
+        )
+
+    def test_rejects_invalid_gate_multiplier(self):
+        module, hidden, input_ids, views = fixture(trainable=False)
+        for multiplier in (-1.0, float("nan"), float("inf")):
+            with self.subTest(multiplier=multiplier):
+                with self.assertRaisesRegex(ValueError, "finite and non-negative"):
+                    module(
+                        hidden,
+                        input_ids,
+                        views,
+                        image_token_id=99,
+                        gate_multiplier=multiplier,
+                    )
+
+    def test_numerical_survival_audit_detects_zero_and_scaled_residuals(self):
+        module, hidden, input_ids, views = fixture(trainable=False)
+        with torch.no_grad():
+            module.gates.copy_(torch.tensor([0.2, -0.3]))
+        records = module.numerical_survival_stats(
+            hidden,
+            input_ids,
+            views,
+            image_token_id=99,
+            gate_multipliers=(0.0, 1.0, 64.0),
+        )
+        self.assertEqual(len(records), 2 * 2 * 3)
+        zero = [record for record in records if record["multiplier"] == 0.0]
+        nominal = [record for record in records if record["multiplier"] == 1.0]
+        amplified = [record for record in records if record["multiplier"] == 64.0]
+        self.assertTrue(all(record["changed_count"] == 0 for record in zero))
+        self.assertTrue(
+            all(record["residual_abs_sum"] == 0.0 for record in zero)
+        )
+        self.assertGreater(
+            sum(record["residual_abs_sum"] for record in nominal), 0.0
+        )
+        self.assertGreaterEqual(
+            sum(record["changed_count"] for record in amplified),
+            sum(record["changed_count"] for record in nominal),
+        )
+        self.assertGreater(
+            sum(record["residual_to_ulp_sum"] for record in amplified),
+            sum(record["residual_to_ulp_sum"] for record in nominal),
+        )
+
+    def test_control_freezes_the_complete_conditioner(self):
+        module, hidden, input_ids, views = fixture(trainable=False)
+        self.assertFalse(any(parameter.requires_grad for parameter in module.parameters()))
+        output = module(hidden, input_ids, views, image_token_id=99)
+        self.assertTrue(torch.equal(output, hidden))
+
+    def test_rejects_wrong_view_count(self):
+        module, hidden, input_ids, views = fixture(trainable=True)
+        with self.assertRaisesRegex(ValueError, "Expected 2 ordered student views"):
+            module(hidden, input_ids, views[:1], image_token_id=99)
+
+
+class PhaseCStaticContractTest(unittest.TestCase):
+    def test_config_runner_and_framework_lock_matched_ablation(self):
+        config = (
+            REPO_ROOT
+            / "examples/realRobots/Franka/train_files/"
+            "starvla_cotrain_quest3_franka_sf_action_conditioned.yaml"
+        ).read_text()
+        runner = (
+            REPO_ROOT
+            / "examples/realRobots/Franka/train_files/"
+            "run_qwengroot_sf_action_conditioned_smoke.sh"
+        ).read_text()
+        framework = (
+            REPO_ROOT
+            / "starVLA/model/framework/VLM4A/"
+            "QwenGR00TSpatialForcingActionConditioned.py"
+        ).read_text()
+        for needle in (
+            "name: QwenGR00TSpatialForcingActionConditioned",
+            "patch_structure_alpha: 0.1",
+            "action_conditioning_gate_trainable: false",
+            "action_conditioning_gate_init: 0.0",
+            "action_conditioning_gate_multiplier: 1.0",
+            "action_conditioning_attention_dim: 256",
+            "student_hidden_state_index: 16",
+            "data_mix: quest3_franka_dualcam_replay_94eps_v1",
+        ):
+            self.assertIn(needle, config)
+        for needle in (
+            'control) expected_gate_trainable="false"',
+            'treatment) expected_gate_trainable="true"',
+            'patch_alpha="${PATCH_STRUCTURE_ALPHA:-0.1}"',
+            "both Phase-C arms require patch alpha 0.1",
+            "--framework.name QwenGR00TSpatialForcingActionConditioned",
+            '--framework.spatial_forcing.action_conditioning_gate_trainable "${gate_trainable}"',
+        ):
+            self.assertIn(needle, runner)
+        for needle in (
+            "self.action_spatial_conditioner(",
+            "gate_multiplier=self.action_conditioning_gate_multiplier",
+            "audit_action_conditioning_numerics",
+            '"action_spatial_gate"',
+            '"action_spatial_out_proj"',
+            "pred_actions.detach().float().cpu().numpy()",
+        ):
+            self.assertIn(needle, framework)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
