+        vision_config = self.qwen_vl_interface.model.config.vision_config
+        spatial_merge_size = int(getattr(vision_config, "spatial_merge_size", 2))
+        if self.student_feature_source == "llm_hidden":
+            selected_hidden = self._select_student_hidden(hidden_states)
+            input_ids = qwen_inputs["input_ids"].to(device=selected_hidden.device)
+            views = extract_visual_tokens_by_view(
+                selected_hidden,
+                input_ids,
+                image_token_id=self.image_token_id,
+                expected_num_views=self.expected_num_views,
+            )
+            target_hw = qwen_visual_token_grids(
+                qwen_inputs["image_grid_thw"],
+                token_counts_by_view=[int(tokens.shape[1]) for tokens in views],
+                batch_size=batch_size,
+                expected_num_views=self.expected_num_views,
+                spatial_merge_size=spatial_merge_size,
+            )
+            return views, target_hw
+
+        if captured_visual_tokens is None:
+            raise RuntimeError(
+                f"No Qwen {self.student_feature_source} tokens were captured during forward"
+            )
+        return split_qwen_visual_features_by_view(
+            captured_visual_tokens,
+            qwen_inputs["image_grid_thw"],
+            batch_size=batch_size,
+            expected_num_views=self.expected_num_views,
+            spatial_merge_size=spatial_merge_size,
+            merged=self.student_feature_source == "vision_projector",
+        )
