@@ -0,0 +1,271 @@
+"""Phase-C direct action conditioning from VGGT-aligned RGB student tokens."""
+
+from __future__ import annotations
+
+import math
+from typing import List, Mapping
+
+import numpy as np
+import torch
+
+from starVLA.model.framework.VLM4A.QwenGR00T import resize_images, to_pil_preserve
+from starVLA.model.framework.VLM4A.QwenGR00TSpatialForcingCropPatch import (
+    Qwen_GR00T_SpatialForcing_CropPatch,
+)
+from starVLA.model.modules.spatial_forcing.action_conditioning import (
+    ZeroGatedSpatialActionConditioner,
+)
+from starVLA.model.tools import FRAMEWORK_REGISTRY
+
+
+@FRAMEWORK_REGISTRY.register("QwenGR00TSpatialForcingActionConditioned")
+class Qwen_GR00T_SpatialForcing_ActionConditioned(
+    Qwen_GR00T_SpatialForcing_CropPatch
+):
+    """Matched gate=0 control and trainable zero-gate treatment.
+
+    VGGT remains a training-only teacher.  At deployment, the conditioner uses
+    layer-16 RGB Qwen tokens and the learned fuser; no VGGT/depth input or
+    camera calibration is required.
+    """
+
+    def __init__(self, config=None, **kwargs) -> None:
+        super().__init__(config=config, **kwargs)
+        sf_cfg = self.config.framework.spatial_forcing
+        if self.patch_structure_alpha <= 0.0:
+            raise ValueError(
+                "ActionConditioned requires the same positive patch_structure_alpha "
+                "in control and treatment"
+            )
+        self.action_conditioning_gate_trainable = bool(
+            getattr(sf_cfg, "action_conditioning_gate_trainable", False)
+        )
+        self.action_conditioning_gate_multiplier = float(
+            getattr(sf_cfg, "action_conditioning_gate_multiplier", 1.0)
+        )
+        if (
+            not math.isfinite(self.action_conditioning_gate_multiplier)
+            or self.action_conditioning_gate_multiplier < 0.0
+        ):
+            raise ValueError(
+                "action_conditioning_gate_multiplier must be finite and non-negative"
+            )
+        hidden_dim = int(self.qwen_vl_interface.model.config.hidden_size)
+        self.action_spatial_conditioner = ZeroGatedSpatialActionConditioner(
+            hidden_dim=hidden_dim,
+            num_views=self.expected_num_views,
+            attention_dim=int(
+                getattr(sf_cfg, "action_conditioning_attention_dim", 256)
+            ),
+            num_heads=int(getattr(sf_cfg, "action_conditioning_num_heads", 4)),
+            dropout=float(getattr(sf_cfg, "action_conditioning_dropout", 0.0)),
+            gate_init=float(getattr(sf_cfg, "action_conditioning_gate_init", 0.0)),
+            trainable=self.action_conditioning_gate_trainable,
+        )
+        if float(getattr(sf_cfg, "action_conditioning_gate_init", 0.0)) != 0.0:
+            raise ValueError("Phase-C requires an exact zero-initialized action gate")
+
+    def _action_conditioned_hidden(
+        self,
+        *,
+        qwen_inputs: Mapping[str, torch.Tensor],
+        hidden_states: tuple[torch.Tensor, ...],
+    ) -> torch.Tensor:
+        last_hidden = hidden_states[-1]
+        student_views, _ = self._student_views(
+            qwen_inputs=qwen_inputs,
+            hidden_states=hidden_states,
+            captured_visual_tokens=None,
+            batch_size=last_hidden.shape[0],
+        )
+        return self.action_spatial_conditioner(
+            last_hidden,
+            qwen_inputs["input_ids"],
+            student_views,
+            image_token_id=self.image_token_id,
+            gate_multiplier=self.action_conditioning_gate_multiplier,
+        )
+
+    def _spatial_forcing_probe_parameters(self) -> dict[str, torch.Tensor]:
+        probes = super()._spatial_forcing_probe_parameters()
+        probes.update(
+            {
+                "action_spatial_gate": self.action_spatial_conditioner.gates,
+                "action_spatial_out_proj": (
+                    self.action_spatial_conditioner.fuser.out_proj.weight
+                ),
+            }
+        )
+        return probes
+
+    @torch.inference_mode()
+    def audit_action_conditioning_numerics(
+        self,
+        examples: List[dict],
+        *,
+        gate_multipliers: tuple[float, ...] = (0.5, 1.0, 2.0, 4.0, 8.0),
+    ) -> list[dict[str, float | int]]:
+        """Audit learned action-residual survival without running the DiT head."""
+        input_examples = examples if isinstance(examples, list) else [examples]
+        cropped_examples, batch_images = self._crop_examples(input_examples)
+        instructions = [example["lang"] for example in cropped_examples]
+        qwen_inputs = self.qwen_vl_interface.build_qwenvl_inputs(
+            images=batch_images,
+            instructions=instructions,
+        )
+        with torch.autocast("cuda", dtype=torch.bfloat16):
+            qwenvl_outputs = self.qwen_vl_interface(
+                **qwen_inputs,
+                output_attentions=False,
+                output_hidden_states=True,
+                return_dict=True,
+            )
+            hidden_states = qwenvl_outputs.hidden_states
+            last_hidden = hidden_states[-1]
+            student_views, _ = self._student_views(
+                qwen_inputs=qwen_inputs,
+                hidden_states=hidden_states,
+                captured_visual_tokens=None,
+                batch_size=last_hidden.shape[0],
+            )
+        return self.action_spatial_conditioner.numerical_survival_stats(
+            last_hidden,
+            qwen_inputs["input_ids"],
+            student_views,
+            image_token_id=self.image_token_id,
+            gate_multipliers=gate_multipliers,
+        )
+
+    def forward(self, examples: List[dict] = None, **kwargs) -> dict[str, torch.Tensor]:
+        cropped_examples, batch_images = self._crop_examples(examples)
+        instructions = [example["lang"] for example in cropped_examples]
+        actions = [example["action"] for example in cropped_examples]
+        state = (
+            [example["state"] for example in cropped_examples]
+            if "state" in cropped_examples[0]
+            else None
+        )
+
+        qwen_inputs = self.qwen_vl_interface.build_qwenvl_inputs(
+            images=batch_images,
+            instructions=instructions,
+        )
+        backbone_attention_mask = qwen_inputs.get("attention_mask", None)
+        with torch.autocast("cuda", dtype=torch.bfloat16):
+            qwenvl_outputs = self.qwen_vl_interface(
+                **qwen_inputs,
+                output_attentions=False,
+                output_hidden_states=True,
+                return_dict=True,
+            )
+            hidden_states = qwenvl_outputs.hidden_states
+            action_hidden = self._action_conditioned_hidden(
+                qwen_inputs=qwen_inputs,
+                hidden_states=hidden_states,
+            )
+            patch_structure_loss = self._patch_structure_loss(
+                batch_images=batch_images,
+                qwen_inputs=qwen_inputs,
+                hidden_states=hidden_states,
+            )
+
+        with torch.autocast("cuda", dtype=torch.float32):
+            actions_tensor = torch.tensor(
+                np.array(actions),
+                device=action_hidden.device,
+                dtype=action_hidden.dtype,
+            )
+            actions_target = actions_tensor[:, -self.action_horizon :, :]
+            repeated_steps = int(
+                self.config.framework.action_model.get("repeated_diffusion_steps", 4)
+            )
+            actions_target = actions_target.repeat(repeated_steps, 1, 1)
+            repeated_hidden = action_hidden.repeat(repeated_steps, 1, 1)
+            repeated_mask = None
+            if backbone_attention_mask is not None:
+                repeated_mask = backbone_attention_mask.repeat(
+                    repeated_steps, 1
+                ).to(dtype=torch.bool)
+            repeated_state = None
+            if state is not None:
+                state_tensor = torch.tensor(
+                    np.array(state),
+                    device=action_hidden.device,
+                    dtype=action_hidden.dtype,
+                )
+                repeated_state = state_tensor.repeat(repeated_steps, 1, 1)
+            action_loss = self.action_model(
+                repeated_hidden,
+                actions_target,
+                repeated_state,
+                encoder_attention_mask=repeated_mask,
+            )
+
+        weighted_patch_structure_loss = (
+            self.patch_structure_alpha * patch_structure_loss
+        )
+        total_loss = action_loss + weighted_patch_structure_loss
+        return {
+            "action_loss": action_loss,
+            "alignment_loss": patch_structure_loss,
+            "weighted_alignment_loss": weighted_patch_structure_loss,
+            "relational_alignment_loss": patch_structure_loss,
+            "weighted_relational_alignment_loss": weighted_patch_structure_loss,
+            "total_spatial_alignment_loss": weighted_patch_structure_loss,
+            "total_loss": total_loss,
+        }
+
+    @torch.inference_mode()
+    def predict_action(self, examples: List[dict], **kwargs) -> dict:
+        input_examples = examples if isinstance(examples, list) else [examples]
+        cropped_examples, _ = self._crop_examples(input_examples)
+        batch_images = [
+            to_pil_preserve(example["image"]) for example in cropped_examples
+        ]
+        instructions = [example["lang"] for example in cropped_examples]
+        state = (
+            [example["state"] for example in cropped_examples]
+            if "state" in cropped_examples[0]
+            else None
+        )
+        train_obs_image_size = getattr(
+            self.config.datasets.vla_data, "obs_image_size", None
+        )
+        if train_obs_image_size:
+            batch_images = resize_images(batch_images, target_size=train_obs_image_size)
+
+        qwen_inputs = self.qwen_vl_interface.build_qwenvl_inputs(
+            images=batch_images,
+            instructions=instructions,
+        )
+        backbone_attention_mask = qwen_inputs.get("attention_mask", None)
+        if backbone_attention_mask is not None:
+            backbone_attention_mask = backbone_attention_mask.to(dtype=torch.bool)
+        with torch.autocast("cuda", dtype=torch.bfloat16):
+            qwenvl_outputs = self.qwen_vl_interface(
+                **qwen_inputs,
+                output_attentions=False,
+                output_hidden_states=True,
+                return_dict=True,
+            )
+            action_hidden = self._action_conditioned_hidden(
+                qwen_inputs=qwen_inputs,
+                hidden_states=qwenvl_outputs.hidden_states,
+            )
+
+        state_tensor = (
+            torch.from_numpy(np.array(state)).to(
+                action_hidden.device, dtype=action_hidden.dtype
+            )
+            if state is not None
+            else None
+        )
+        with torch.autocast("cuda", dtype=torch.float32):
+            pred_actions = self.action_model.predict_action(
+                action_hidden,
+                state_tensor,
+                encoder_attention_mask=backbone_attention_mask,
+            )
+        return {
+            "normalized_actions": pred_actions.detach().float().cpu().numpy()
+        }
