+#!/usr/bin/env bash
+set -euo pipefail
+
+stage="${1:?Usage: install_sf_official_fidelity_on_server.sh STAGE_DIR [STARVLA_REPO]}"
+repo="${2:-/home/hanyu/starVLA}"
+
+files=(
+  examples/realRobots/Franka/train_files/starvla_cotrain_quest3_franka_sf_official_fidelity.yaml
+  examples/realRobots/Franka/train_files/run_qwengroot_sf_official_fidelity_smoke.sh
+  scripts/run_sf_official_fidelity_matched_smoke.sh
+  tests/test_spatial_forcing_official_fidelity.py
+)
+
+for relative in "${files[@]}"; do
+  source_path="${stage}/${relative}"
+  destination="${repo}/${relative}"
+  if [[ ! -f "${source_path}" ]]; then
+    echo "Missing staged file: ${source_path}" >&2
+    exit 1
+  fi
+  mkdir -p "$(dirname "${destination}")"
+  mode=0644
+  if [[ "${relative}" == *.sh ]]; then mode=0755; fi
+  install -m "${mode}" "${source_path}" "${destination}"
+done
+
+bash -n "${repo}/examples/realRobots/Franka/train_files/run_qwengroot_sf_official_fidelity_smoke.sh"
+bash -n "${repo}/scripts/run_sf_official_fidelity_matched_smoke.sh"
+python -m py_compile "${repo}/tests/test_spatial_forcing_official_fidelity.py"
+
+echo "SF_OFFICIAL_FIDELITY_INSTALL=PASS"
+echo "STARVLA_REPO=${repo}"
