--- /dev/null
+++ b/starVLA/model/framework/VLM4A/QwenGR00TSpatialForcingCropPatch.py
@@ -0,0 +1,186 @@
+"""Object-centric, calibration-free VGGT patch-structure supervision."""
+
+from __future__ import annotations
+
+from typing import List, Mapping
+
+import numpy as np
+import torch
+
+from starVLA.model.framework.VLM4A.QwenGR00TSpatialForcing import (
+    Qwen_GR00T_SpatialForcing,
+)
+from starVLA.model.modules.spatial_forcing.crop_patch import (
+    SpatialForcingViewCrop,
+    patch_structure_alignment_loss,
+)
+from starVLA.model.modules.spatial_forcing import resample_teacher_tokens_by_view
+from starVLA.model.tools import FRAMEWORK_REGISTRY
+
+
+@FRAMEWORK_REGISTRY.register("QwenGR00TSpatialForcingCropPatch")
+class Qwen_GR00T_SpatialForcing_CropPatch(Qwen_GR00T_SpatialForcing):
+    """Layer-16 patch geometry treatment and its exactly matched alpha=0 control."""
+
+    def __init__(self, config=None, **kwargs) -> None:
+        super().__init__(config=config, **kwargs)
+        sf_cfg = self.config.framework.spatial_forcing
+        self.patch_structure_alpha = float(
+            getattr(sf_cfg, "patch_structure_alpha", 0.0)
+        )
+        if self.patch_structure_alpha < 0.0:
+            raise ValueError("spatial_forcing.patch_structure_alpha must be non-negative")
+        if self.student_feature_source != "llm_hidden":
+            raise ValueError("CropPatch requires student_feature_source=llm_hidden")
+        if self.student_hidden_state_index != 16:
+            raise ValueError("CropPatch requires student_hidden_state_index=16")
+        if self.projected_alignment_alpha != 0.0:
+            raise ValueError("CropPatch does not use the learned projection head")
+        if self.relational_alignment_alpha != 0.0 or self.scene_relational_alpha != 0.0:
+            raise ValueError("CropPatch requires legacy relational/scene alpha=0")
+        if self.image_augmentation_enabled:
+            raise ValueError("CropPatch smoke disables random image augmentation")
+        if self.inference_center_crop_enabled:
+            raise ValueError("CropPatch uses view-specific crops, not center crop")
+
+        view_names = tuple(getattr(sf_cfg, "view_crop_names", ("primary", "wrist")))
+        if view_names != ("primary", "wrist"):
+            raise ValueError(
+                "CropPatch camera order must be exactly ['primary', 'wrist'], "
+                f"got {view_names}"
+            )
+        crop_boxes = getattr(
+            sf_cfg,
+            "view_crop_boxes",
+            ((0.20, 0.48, 0.85, 1.00), (0.0, 0.0, 1.0, 1.0)),
+        )
+        self.view_crop = SpatialForcingViewCrop(crop_boxes, view_names=view_names)
+
+    def _crop_examples(self, examples: List[dict]) -> tuple[list[dict], list[list]]:
+        # SpatialForcingViewCrop accepts PIL, NumPy, or torch image leaves and
+        # materializes RGB PIL images exactly once for both student and teacher.
+        batch_images = [example["image"] for example in examples]
+        cropped_images = self.view_crop(batch_images)
+        cropped_examples = []
+        for example, images in zip(examples, cropped_images):
+            copied = dict(example)
+            copied["image"] = images
+            cropped_examples.append(copied)
+        return cropped_examples, cropped_images
+
+    def predict_action(self, examples: List[dict], **kwargs) -> dict:
+        input_examples = examples if isinstance(examples, list) else [examples]
+        cropped_examples, _ = self._crop_examples(input_examples)
+        return super().predict_action(cropped_examples, **kwargs)
+
+    def _patch_structure_loss(
+        self,
+        *,
+        batch_images: list[list],
+        qwen_inputs: Mapping[str, torch.Tensor],
+        hidden_states: tuple[torch.Tensor, ...],
+    ) -> torch.Tensor:
+        if self.spatial_teacher is None:
+            raise RuntimeError(
+                "CropPatch training requires teacher_enabled=true; false is inference-only"
+            )
+        student_views, target_hw = self._student_views(
+            qwen_inputs=qwen_inputs,
+            hidden_states=hidden_states,
+            captured_visual_tokens=None,
+            batch_size=len(batch_images),
+        )
+        teacher_output = self._teacher_output(batch_images)
+        teacher_tokens = teacher_output.tokens.to(
+            device=student_views[0].device,
+            dtype=student_views[0].dtype,
+        )
+        teacher_views = resample_teacher_tokens_by_view(
+            teacher_tokens,
+            source_hw=teacher_output.source_hw,
+            target_hw=target_hw,
+            mode=self.alignment_interpolation,
+        )
+        per_view = [
+            patch_structure_alignment_loss(student, teacher)
+            for student, teacher in zip(student_views, teacher_views)
+        ]
+        return torch.stack(per_view).mean()
+
+    def forward(self, examples: List[dict] = None, **kwargs) -> dict[str, torch.Tensor]:
+        cropped_examples, batch_images = self._crop_examples(examples)
+        instructions = [example["lang"] for example in cropped_examples]
+        actions = [example["action"] for example in cropped_examples]
+        state = (
+            [example["state"] for example in cropped_examples]
+            if "state" in cropped_examples[0]
+            else None
+        )
+
+        qwen_inputs = self.qwen_vl_interface.build_qwenvl_inputs(
+            images=batch_images,
+            instructions=instructions,
+        )
+        backbone_attention_mask = qwen_inputs.get("attention_mask", None)
+        with torch.autocast("cuda", dtype=torch.bfloat16):
+            qwenvl_outputs = self.qwen_vl_interface(
+                **qwen_inputs,
+                output_attentions=False,
+                output_hidden_states=True,
+                return_dict=True,
+            )
+            hidden_states = qwenvl_outputs.hidden_states
+            last_hidden = hidden_states[-1]
+            patch_structure_loss = self._patch_structure_loss(
+                batch_images=batch_images,
+                qwen_inputs=qwen_inputs,
+                hidden_states=hidden_states,
+            )
+
+        with torch.autocast("cuda", dtype=torch.float32):
+            actions_tensor = torch.tensor(
+                np.array(actions),
+                device=last_hidden.device,
+                dtype=last_hidden.dtype,
+            )
+            actions_target = actions_tensor[:, -self.action_horizon :, :]
+            repeated_steps = int(
+                self.config.framework.action_model.get("repeated_diffusion_steps", 4)
+            )
+            actions_target = actions_target.repeat(repeated_steps, 1, 1)
+            action_hidden = last_hidden.repeat(repeated_steps, 1, 1)
+            repeated_mask = None
+            if backbone_attention_mask is not None:
+                repeated_mask = backbone_attention_mask.repeat(repeated_steps, 1).to(
+                    dtype=torch.bool
+                )
+            repeated_state = None
+            if state is not None:
+                state_tensor = torch.tensor(
+                    np.array(state),
+                    device=last_hidden.device,
+                    dtype=last_hidden.dtype,
+                )
+                repeated_state = state_tensor.repeat(repeated_steps, 1, 1)
+            action_loss = self.action_model(
+                action_hidden,
+                actions_target,
+                repeated_state,
+                encoder_attention_mask=repeated_mask,
+            )
+
+        weighted_patch_structure_loss = (
+            self.patch_structure_alpha * patch_structure_loss
+        )
+        total_loss = action_loss + weighted_patch_structure_loss
+        return {
+            "action_loss": action_loss,
+            # Reuse the trainer's existing projection-free metric slots while
+            # exposing explicit names for downstream audits.
+            "alignment_loss": patch_structure_loss,
+            "weighted_alignment_loss": weighted_patch_structure_loss,
+            "relational_alignment_loss": patch_structure_loss,
+            "weighted_relational_alignment_loss": weighted_patch_structure_loss,
+            "total_spatial_alignment_loss": weighted_patch_structure_loss,
+            "total_loss": total_loss,
+        }
