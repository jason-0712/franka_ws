@@ -0,0 +1,206 @@
+"""Paired RGB augmentation for clean Spatial-Forcing reproduction.
+
+The official recipe feeds an augmented observation to both the VLA student
+and the frozen VGGT teacher.  Applying two independent transforms would
+destroy patch correspondence and turn token-wise alignment into noise.  This
+module therefore materializes each augmented PIL image once; callers reuse
+the returned nested list for both branches.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+import numpy as np
+from PIL import Image, ImageEnhance
+import torch
+
+
+def _to_rgb_pil(image: Any) -> Image.Image:
+    if isinstance(image, Image.Image):
+        return image.convert("RGB")
+    if isinstance(image, torch.Tensor):
+        value = image.detach().cpu()
+        if value.ndim != 3:
+            raise ValueError(f"Tensor image must have three dimensions, got {tuple(value.shape)}")
+        if value.shape[0] in (1, 3, 4):
+            value = value.permute(1, 2, 0)
+        array = value.numpy()
+    else:
+        array = np.asarray(image)
+    if array.ndim != 3:
+        raise ValueError(f"Image must have shape [H,W,C], got {tuple(array.shape)}")
+    if array.shape[-1] == 1:
+        array = np.repeat(array, 3, axis=-1)
+    if array.shape[-1] == 4:
+        array = array[..., :3]
+    if array.shape[-1] != 3:
+        raise ValueError(f"Expected 1, 3, or 4 channels, got {array.shape[-1]}")
+    if np.issubdtype(array.dtype, np.floating):
+        finite_max = float(np.nanmax(array)) if array.size else 0.0
+        if finite_max <= 1.0:
+            array = array * 255.0
+    array = np.nan_to_num(array, nan=0.0, posinf=255.0, neginf=0.0)
+    return Image.fromarray(np.clip(array, 0, 255).astype(np.uint8), mode="RGB")
+
+
+def _uniform(low: float, high: float, generator: torch.Generator | None) -> float:
+    if low == high:
+        return float(low)
+    sample = torch.rand((), generator=generator).item()
+    return float(low + (high - low) * sample)
+
+
+def _randint(high_exclusive: int, generator: torch.Generator | None) -> int:
+    if high_exclusive <= 1:
+        return 0
+    return int(torch.randint(high_exclusive, (), generator=generator).item())
+
+
+def _randperm(length: int, generator: torch.Generator | None) -> tuple[int, ...]:
+    return tuple(int(value) for value in torch.randperm(length, generator=generator).tolist())
+
+
+@dataclass(frozen=True)
+class SpatialForcingAugmentConfig:
+    """Official-style augmentation strengths used by the clean experiment."""
+
+    crop_area_scale: float = 0.9
+    brightness_delta: float = 0.2
+    contrast_min: float = 0.8
+    contrast_max: float = 1.2
+    saturation_min: float = 0.8
+    saturation_max: float = 1.2
+    hue_delta: float = 0.05
+
+    def validate(self) -> None:
+        if not 0.0 < self.crop_area_scale <= 1.0:
+            raise ValueError("crop_area_scale must be in (0,1]")
+        if not 0.0 <= self.brightness_delta < 1.0:
+            raise ValueError("brightness_delta must be in [0,1)")
+        if min(self.contrast_min, self.saturation_min) < 0.0:
+            raise ValueError("contrast and saturation factors must be non-negative")
+        if self.contrast_min > self.contrast_max:
+            raise ValueError("contrast_min must not exceed contrast_max")
+        if self.saturation_min > self.saturation_max:
+            raise ValueError("saturation_min must not exceed saturation_max")
+        if not 0.0 <= self.hue_delta <= 0.5:
+            raise ValueError("hue_delta must be in [0,0.5]")
+
+
+class PairedSpatialForcingAugment:
+    """Apply one stochastic transform per view and return reusable PIL images."""
+
+    def __init__(self, config: SpatialForcingAugmentConfig) -> None:
+        config.validate()
+        self.config = config
+
+    def _augment_one(
+        self,
+        image: Any,
+        *,
+        generator: torch.Generator | None,
+    ) -> Image.Image:
+        output = _to_rgb_pil(image)
+        width, height = output.size
+        crop_side = max(
+            1,
+            min(width, height, int(round((width * height * self.config.crop_area_scale) ** 0.5))),
+        )
+        left = _randint(width - crop_side + 1, generator)
+        top = _randint(height - crop_side + 1, generator)
+        output = output.crop((left, top, left + crop_side, top + crop_side)).resize(
+            (width, height),
+            resample=Image.Resampling.BICUBIC,
+        )
+
+        brightness = _uniform(
+            1.0 - self.config.brightness_delta,
+            1.0 + self.config.brightness_delta,
+            generator,
+        )
+        contrast = _uniform(self.config.contrast_min, self.config.contrast_max, generator)
+        saturation = _uniform(
+            self.config.saturation_min,
+            self.config.saturation_max,
+            generator,
+        )
+        hue_shift = _uniform(-self.config.hue_delta, self.config.hue_delta, generator)
+
+        # torchvision ColorJitter samples all four factors, then applies the
+        # operations in a random order.  Keeping that detail makes this match
+        # the official Spatial-Forcing augmentation instead of merely using
+        # similar perturbation strengths.
+        for operation in _randperm(4, generator):
+            if operation == 0:
+                output = ImageEnhance.Brightness(output).enhance(brightness)
+            elif operation == 1:
+                output = ImageEnhance.Contrast(output).enhance(contrast)
+            elif operation == 2:
+                output = ImageEnhance.Color(output).enhance(saturation)
+            else:
+                hsv = np.array(output.convert("HSV"), dtype=np.uint8, copy=True)
+                shifted = (
+                    hsv[..., 0].astype(np.int16) + int(round(hue_shift * 255.0))
+                ) % 256
+                hsv[..., 0] = shifted.astype(np.uint8)
+                output = Image.fromarray(hsv, mode="HSV").convert("RGB")
+        return output
+
+    def __call__(
+        self,
+        batch_images: list[list[Any]],
+        *,
+        generator: torch.Generator | None = None,
+    ) -> list[list[Image.Image]]:
+        if not batch_images or not batch_images[0]:
+            raise ValueError("batch_images must contain at least one sample and one view")
+        expected_views = len(batch_images[0])
+        if any(len(images) != expected_views for images in batch_images):
+            raise ValueError("Every sample must contain the same number of camera views")
+        return [
+            [self._augment_one(image, generator=generator) for image in images]
+            for images in batch_images
+        ]
+
+
+class SpatialForcingCenterCrop:
+    """Apply the deterministic evaluation counterpart of the random train crop.
+
+    Spatial Forcing applies the same random crop to the student and teacher
+    during training.  Merely disabling that crop at deployment changes the
+    image-coordinate distribution seen by the policy.  This transform retains
+    the same crop area but fixes it at the image centre and resizes back to the
+    original shape.  Color jitter is intentionally absent at inference.
+    """
+
+    def __init__(self, crop_area_scale: float = 0.9) -> None:
+        config = SpatialForcingAugmentConfig(crop_area_scale=crop_area_scale)
+        config.validate()
+        self.crop_area_scale = float(crop_area_scale)
+
+    def _crop_one(self, image: Any) -> Image.Image:
+        output = _to_rgb_pil(image)
+        width, height = output.size
+        crop_side = max(
+            1,
+            min(width, height, int(round((width * height * self.crop_area_scale) ** 0.5))),
+        )
+        left = (width - crop_side) // 2
+        top = (height - crop_side) // 2
+        return output.crop((left, top, left + crop_side, top + crop_side)).resize(
+            (width, height),
+            resample=Image.Resampling.BICUBIC,
+        )
+
+    def __call__(self, batch_images: list[list[Any]]) -> list[list[Image.Image]]:
+        if not batch_images or not batch_images[0]:
+            raise ValueError("batch_images must contain at least one sample and one view")
+        expected_views = len(batch_images[0])
+        if any(len(images) != expected_views for images in batch_images):
+            raise ValueError("Every sample must contain the same number of camera views")
+        return [
+            [self._crop_one(image) for image in images]
+            for images in batch_images
+        ]
