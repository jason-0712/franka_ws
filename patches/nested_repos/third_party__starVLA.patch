@@ -0,0 +1,65 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo="${STARVLA_REPO:-/home/hanyu/starVLA}"
+runner="${repo}/examples/realRobots/Franka/train_files/run_qwengroot_sf_official_fidelity_smoke.sh"
+gpu="${GPU_ID:-0}"
+port_base="${MAIN_PROCESS_PORT_BASE:-29920}"
+tag="${SMOKE_TAG:-$(date +%Y%m%d_%H%M%S)}"
+run_root="${RUN_ROOT_DIR:-/data/hanyu/starVLA_runs}"
+log_root="${LOG_ROOT_DIR:-/home/hanyu/starVLA_logs}"
+
+if [[ ! -x "${runner}" ]]; then
+  echo "Missing executable runner: ${runner}" >&2
+  exit 1
+fi
+
+mkdir -p "${run_root}" "${log_root}"
+
+index=0
+for arm in control treatment; do
+  if [[ "${arm}" == control ]]; then alpha_tag="alpha0"; else alpha_tag="alpha05"; fi
+  run_id="sf_official_fidelity_${arm}_${alpha_tag}_smoke20_${tag}"
+  log="${log_root}/${run_id}.log"
+
+  MATCHED_ARM="${arm}" \
+  RUN_ID="${run_id}" \
+  RUN_ROOT_DIR="${run_root}" \
+  GPU_ID="${gpu}" \
+  MAIN_PROCESS_PORT="$((port_base + index))" \
+  MAX_TRAIN_STEPS=20 \
+  NUM_WARMUP_STEPS=5 \
+  SAVE_INTERVAL=21 \
+  EVAL_INTERVAL=20 \
+  ACTION_MODEL_LR=3e-5 \
+  QWEN_VL_LR=1e-5 \
+  ALIGNMENT_HEAD_LR=1e-4 \
+  BASE_LR=1e-6 \
+  PRETRAINED_CHECKPOINT="${PRETRAINED_CHECKPOINT:-/data/hanyu/starVLA_runs/replay94_from_successful_libero74_5k_retry1_20260810/final_model/pytorch_model.pt}" \
+  DATA_ROOT_DIR="${DATA_ROOT_DIR:-/data/hanyu/quest3_franka_real/snkdjn}" \
+  DATA_MIX="${DATA_MIX:-quest3_franka_dualcam_replay_94eps_v1}" \
+  WANDB_MODE=disabled \
+  bash "${runner}" 2>&1 | tee "${log}"
+
+  checkpoint="${run_root}/${run_id}/final_model/pytorch_model.pt"
+  if [[ ! -s "${checkpoint}" ]]; then
+    echo "Missing final checkpoint: ${checkpoint}" >&2
+    exit 1
+  fi
+  # DeepSpeed legitimately prints configuration values such as
+  # `steps_per_print: inf`; only reject fatal errors or non-finite training
+  # metrics rather than every standalone occurrence of `inf`.
+  if grep -Eiq \
+    'Traceback|OutOfMemoryError|CUDA out of memory|([[:alnum:]_./-]*(loss|score|norm|metric)[[:alnum:]_./-]*)["'\''[:space:]]*[:=][[:space:]]*(nan|[+-]?inf)([,}[:space:]]|$)' \
+    "${log}"; then
+    echo "Suspicious output in ${log}" >&2
+    exit 1
+  fi
+  echo "SF_OFFICIAL_FIDELITY_ARM_PASS=${arm}"
+  echo "SF_OFFICIAL_FIDELITY_CHECKPOINT=${checkpoint}"
+  index=$((index + 1))
+done
+
+echo "SF_OFFICIAL_FIDELITY_MATCHED_SMOKE=PASS"
+echo "SMOKE_TAG=${tag}"
+echo "ROBOT_COMMANDS_SENT=0"
diff --git a/spatial_forcing_phase_a_audit.py b/spatial_forcing_phase_a_audit.py
new file mode 100644
index 0000000..4d53590
--- /dev/null
+++ b/spatial_forcing_phase_a_audit.py
@@ -0,0 +1,565 @@
+#!/usr/bin/env python3
+"""Phase-A audit for projection leakage and patch-level SF structure.
+
+The program is deliberately action-free.  It loads RGB snapshots and policy
+checkpoints, extracts frozen Qwen visual tokens at several hidden layers, and
+asks whether a newly initialized projection head can fit VGGT while all VLA
+features remain detached.  It also writes per-patch loss heatmaps for the
+checkpoint's own alignment head when that head consumes LLM hidden tokens.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import gc
+import html
+import json
+from pathlib import Path
+import time
+from typing import Any
+
+import torch
+
+from spatial_forcing_representation_audit import (
+    DEFAULT_SNAPSHOT_ROOT,
+    DEFAULT_TEACHER,
+    TASK,
+    VIEW_NAMES,
+    autocast_context,
+    extract_teacher_cache,
+    load_rgb_only_framework,
+    load_snapshots,
+    resolve_image_token_id,
+)
+from starVLA.model.modules.spatial_forcing.alignment import (
+    extract_visual_tokens_by_view,
+    qwen_visual_token_grids,
+    resample_teacher_tokens_by_view,
+)
+from starVLA.model.modules.spatial_forcing.phase_a_audit import (
+    fit_frozen_projection_head,
+    loss_map_summary,
+    patch_structure_error,
+    token_cosine_loss_map,
+)
+from starVLA.model.modules.spatial_forcing.representation_audit import (
+    collect_pooled_records,
+    linear_cka,
+    position_rsa,
+)
+
+
+DEFAULT_BASELINE = Path(
+    "/data/hanyu/starVLA_runs/replay94_from_successful_libero74_5k_retry1_20260810/"
+    "final_model/pytorch_model.pt"
+)
+DEFAULT_CONTROL = Path(
+    "/data/hanyu/starVLA_runs/sf_official_fidelity_control_alpha0_500_seed42_20260813_official500_seed42/"
+    "final_model/pytorch_model.pt"
+)
+DEFAULT_TREATMENT = Path(
+    "/data/hanyu/starVLA_runs/sf_official_fidelity_treatment_alpha05_500_seed42_20260813_official500_seed42/"
+    "final_model/pytorch_model.pt"
+)
+DEFAULT_LABELS = (
+    "center",
+    "primary_front",
+    "primary_back",
+    "primary_left",
+    "primary_right",
+)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--baseline-checkpoint", type=Path, default=DEFAULT_BASELINE)
+    parser.add_argument("--control-checkpoint", type=Path, default=DEFAULT_CONTROL)
+    parser.add_argument("--spatial-checkpoint", type=Path, default=DEFAULT_TREATMENT)
+    parser.add_argument("--teacher-weight", type=Path, default=DEFAULT_TEACHER)
+    parser.add_argument("--snapshot-root", type=Path, default=DEFAULT_SNAPSHOT_ROOT)
+    parser.add_argument("--labels", nargs="+", default=list(DEFAULT_LABELS))
+    parser.add_argument(
+        "--projection-train-labels",
+        nargs="+",
+        default=["center", "primary_front", "primary_back"],
+    )
+    parser.add_argument(
+        "--projection-eval-labels",
+        nargs="+",
+        default=["primary_left", "primary_right"],
+    )
+    parser.add_argument("--hidden-indices", nargs="+", type=int, default=[8, 16, 24, 32])
+    parser.add_argument("--projection-steps", type=int, default=200)
+    parser.add_argument("--projection-learning-rate", type=float, default=1e-3)
+    # 2048 matches the current SF alignment-head width, so the leakage test
+    # measures the capacity actually available during training.
+    parser.add_argument("--projection-hidden-dim", type=int, default=2048)
+    parser.add_argument("--leakage-threshold", type=float, default=0.5)
+    parser.add_argument("--pool-size", type=int, default=7)
+    parser.add_argument("--task", default=TASK)
+    parser.add_argument("--image-size", type=int, default=224)
+    parser.add_argument("--device", default="cuda:0")
+    parser.add_argument("--use-bf16", action=argparse.BooleanOptionalAction, default=True)
+    parser.add_argument("--output-dir", type=Path, default=None)
+    return parser.parse_args()
+
+
+def validate_args(args: argparse.Namespace) -> dict[str, Path]:
+    models = {
+        "baseline": args.baseline_checkpoint.expanduser().resolve(),
+        "control": args.control_checkpoint.expanduser().resolve(),
+        "treatment": args.spatial_checkpoint.expanduser().resolve(),
+    }
+    for path in [*models.values(), args.teacher_weight.expanduser().resolve()]:
+        if not path.is_file() or path.stat().st_size == 0:
+            raise FileNotFoundError(f"Required checkpoint is missing or empty: {path}")
+    if len(args.labels) < 3:
+        raise ValueError("At least three labels are required")
+    train = set(args.projection_train_labels)
+    evaluate = set(args.projection_eval_labels)
+    if not train or not evaluate or train & evaluate:
+        raise ValueError("Projection train/eval labels must be non-empty and disjoint")
+    unknown = (train | evaluate) - set(args.labels)
+    if unknown:
+        raise ValueError(f"Projection labels absent from --labels: {sorted(unknown)}")
+    if not args.hidden_indices or len(set(args.hidden_indices)) != len(args.hidden_indices):
+        raise ValueError("--hidden-indices must contain unique values")
+    if args.projection_steps <= 0 or args.projection_learning_rate <= 0:
+        raise ValueError("Projection steps and learning rate must be positive")
+    if args.projection_hidden_dim <= 0 or args.pool_size <= 0:
+        raise ValueError("Projection hidden dim and pool size must be positive")
+    if not 0.0 <= args.leakage_threshold <= 1.0:
+        raise ValueError("--leakage-threshold must be in [0,1]")
+    for label in args.labels:
+        for view in VIEW_NAMES:
+            image = args.snapshot_root / label / f"{view}_original.png"
+            if not image.is_file():
+                raise FileNotFoundError(f"Snapshot is missing: {image}")
+    return models
+
+
+def extract_model_layers(
+    name: str,
+    checkpoint: Path,
+    snapshots,
+    teacher_cache,
+    *,
+    hidden_indices: list[int],
+    instruction: str,
+    device: torch.device,
+    use_bf16: bool,
+) -> dict[str, Any]:
+    print(f"PHASE_A_LOAD model={name} checkpoint={checkpoint}", flush=True)
+    framework = load_rgb_only_framework(checkpoint)
+    if use_bf16:
+        framework = framework.to(dtype=torch.bfloat16)
+    framework = framework.to(device).eval()
+    image_token_id = resolve_image_token_id(framework)
+    expected_views = int(getattr(framework, "expected_num_views", len(VIEW_NAMES)))
+    if expected_views != len(VIEW_NAMES):
+        raise ValueError(f"model={name} expects {expected_views} views")
+    vision_config = framework.qwen_vl_interface.model.config.vision_config
+    spatial_merge_size = int(getattr(vision_config, "spatial_merge_size", 2))
+    configured_index = int(getattr(framework, "student_hidden_state_index", 24))
+    feature_source = str(getattr(framework, "student_feature_source", "llm_hidden"))
+    layer_records: dict[int, dict[str, Any]] = {
+        index: {"student": {}, "teacher": {}, "grids": {}} for index in hidden_indices
+    }
+    own_maps: dict[str, dict[str, Any]] = {}
+
+    with torch.inference_mode():
+        for label, images in snapshots.items():
+            qwen_inputs = framework.qwen_vl_interface.build_qwenvl_inputs(
+                images=[images], instructions=[instruction]
+            )
+            with autocast_context(device, use_bf16):
+                output = framework.qwen_vl_interface(
+                    **qwen_inputs,
+                    output_attentions=False,
+                    output_hidden_states=True,
+                    return_dict=True,
+                )
+            states = output.hidden_states
+            for index in hidden_indices:
+                if not -len(states) <= index < len(states):
+                    raise IndexError(
+                        f"model={name} hidden index {index} invalid for {len(states)} states"
+                    )
+            input_ids = qwen_inputs["input_ids"].to(states[0].device)
+            reference_views = extract_visual_tokens_by_view(
+                states[hidden_indices[0]],
+                input_ids,
+                image_token_id=image_token_id,
+                expected_num_views=expected_views,
+            )
+            target_hw = qwen_visual_token_grids(
+                qwen_inputs["image_grid_thw"],
+                token_counts_by_view=[int(tokens.shape[1]) for tokens in reference_views],
+                batch_size=1,
+                expected_num_views=expected_views,
+                spatial_merge_size=spatial_merge_size,
+            )
+            cached = teacher_cache[label]
+            teacher_views = resample_teacher_tokens_by_view(
+                cached["tokens"],
+                source_hw=cached["source_hw"],
+                target_hw=target_hw,
+                mode="bilinear",
+            )
+            for index in hidden_indices:
+                student_views = extract_visual_tokens_by_view(
+                    states[index],
+                    input_ids,
+                    image_token_id=image_token_id,
+                    expected_num_views=expected_views,
+                )
+                for view_index, (student, teacher, grid) in enumerate(
+                    zip(student_views, teacher_views, target_hw, strict=True)
+                ):
+                    key = (label, view_index)
+                    layer_records[index]["student"][key] = student[0].float().cpu()
+                    layer_records[index]["teacher"][key] = teacher[0].float().cpu()
+                    layer_records[index]["grids"][key] = tuple(int(value) for value in grid)
+                    if (
+                        index == configured_index
+                        and feature_source == "llm_hidden"
+                        and hasattr(framework, "alignment_head")
+                    ):
+                        loss_map = token_cosine_loss_map(
+                            student,
+                            teacher.to(device=student.device, dtype=student.dtype),
+                            projector=framework.alignment_head,
+                        )[0]
+                        own_maps[f"{label}:{view_index}"] = {
+                            "label": label,
+                            "view_index": view_index,
+                            "view_name": VIEW_NAMES[view_index],
+                            "grid": [int(grid[0]), int(grid[1])],
+                            "summary": loss_map_summary(loss_map),
+                            "values": loss_map.float().cpu().tolist(),
+                        }
+            print(
+                f"PHASE_A_EXTRACT model={name} label={label} layers={hidden_indices} "
+                f"grid={target_hw}",
+                flush=True,
+            )
+            del output, states, qwen_inputs, reference_views, teacher_views
+
+    metadata = {
+        "checkpoint": str(checkpoint),
+        "framework_class": type(framework).__name__,
+        "configured_hidden_index": configured_index,
+        "student_feature_source": feature_source,
+    }
+    del framework
+    gc.collect()
+    if device.type == "cuda":
+        torch.cuda.empty_cache()
+    return {"metadata": metadata, "layers": layer_records, "own_loss_maps": own_maps}
+
+
+def _joined_batch(records: dict[tuple[str, int], torch.Tensor], labels: list[str], device):
+    tensors = []
+    for label in labels:
+        for view_index in range(len(VIEW_NAMES)):
+            tensors.append(records[(label, view_index)])
+    return torch.cat(tensors, dim=0).unsqueeze(0).to(device=device, dtype=torch.float32)
+
+
+def calculate_layer_metrics(
+    extracted: dict[str, Any],
+    *,
+    labels: list[str],
+    train_labels: list[str],
+    eval_labels: list[str],
+    pool_size: int,
+    projection_steps: int,
+    projection_learning_rate: float,
+    projection_hidden_dim: int,
+    metric_device: torch.device,
+) -> dict[str, Any]:
+    output: dict[str, Any] = {}
+    for model_name, model_data in extracted.items():
+        per_layer = {}
+        for hidden_index, data in model_data["layers"].items():
+            student_all = collect_pooled_records(
+                data["student"], data["grids"], labels,
+                num_views=len(VIEW_NAMES), output_hw=(pool_size, pool_size),
+            ).to(metric_device)
+            teacher_all = collect_pooled_records(
+                data["teacher"], data["grids"], labels,
+                num_views=len(VIEW_NAMES), output_hw=(pool_size, pool_size),
+            ).to(metric_device)
+            structure_values = []
+            for key in data["student"]:
+                structure_values.append(
+                    float(
+                        patch_structure_error(
+                            data["student"][key], data["teacher"][key]
+                        ).item()
+                    )
+                )
+            train_student = _joined_batch(data["student"], train_labels, metric_device)
+            train_teacher = _joined_batch(data["teacher"], train_labels, metric_device)
+            eval_student = _joined_batch(data["student"], eval_labels, metric_device)
+            eval_teacher = _joined_batch(data["teacher"], eval_labels, metric_device)
+            head, leakage = fit_frozen_projection_head(
+                [(train_student, train_teacher)],
+                [(eval_student, eval_teacher)],
+                steps=projection_steps,
+                learning_rate=projection_learning_rate,
+                hidden_dim=projection_hidden_dim,
+                seed=42 + int(hidden_index),
+            )
+            del head, train_student, train_teacher, eval_student, eval_teacher
+            if metric_device.type == "cuda":
+                torch.cuda.empty_cache()
+            per_layer[str(hidden_index)] = {
+                "linear_cka": float(linear_cka(student_all, teacher_all).item()),
+                "position_rsa": position_rsa(
+                    data["student"], data["teacher"], labels,
+                    num_views=len(VIEW_NAMES),
+                ),
+                "patch_structure_error_mean": sum(structure_values) / len(structure_values),
+                "patch_structure_error_by_record": structure_values,
+                "projection_leakage": leakage.to_dict(),
+            }
+            del student_all, teacher_all
+        output[model_name] = {
+            "metadata": model_data["metadata"],
+            "layers": per_layer,
+            "own_alignment_loss_maps": model_data["own_loss_maps"],
+        }
+    return output
+
+
+def compare_models(results: dict[str, Any], leakage_threshold: float) -> dict[str, Any]:
+    common_layers = sorted(
+        set(results["baseline"]["layers"])
+        & set(results["control"]["layers"])
+        & set(results["treatment"]["layers"]),
+        key=int,
+    )
+    deltas = {}
+    for layer in common_layers:
+        control = results["control"]["layers"][layer]
+        treatment = results["treatment"]["layers"][layer]
+        delta_cka = treatment["linear_cka"] - control["linear_cka"]
+        delta_structure = (
+            treatment["patch_structure_error_mean"]
+            - control["patch_structure_error_mean"]
+        )
+        delta_rsa = treatment["position_rsa"]["mean"] - control["position_rsa"]["mean"]
+        positive_votes = sum((delta_cka > 0, delta_structure < 0, delta_rsa > 0))
+        deltas[layer] = {
+            "treatment_minus_control_linear_cka": delta_cka,
+            "treatment_minus_control_patch_structure_error": delta_structure,
+            "treatment_minus_control_position_rsa": delta_rsa,
+            "projection_resistant_positive_votes": positive_votes,
+            "projection_resistant_improvement": positive_votes >= 2,
+        }
+    baseline_reductions = {
+        layer: results["baseline"]["layers"][layer]["projection_leakage"][
+            "eval_reduction_fraction"
+        ]
+        for layer in common_layers
+    }
+    max_layer = max(baseline_reductions, key=baseline_reductions.get)
+    best_structure_layer = min(
+        common_layers,
+        key=lambda layer: results["treatment"]["layers"][layer][
+            "patch_structure_error_mean"
+        ],
+    )
+    return {
+        "hidden_layers": common_layers,
+        "per_layer_treatment_minus_control": deltas,
+        "baseline_frozen_head_eval_reduction_by_layer": baseline_reductions,
+        "maximum_baseline_frozen_head_eval_reduction": baseline_reductions[max_layer],
+        "maximum_leakage_layer": max_layer,
+        "leakage_threshold": leakage_threshold,
+        "projection_leakage_risk": baseline_reductions[max_layer] >= leakage_threshold,
+        "treatment_best_layer_by_patch_structure_error": best_structure_layer,
+        "interpretation": (
+            "A large baseline frozen-head eval reduction means alignment loss can fall "
+            "without changing the VLA. Treatment evidence should therefore rely on "
+            "projection-resistant CKA, patch structure error, position RSA, and action metrics."
+        ),
+    }
+
+
+def _heat_color(value: float, maximum: float) -> str:
+    ratio = 0.0 if maximum <= 0 else min(max(value / maximum, 0.0), 1.0)
+    red = int(255 * ratio)
+    blue = int(255 * (1.0 - ratio))
+    green = int(70 * (1.0 - abs(2.0 * ratio - 1.0)))
+    return f"#{red:02x}{green:02x}{blue:02x}"
+
+
+def write_heatmap_svg(path: Path, results: dict[str, Any]) -> None:
+    panels = []
+    for model_name in ("control", "treatment"):
+        for key, value in results[model_name]["own_alignment_loss_maps"].items():
+            panels.append((model_name, key, value))
+    if not panels:
+        path.write_text(
+            '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="80">'
+            '<text x="20" y="45">No llm_hidden own-head loss maps were available.</text></svg>\n'
+        )
+        return
+    maximum = max(max(panel[2]["values"]) for panel in panels)
+    cell = 10
+    panel_width = 290
+    panel_height = 250
+    columns = 4
+    rows = (len(panels) + columns - 1) // columns
+    elements = [
+        f'<svg xmlns="http://www.w3.org/2000/svg" width="{columns * panel_width}" '
+        f'height="{rows * panel_height + 40}">',
+        '<rect width="100%" height="100%" fill="white"/>',
+        '<text x="12" y="24" font-size="16">Own-head token cosine loss: blue=low, red=high</text>',
+    ]
+    for panel_index, (model_name, _key, panel) in enumerate(panels):
+        column = panel_index % columns
+        row = panel_index // columns
+        x0 = column * panel_width + 15
+        y0 = row * panel_height + 50
+        height, width = panel["grid"]
+        title = f"{model_name} | {panel['label']} | {panel['view_name']}"
+        elements.append(
+            f'<text x="{x0}" y="{y0}" font-size="12">{html.escape(title)}</text>'
+        )
+        for index, value in enumerate(panel["values"]):
+            patch_y, patch_x = divmod(index, width)
+            elements.append(
+                f'<rect x="{x0 + patch_x * cell}" y="{y0 + 8 + patch_y * cell}" '
+                f'width="{cell}" height="{cell}" fill="{_heat_color(value, maximum)}"/>'
+            )
+        summary = panel["summary"]
+        elements.append(
+            f'<text x="{x0}" y="{y0 + 25 + height * cell}" font-size="10">'
+            f"mean={summary['mean']:.4f} p90={summary['p90']:.4f}</text>"
+        )
+    elements.append("</svg>")
+    path.write_text("\n".join(elements) + "\n")
+
+
+def write_outputs(output_dir: Path, report: dict[str, Any]) -> None:
+    output_dir.mkdir(parents=True, exist_ok=True)
+    json_path = output_dir / "phase_a_audit.json"
+    csv_path = output_dir / "phase_a_layer_metrics.csv"
+    patch_csv = output_dir / "phase_a_patch_loss_maps.csv"
+    svg_path = output_dir / "phase_a_patch_loss_heatmaps.svg"
+    json_path.write_text(json.dumps(report, indent=2) + "\n")
+    rows = []
+    for model_name, model in report["results"].items():
+        for layer, metrics in model["layers"].items():
+            rows.append(
+                {
+                    "model": model_name,
+                    "hidden_layer": layer,
+                    "linear_cka": metrics["linear_cka"],
+                    "position_rsa": metrics["position_rsa"]["mean"],
+                    "patch_structure_error": metrics["patch_structure_error_mean"],
+                    "head_only_eval_initial": metrics["projection_leakage"]["eval_initial_loss"],
+                    "head_only_eval_final": metrics["projection_leakage"]["eval_final_loss"],
+                    "head_only_eval_reduction": metrics["projection_leakage"][
+                        "eval_reduction_fraction"
+                    ],
+                }
+            )
+    with csv_path.open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+    with patch_csv.open("w", newline="") as handle:
+        fields = ["model", "label", "view", "row", "column", "loss"]
+        writer = csv.DictWriter(handle, fieldnames=fields)
+        writer.writeheader()
+        for model_name, model in report["results"].items():
+            for panel in model["own_alignment_loss_maps"].values():
+                height, width = panel["grid"]
+                for index, loss in enumerate(panel["values"]):
+                    row, column = divmod(index, width)
+                    writer.writerow(
+                        {
+                            "model": model_name,
+                            "label": panel["label"],
+                            "view": panel["view_name"],
+                            "row": row,
+                            "column": column,
+                            "loss": loss,
+                        }
+                    )
+    write_heatmap_svg(svg_path, report["results"])
+    print(f"PHASE_A_JSON={json_path}")
+    print(f"PHASE_A_LAYER_CSV={csv_path}")
+    print(f"PHASE_A_PATCH_CSV={patch_csv}")
+    print(f"PHASE_A_HEATMAP={svg_path}")
+
+
+def main() -> None:
+    args = parse_args()
+    models = validate_args(args)
+    if args.device.startswith("cuda") and not torch.cuda.is_available():
+        raise RuntimeError(f"CUDA requested but unavailable: {args.device}")
+    device = torch.device(args.device)
+    snapshots = load_snapshots(args.snapshot_root, args.labels, args.image_size)
+    started = time.time()
+    teacher_cache = extract_teacher_cache(
+        snapshots,
+        teacher_weight=args.teacher_weight,
+        device=device,
+        use_bf16=args.use_bf16,
+    )
+    extracted = {}
+    for model_name, checkpoint in models.items():
+        extracted[model_name] = extract_model_layers(
+            model_name,
+            checkpoint,
+            snapshots,
+            teacher_cache,
+            hidden_indices=args.hidden_indices,
+            instruction=args.task,
+            device=device,
+            use_bf16=args.use_bf16,
+        )
+    results = calculate_layer_metrics(
+        extracted,
+        labels=args.labels,
+        train_labels=args.projection_train_labels,
+        eval_labels=args.projection_eval_labels,
+        pool_size=args.pool_size,
+        projection_steps=args.projection_steps,
+        projection_learning_rate=args.projection_learning_rate,
+        projection_hidden_dim=args.projection_hidden_dim,
+        metric_device=device,
+    )
+    comparison = compare_models(results, args.leakage_threshold)
+    output_dir = args.output_dir or Path("/data/hanyu/starVLA_runs") / time.strftime(
+        "spatial_forcing_phase_a_audit_%Y%m%d_%H%M%S"
+    )
+    report = {
+        "status": "PASS",
+        "robot_commands_sent": 0,
+        "elapsed_seconds": time.time() - started,
+        "snapshot_root": str(args.snapshot_root),
+        "teacher_weight": str(args.teacher_weight),
+        "labels": args.labels,
+        "projection_train_labels": args.projection_train_labels,
+        "projection_eval_labels": args.projection_eval_labels,
+        "hidden_indices": args.hidden_indices,
+        "projection_steps": args.projection_steps,
+        "results": results,
+        "comparison": comparison,
+    }
+    write_outputs(output_dir, report)
+    print(json.dumps(comparison, indent=2))
+    print("SPATIAL_FORCING_PHASE_A_AUDIT=PASS")
+    print(f"PROJECTION_LEAKAGE_RISK={str(comparison['projection_leakage_risk']).upper()}")
+    print("ROBOT_COMMANDS_SENT=0")
+
+
+if __name__ == "__main__":
+    main()
