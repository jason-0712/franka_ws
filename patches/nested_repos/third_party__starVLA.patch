+"""Core feature-alignment operations for a Spatial-Forcing adaptation.
+
+This file contains both the projected token objective used by Spatial Forcing
+and a projection-free relational objective that directly constrains student
+token geometry.  It contains no VGGT dependency and can therefore be
+unit-tested without downloading teacher or Qwen weights.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from collections import OrderedDict
+import math
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+def strip_spatial_teacher_state_dict(
+    state_dict: Mapping[str, torch.Tensor],
+) -> OrderedDict[str, torch.Tensor]:
+    """Remove training-only VGGT tensors from an Accelerate state dict.
+
+    ``Accelerator.get_state_dict`` may gather parameters directly from a
+    DeepSpeed engine and therefore bypass ``FrozenVGGTTeacher.state_dict``.
+    Filtering at the policy boundary keeps checkpoints RGB-only regardless
+    of the distributed backend used to save them.
+    """
+
+    def is_teacher_key(key: str) -> bool:
+        return key.startswith("spatial_teacher.") or ".spatial_teacher." in key
+
+    filtered = OrderedDict(
+        (key, value) for key, value in state_dict.items() if not is_teacher_key(key)
+    )
+    metadata = getattr(state_dict, "_metadata", None)
+    if metadata is not None:
+        filtered._metadata = {
+            key: value
+            for key, value in metadata.items()
+            if key != "spatial_teacher" and ".spatial_teacher" not in key
+        }
+    return filtered
+
+
+def _find_image_token_spans(
+    input_ids: torch.Tensor,
+    image_token_id: int,
+    expected_num_views: int,
+) -> list[list[torch.Tensor]]:
+    """Locate each contiguous Qwen image-token run in camera order.
+
+    This helper intentionally lives in the training-only package so the
+    alignment unit tests do not depend on the separate online-DAv2 module.
+    """
+
+    if input_ids.ndim != 2:
+        raise ValueError(f"input_ids must have shape [B,L], got {tuple(input_ids.shape)}")
+    if expected_num_views <= 0:
+        raise ValueError("expected_num_views must be positive")
+
+    batch_spans: list[list[torch.Tensor]] = []
+    for sample_index in range(input_ids.shape[0]):
+        positions = torch.where(input_ids[sample_index] == image_token_id)[0]
+        if positions.numel() == 0:
+            raise ValueError(
+                f"Sample {sample_index} contains no Qwen image tokens (id={image_token_id})"
+            )
+        split_points = torch.where(torch.diff(positions) > 1)[0] + 1
+        spans = list(torch.tensor_split(positions, split_points.cpu().tolist()))
+        if len(spans) != expected_num_views:
+            lengths = [int(span.numel()) for span in spans]
+            raise ValueError(
+                f"Sample {sample_index} exposes {len(spans)} image-token spans, expected "
+                f"{expected_num_views}; span lengths={lengths}"
+            )
+        batch_spans.append(spans)
+    return batch_spans
+
+
+def extract_visual_tokens_by_view(
+    hidden_states: torch.Tensor,
+    input_ids: torch.Tensor,
+    *,
+    image_token_id: int,
+    expected_num_views: int,
+) -> list[torch.Tensor]:
+    """Extract ordered Qwen image-token spans from an intermediate layer.
+
+    Returns one tensor per camera, each with shape ``[B, N_view, D]``.  Token
+    counts may differ between cameras, but every sample in a batch must expose
+    the same count for a given camera so tensors can be stacked safely.
+    """
+
+    if hidden_states.ndim != 3:
+        raise ValueError(
+            f"hidden_states must have shape [B,L,D], got {tuple(hidden_states.shape)}"
+        )
+    if input_ids.shape != hidden_states.shape[:2]:
+        raise ValueError(
+            f"input_ids shape {tuple(input_ids.shape)} does not match hidden sequence "
+            f"{tuple(hidden_states.shape[:2])}"
+        )
+
+    spans_by_sample = _find_image_token_spans(input_ids, image_token_id, expected_num_views)
+    tokens_by_view: list[torch.Tensor] = []
+    for view_index in range(expected_num_views):
+        view_tokens = [
+            hidden_states[sample_index].index_select(0, spans[view_index])
+            for sample_index, spans in enumerate(spans_by_sample)
+        ]
+        lengths = [int(tokens.shape[0]) for tokens in view_tokens]
+        if len(set(lengths)) != 1:
+            raise ValueError(
+                f"View {view_index} has non-uniform token counts across the batch: {lengths}"
+            )
+        tokens_by_view.append(torch.stack(view_tokens, dim=0))
+    return tokens_by_view
+
+
+def qwen_visual_token_grids(
+    image_grid_thw: torch.Tensor,
+    *,
+    token_counts_by_view: Sequence[int],
+    batch_size: int,
+    expected_num_views: int,
+    spatial_merge_size: int,
+) -> tuple[tuple[int, int], ...]:
+    """Resolve the two-dimensional Qwen visual-token grid for each view.
+
+    Qwen exposes a pre-merge ``image_grid_thw`` row for every image.  The
+    visual tokens inserted into the language sequence are spatially merged,
+    so their expected count is ``T * (H / merge) * (W / merge)``.  Spatial
+    Forcing must preserve that two-dimensional organization when resizing
+    VGGT patches; treating the image run as an arbitrary 1-D sequence would
+    silently destroy token correspondence.
+
+    The current Franka pipeline uses still RGB images (``T == 1``).  We keep
+    the temporal dimension by folding it into height for completeness.
+    """
+
+    if image_grid_thw.ndim != 2 or image_grid_thw.shape[1] != 3:
+        raise ValueError(
+            f"image_grid_thw must have shape [num_images,3], got {tuple(image_grid_thw.shape)}"
+        )
+    if min(batch_size, expected_num_views, spatial_merge_size) <= 0:
+        raise ValueError("batch_size, expected_num_views, and spatial_merge_size must be positive")
+    expected_rows = batch_size * expected_num_views
+    if image_grid_thw.shape[0] != expected_rows:
+        raise ValueError(
+            f"Qwen returned {image_grid_thw.shape[0]} image grids, expected {expected_rows} "
+            f"for batch_size={batch_size}, views={expected_num_views}"
+        )
+                                                                                                             raise ValueError(
+            f"Expected {expected_num_views} token counts, got {len(token_counts_by_view)}"
+        )
+
+    rows = image_grid_thw.detach().cpu().to(dtype=torch.int64).reshape(
+        batch_size, expected_num_views, 3
+    )
+    output: list[tuple[int, int]] = []
+    for view_index in range(expected_num_views):
+        view_rows = rows[:, view_index]
+        if not torch.equal(view_rows, view_rows[0].expand_as(view_rows)):
+            raise ValueError(
+                f"View {view_index} has non-uniform Qwen grids across the batch: "
+                f"{view_rows.tolist()}"
+            )
+        temporal, height, width = (int(value) for value in view_rows[0].tolist())
+        if min(temporal, height, width) <= 0:
+            raise ValueError(f"Invalid Qwen grid for view {view_index}: {(temporal, height, width)}")
+        if height % spatial_merge_size or width % spatial_merge_size:
+            raise ValueError(
+                f"Qwen grid {(temporal, height, width)} is not divisible by "
+                f"spatial_merge_size={spatial_merge_size}"
+            )
+        target_grid = (
+            temporal * (height // spatial_merge_size),
+            width // spatial_merge_size,
+        )
+        actual_tokens = int(token_counts_by_view[view_index])
+        if math.prod(target_grid) != actual_tokens:
+            raise ValueError(
+                f"View {view_index} Qwen grid {target_grid} implies {math.prod(target_grid)} "
+                f"tokens, but the image-token span contains {actual_tokens}"
+            )
+        output.append(target_grid)
+    return tuple(output)
+
+
+def split_qwen_visual_features_by_view(
+    flat_tokens: torch.Tensor,
+    image_grid_thw: torch.Tensor,
+    *,
+    batch_size: int,
+    expected_num_views: int,
+    spatial_merge_size: int,
+    merged: bool,
+) -> tuple[list[torch.Tensor], tuple[tuple[int, int], ...]]:
+    """Split Qwen vision-encoder or post-merger features into camera views.
+
+    Qwen3-VL concatenates all images in a batch before its vision tower.  The
+    pre-merger encoder exposes ``T*H*W`` tokens per image, while the projector
+    exposes ``T*(H/merge)*(W/merge)`` tokens.  This helper restores tensors of
+    shape ``[B,N_view,D]`` in the processor's sample-major camera order and
+    returns the corresponding two-dimensional grids.
+    """
+
+    if flat_tokens.ndim != 2:
+        raise ValueError(
+            f"flat_tokens must have shape [sum_tokens,D], got {tuple(flat_tokens.shape)}"
+        )
+    if image_grid_thw.ndim != 2 or image_grid_thw.shape[1] != 3:
+        raise ValueError(
+            f"image_grid_thw must have shape [num_images,3], got {tuple(image_grid_thw.shape)}"
+        )
+    if min(batch_size, expected_num_views, spatial_merge_size) <= 0:
+        raise ValueError("batch_size, expected_num_views, and spatial_merge_size must be positive")
+    expected_images = batch_size * expected_num_views
+    if image_grid_thw.shape[0] != expected_images:
+        raise ValueError(
+            f"Qwen returned {image_grid_thw.shape[0]} image grids, expected {expected_images}"
+        )
+
+    rows = image_grid_thw.detach().cpu().to(dtype=torch.int64)
+    token_counts: list[int] = []
+    image_grids: list[tuple[int, int]] = []
+    for image_index, row in enumerate(rows):
+        temporal, height, width = (int(value) for value in row.tolist())
+        if min(temporal, height, width) <= 0:
+            raise ValueError(f"Invalid Qwen grid at image {image_index}: {tuple(row.tolist())}")
+        if merged:
+            if height % spatial_merge_size or width % spatial_merge_size:
+                raise ValueError(
+                    f"Qwen grid {(temporal, height, width)} is not divisible by "
+                    f"spatial_merge_size={spatial_merge_size}"
+                )
+            grid = (
+                temporal * (height // spatial_merge_size),
+                width // spatial_merge_size,
+            )
+        else:
+            grid = (temporal * height, width)
+        image_grids.append(grid)
+        token_counts.append(math.prod(grid))
+
+    if sum(token_counts) != int(flat_tokens.shape[0]):
+        raise ValueError(
+            f"Qwen grids imply {sum(token_counts)} tokens, but the captured vision "
+            f"tensor contains {flat_tokens.shape[0]}"
+        )
+    flat_by_image = list(torch.split(flat_tokens, token_counts, dim=0))
+    tokens_by_view: list[torch.Tensor] = []
+    grids_by_view: list[tuple[int, int]] = []
+    for view_index in range(expected_num_views):
+        indices = [
+            sample_index * expected_num_views + view_index
+            for sample_index in range(batch_size)
+        ]
+        view_grids = [image_grids[index] for index in indices]
+        if len(set(view_grids)) != 1:
+            raise ValueError(
+                f"View {view_index} has non-uniform Qwen grids across the batch: {view_grids}"
+            )
+        view_tokens = [flat_by_image[index] for index in indices]
+        if len({int(tokens.shape[0]) for tokens in view_tokens}) != 1:
+            raise ValueError(f"View {view_index} has non-uniform token counts across the batch")
+        tokens_by_view.append(torch.stack(view_tokens, dim=0))
+        grids_by_view.append(view_grids[0])
+    return tokens_by_view, tuple(grids_by_view)
+
+
+def select_qwen_merger_feature(
+    student_feature_source: str,
+    merger_inputs: tuple,
+    merger_output,
+) -> torch.Tensor:
+    """Select pre- or post-merger Qwen3-VL tokens from one merger call.
+
+    Transformers 4.57 returns ``(merged_tokens, deepstack_features)`` from
+    the *vision tower*, while newer releases may expose a model-output
+    object.  The main ``visual.merger`` contract is much more stable: its
+    first positional input contains the final vision-encoder patch tokens and
+    its output contains the merged image embeddings inserted into the LLM.
+    Hooking that module therefore avoids version-specific assumptions about
+    the enclosing vision-tower return type.
+    """
+
+    if student_feature_source == "vision_encoder":
+        if not merger_inputs:
+            raise RuntimeError("Qwen visual merger hook received no positional input")
+        value = merger_inputs[0]
+    elif student_feature_source == "vision_projector":
+        value = merger_output
+    else:
+        raise ValueError(
+            "student_feature_source must be vision_encoder or vision_projector"
+        )
+
+    if isinstance(value, (tuple, list)):
+        tensor_values = [item for item in value if torch.is_tensor(item)]
+        if len(tensor_values) != 1:
+            raise RuntimeError(
+                "Qwen visual merger feature must expose exactly one tensor, "
+                f"found {len(tensor_values)}"
+            )
+        value = tensor_values[0]
+    if not torch.is_tensor(value):
+        raise RuntimeError(
+            f"Qwen visual merger {student_feature_source} feature is not a tensor: "
+            f"{type(value).__name__}"
+        )
+    if value.ndim != 2:
+        raise RuntimeError(
+            f"Qwen visual merger {student_feature_source} feature must have shape "
+            f"[sum_tokens,D], got {tuple(value.shape)}"
+        )
+    return value
+
+
+def _validate_hw(name: str, value: tuple[int, int], expected_tokens: int) -> None:
+    if len(value) != 2 or min(value) <= 0:
+        raise ValueError(f"{name} must contain two positive integers, got {value}")
+    if value[0] * value[1] != expected_tokens:
+        raise ValueError(
+            f"{name}={value} contains {value[0] * value[1]} positions, "
+            f"but the corresponding tensor contains {expected_tokens} tokens"
+        )
+
+
+def resample_teacher_tokens_by_view(
+    teacher_tokens: torch.Tensor,
+    *,
+    source_hw: Sequence[tuple[int, int]],
+    target_hw: Sequence[tuple[int, int]],
+    mode: str = "bilinear",
+) -> list[torch.Tensor]:
+    """Spatially resize frozen-teacher patch grids to student image grids.
+
+    Args:
+        teacher_tokens: Tensor with shape ``[B,V,N_teacher,D_teacher]``.
+        source_hw: Per-view teacher patch-grid shapes.
+        target_hw: Per-view student image-token-grid shapes.
+
+    Returns:
+        One tensor per view, each shaped ``[B,H_target*W_target,D_teacher]``.
+
+    The operation preserves the two-dimensional patch arrangement.  Flattened
+    sequence truncation is deliberately unsupported because it destroys pixel
+    correspondence between VGGT and Qwen visual tokens.
+    """
+
+    if teacher_tokens.ndim != 4:
+        raise ValueError(
+            f"teacher_tokens must have shape [B,V,N,D], got {tuple(teacher_tokens.shape)}"
+        )
+    num_views = int(teacher_tokens.shape[1])
+    if len(source_hw) != num_views or len(target_hw) != num_views:
+        raise ValueError(
+            f"Expected {num_views} source/target grids, got {len(source_hw)} and {len(target_hw)}"
+        )
+    if mode not in {"bilinear", "bicubic", "nearest"}:
+        raise ValueError(f"Unsupported interpolation mode: {mode}")
+
+    output: list[torch.Tensor] = []
+    for view_index, (source_grid, target_grid) in enumerate(zip(source_hw, target_hw)):
+        view = teacher_tokens[:, view_index]
+        _validate_hw("source_hw", source_grid, int(view.shape[1]))
+        if len(target_grid) != 2 or min(target_grid) <= 0:
+            raise ValueError(f"target_hw must contain two positive integers, got {target_grid}")
+
+        batch_size, _, feature_dim = view.shape
+        feature_map = view.transpose(1, 2).reshape(
+            batch_size, feature_dim, source_grid[0], source_grid[1]
+        )
+        interpolate_kwargs = {
+            "size": tuple(int(value) for value in target_grid),
+            "mode": mode,
+        }
+        if mode != "nearest":
+            interpolate_kwargs["align_corners"] = True
+        resized = F.interpolate(feature_map, **interpolate_kwargs)
+        output.append(resized.flatten(2).transpose(1, 2).contiguous())
+    return output
+
+
+def masked_cosine_alignment_loss(
+    student_tokens: torch.Tensor,
+    teacher_tokens: torch.Tensor,
+    mask: torch.Tensor | None = None,
+    *,
+    eps: float = 1e-6,
+) -> torch.Tensor:
+    """Return mean token-wise ``1 - cosine_similarity``.
+
+    Teacher features are detached inside this function as a second line of
+    defense in addition to running the teacher under ``torch.no_grad()``.
+    """
+
+    if student_tokens.shape != teacher_tokens.shape:
+        raise ValueError(
+            f"Student/teacher shapes must match, got {tuple(student_tokens.shape)} and "
+            f"{tuple(teacher_tokens.shape)}"
+        )
+    if student_tokens.ndim != 3:
+        raise ValueError("student_tokens and teacher_tokens must have shape [B,N,D]")
+    if mask is not None and mask.shape != student_tokens.shape[:2]:
+        raise ValueError(
+            f"mask shape {tuple(mask.shape)} does not match tokens {tuple(student_tokens.shape[:2])}"
+        )
+
+    student = F.normalize(student_tokens.float(), dim=-1, eps=eps)
+    teacher = F.normalize(teacher_tokens.detach().float(), dim=-1, eps=eps)
+    token_loss = 1.0 - (student * teacher).sum(dim=-1)
+
+    if mask is None:
+        return token_loss.mean()
+    valid = mask.bool()
+    if not valid.any():
+        raise ValueError("alignment mask contains no valid tokens")
+    return token_loss[valid].mean()
+
+
+def relational_geometry_loss(
+    student_tokens: torch.Tensor,
+    teacher_tokens: torch.Tensor,
+    mask: torch.Tensor | None = None,
+    *,
+    eps: float = 1e-6,
+) -> torch.Tensor:
+    """Match pairwise token geometry without a learned projection head.
+
+    The student and teacher feature dimensions may differ.  Each feature is
+    L2-normalized independently, then its token-to-token cosine-similarity
+    matrix is formed.  Matching those two Gram matrices forces the student
+    representation itself to preserve the teacher's spatial relationships;
+    a trainable alignment head cannot absorb this objective.
+
+    Diagonal entries are excluded because they are identically one after
+    normalization and would dilute the useful off-diagonal supervision.
+    Teacher features are detached as a defense-in-depth guarantee that the
+    frozen VGGT teacher never receives gradients.
+    """
+
+    if student_tokens.ndim != 3 or teacher_tokens.ndim != 3:
+        raise ValueError("student_tokens and teacher_tokens must have shape [B,N,D]")
+    if student_tokens.shape[:2] != teacher_tokens.shape[:2]:
+        raise ValueError(
+            "Student/teacher batch and token dimensions must match, got "
+            f"{tuple(student_tokens.shape[:2])} and {tuple(teacher_tokens.shape[:2])}"
+        )
+    batch_size, token_count = student_tokens.shape[:2]
+    if token_count < 2:
+        raise ValueError("relational geometry loss requires at least two tokens")
+    if mask is not None and mask.shape != (batch_size, token_count):
+        raise ValueError(
+            f"mask shape {tuple(mask.shape)} does not match tokens {(batch_size, token_count)}"
+        )
+
+    student = F.normalize(student_tokens.float(), dim=-1, eps=eps)
+    teacher = F.normalize(teacher_tokens.detach().float(), dim=-1, eps=eps)
+    student_relations = student @ student.transpose(-1, -2)
+    teacher_relations = teacher @ teacher.transpose(-1, -2)
+
+    if mask is None:
+        valid_tokens = torch.ones(
+            (batch_size, token_count),
+            dtype=torch.bool,
+            device=student_tokens.device,
+        )
+    else:
+        valid_tokens = mask.to(device=student_tokens.device, dtype=torch.bool)
+    pair_mask = valid_tokens.unsqueeze(-1) & valid_tokens.unsqueeze(-2)
+    diagonal = torch.eye(token_count, dtype=torch.bool, device=student_tokens.device)
+    pair_mask = pair_mask & ~diagonal.unsqueeze(0)
+    if not pair_mask.any():
+        raise ValueError("relational geometry mask contains fewer than two valid tokens")
+
+    squared_error = (student_relations - teacher_relations).square()
+    return squared_error[pair_mask].mean()
+
+
+class SpatialAlignmentHead(nn.Module):
+    """Project VLA visual tokens and align them with detached teacher tokens."""
+
+    def __init__(
+        self,
+        student_dim: int,
+        teacher_dim: int,
+        *,
+        hidden_dim: int | None = None,
+        use_student_norm: bool = True,
+    ) -> None:
+        super().__init__()
+        if min(student_dim, teacher_dim) <= 0:
+            raise ValueError("student_dim and teacher_dim must be positive")
+        hidden_dim = int(hidden_dim or teacher_dim)
+        if hidden_dim <= 0:
+            raise ValueError("hidden_dim must be positive")
+
+        self.student_norm = nn.LayerNorm(student_dim) if use_student_norm else nn.Identity()
+        self.fc1 = nn.Linear(student_dim, hidden_dim)
+        self.activation = nn.GELU()
+        self.fc2 = nn.Linear(hidden_dim, teacher_dim)
+        self.reset_parameters()
+
+    def reset_parameters(self) -> None:
+        for module in (self.fc1, self.fc2):
+            nn.init.xavier_uniform_(module.weight)
+            if module.bias is not None:
+                nn.init.zeros_(module.bias)
+
+    def project(self, student_tokens: torch.Tensor) -> torch.Tensor:
+        return self.fc2(self.activation(self.fc1(self.student_norm(student_tokens))))
+
+    def forward(
+        self,
+        student_tokens: torch.Tensor,
+        teacher_tokens: torch.Tensor,
+        mask: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        projected = self.project(student_tokens)
+        return masked_cosine_alignment_loss(projected, teacher_tokens, mask)
+
+
+class SceneRelationalMemoryBank(nn.Module):
+    """Align scene-to-scene geometry with a detached FIFO feature queue.
+
+    The Franka setup trains with a per-device batch size of one.  A token Gram
+    loss can constrain geometry inside one observation but cannot compare two
+    cube placements.  This module retains recent mean-pooled scene features
+    and matches the current student's similarities to that history against a
+    frozen teacher's similarities to the same history.
+
+    Historical student and teacher features are detached.  Gradients flow
+    only through the current student features.  Buffers are non-persistent so
+    the queue never inflates a deployable checkpoint and resets naturally on
+    a new training process.
+    """
+
+    def __init__(
+        self,
+        *,
+        num_views: int,
+        student_dim: int,
+        teacher_dim: int,
+        queue_size: int,
+    ) -> None:
+        super().__init__()
+        if min(num_views, student_dim, teacher_dim) <= 0:
+            raise ValueError("num_views, student_dim, and teacher_dim must be positive")
+        if queue_size < 0:
+            raise ValueError("queue_size must be non-negative")
+        self.num_views = int(num_views)
+        self.student_dim = int(student_dim)
+        self.teacher_dim = int(teacher_dim)
+        self.queue_size = int(queue_size)
+        self.register_buffer(
+            "student_queue",
+            torch.empty(self.num_views, 0, self.student_dim),
+            persistent=False,
+        )
+        self.register_buffer(
+            "teacher_queue",
+            torch.empty(self.num_views, 0, self.teacher_dim),
+            persistent=False,
+        )
+
+    @property
+    def fill(self) -> int:
+        return int(self.student_queue.shape[1])
+
+    def reset(self) -> None:
+        self.student_queue = self.student_queue[:, :0]
+        self.teacher_queue = self.teacher_queue[:, :0]
+
+    def _pool_views(
+        self,
+        views: Sequence[torch.Tensor],
+        *,
+        expected_dim: int,
+        name: str,
+    ) -> torch.Tensor:
+        if len(views) != self.num_views:
+            raise ValueError(f"{name} exposes {len(views)} views, expected {self.num_views}")
+        batch_sizes = []
+        pooled = []
+        for view_index, tokens in enumerate(views):
+            if tokens.ndim != 3 or tokens.shape[-1] != expected_dim:
+                raise ValueError(
+                    f"{name}[{view_index}] must have shape [B,N,{expected_dim}], "
+                    f"got {tuple(tokens.shape)}"
+                )
+            if tokens.shape[1] <= 0:
+                raise ValueError(f"{name}[{view_index}] contains no tokens")
+            batch_sizes.append(int(tokens.shape[0]))
+            pooled.append(tokens.mean(dim=1))
+        if len(set(batch_sizes)) != 1:
+            raise ValueError(f"{name} views have inconsistent batch sizes: {batch_sizes}")
+        return torch.stack(pooled, dim=1)
+
+    @torch.no_grad()
+    def _enqueue(self, student: torch.Tensor, teacher: torch.Tensor) -> None:
+        if self.queue_size == 0:
+            return
+        student_new = student.detach().permute(1, 0, 2).to(
+            device=self.student_queue.device,
+            dtype=self.student_queue.dtype,
+        )
+        teacher_new = teacher.detach().permute(1, 0, 2).to(
+            device=self.teacher_queue.device,
+            dtype=self.teacher_queue.dtype,
+        )
+        self.student_queue = torch.cat((self.student_queue, student_new), dim=1)[
+            :, -self.queue_size :
+        ]
+        self.teacher_queue = torch.cat((self.teacher_queue, teacher_new), dim=1)[
+            :, -self.queue_size :
+        ]
+
+    def forward(
+        self,
+        student_views: Sequence[torch.Tensor],
+        teacher_views: Sequence[torch.Tensor],
+    ) -> tuple[torch.Tensor, int]:
+        student = self._pool_views(
+            student_views,
+            expected_dim=self.student_dim,
+            name="student_views",
+        )
+        teacher = self._pool_views(
+            teacher_views,
+            expected_dim=self.teacher_dim,
+            name="teacher_views",
+        ).detach()
+        if student.shape[:2] != teacher.shape[:2]:
+            raise ValueError(
+                f"Student/teacher scene shapes differ: {tuple(student.shape[:2])} and "
+                f"{tuple(teacher.shape[:2])}"
+            )
+
+        squared_errors: list[torch.Tensor] = []
+        for view_index in range(self.num_views):
+            current_student = F.normalize(student[:, view_index].float(), dim=-1)
+            current_teacher = F.normalize(teacher[:, view_index].float(), dim=-1)
+
+            if self.fill:
+                queued_student = F.normalize(
+                    self.student_queue[view_index].detach().float(), dim=-1
+                )
+                queued_teacher = F.normalize(
+                    self.teacher_queue[view_index].detach().float(), dim=-1
+                )
+                student_similarity = current_student @ queued_student.transpose(0, 1)
+                teacher_similarity = current_teacher @ queued_teacher.transpose(0, 1)
+                squared_errors.append((student_similarity - teacher_similarity).square().reshape(-1))
+
+            # This also supports a future batch-size >1 configuration without
+            # waiting for the queue to warm up.  The diagonal is uninformative.
+            batch_size = int(current_student.shape[0])
+            if batch_size > 1:
+                student_similarity = current_student @ current_student.transpose(0, 1)
+                teacher_similarity = current_teacher @ current_teacher.transpose(0, 1)
+                off_diagonal = ~torch.eye(
+                    batch_size,
+                    dtype=torch.bool,
+                    device=current_student.device,
+                )
+                squared_errors.append(
+                    (student_similarity - teacher_similarity).square()[off_diagonal]
+                )
+
+        if squared_errors:
+            loss = torch.cat(squared_errors).mean()
+        else:
+            # Differentiable zero for the first batch-size-one observation.
+            loss = student.float().sum() * 0.0
+
+        if self.training:
+            self._enqueue(student, teacher)
+        return loss, self.fill
