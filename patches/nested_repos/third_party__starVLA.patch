+            ((0.20, 0.48, 0.85, 1.00), (0.0, 0.0, 1.0, 1.0)),
+            view_names=("primary", "wrist"),
+        )
+        output = transform([[primary, wrist]])[0]
+        self.assertEqual([image.size for image in output], [primary.size, wrist.size])
+        self.assertFalse(np.array_equal(np.asarray(output[0]), np.asarray(primary)))
+        self.assertTrue(np.array_equal(np.asarray(output[1]), np.asarray(wrist)))
