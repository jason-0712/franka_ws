+"""Frozen, training-only VGGT feature teacher.
+
+The official Spatial-Forcing implementation uses VGGT in feature-only mode and
+never includes it in policy inference.  This wrapper preserves that contract:
+all teacher operations run without gradients, and teacher parameters are
+excluded from the containing policy's state dict.
+"""
+
+from __future__ import annotations
+
+from contextlib import nullcontext
+from collections import OrderedDict
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+import torch.nn as nn
+from PIL import Image
+
+
+@dataclass(frozen=True)
+class VGGTTeacherOutput:
+    """Spatial teacher patches and their per-view source grids."""
+
+    tokens: torch.Tensor
+    source_hw: tuple[tuple[int, int], ...]
+
+
+def _to_rgb_pil(image: Any) -> Image.Image:
+    if isinstance(image, Image.Image):
+        return image.convert("RGB")
+    if isinstance(image, torch.Tensor):
+        tensor = image.detach().cpu()
+        if tensor.ndim != 3:
+            raise ValueError(f"Tensor image must have 3 dimensions, got {tuple(tensor.shape)}")
+        if tensor.shape[0] in (1, 3, 4):
+            tensor = tensor.permute(1, 2, 0)
+        array = tensor.numpy()
+    else:
+        array = np.asarray(image)
+
+    if array.ndim != 3:
+        raise ValueError(f"Image array must have shape [H,W,C], got {tuple(array.shape)}")
+    if array.shape[-1] == 1:
+        array = np.repeat(array, 3, axis=-1)
+    if array.shape[-1] == 4:
+        array = array[..., :3]
+    if array.shape[-1] != 3:
+        raise ValueError(f"Expected 1, 3, or 4 image channels, got {array.shape[-1]}")
+    if np.issubdtype(array.dtype, np.floating):
+        max_value = float(np.nanmax(array)) if array.size else 0.0
+        if max_value <= 1.0:
+            array = array * 255.0
+    array = np.nan_to_num(array, nan=0.0, posinf=255.0, neginf=0.0)
+    return Image.fromarray(np.clip(array, 0, 255).astype(np.uint8), mode="RGB")
+
+
+class FrozenVGGTTeacher(nn.Module):
+    """Load VGGT features for alignment without making VGGT part of a policy."""
+
+    def __init__(
+        self,
+        *,
+        weight_path: str | Path | None = None,
+        model: nn.Module | None = None,
+        input_size: int = 518,
+        feature_layer: int = -1,
+        use_bf16: bool = True,
+        use_vggt_positional_embedding: bool = True,
+        positional_embedding_ratio: float = 0.1,
+    ) -> None:
+        super().__init__()
+        if input_size <= 0:
+            raise ValueError("input_size must be positive")
+        if positional_embedding_ratio < 0:
+            raise ValueError("positional_embedding_ratio must be non-negative")
+
+        if model is None:
+            try:
+                from vggt.models.vggt import VGGT
+            except ImportError as exc:
+                raise ImportError(
+                    "VGGT is required only for Spatial-Forcing training. Add the official "
+                    "Spatial-Forcing openvla-SF source to PYTHONPATH before constructing the teacher."
+                ) from exc
+            if weight_path is None:
+                raise ValueError("weight_path is required when no preconstructed VGGT model is supplied")
+            model = VGGT(
+                enable_camera=False,
+                enable_point=False,
+                enable_depth=False,
+                enable_track=False,
+                feature_only=True,
+            )
+            checkpoint_path = Path(weight_path)
+            if not checkpoint_path.is_file():
+                raise FileNotFoundError(f"VGGT checkpoint not found: {checkpoint_path}")
+            state_dict = torch.load(checkpoint_path, map_location="cpu", weights_only=True)
+            model.load_state_dict(state_dict, strict=False)
+
+        self.model = model
+        self.input_size = int(input_size)
+        self.feature_layer = int(feature_layer)
+        self.use_bf16 = bool(use_bf16)
+        self.use_vggt_positional_embedding = bool(use_vggt_positional_embedding)
+        self.positional_embedding_ratio = float(positional_embedding_ratio)
+        self._freeze_teacher()
+
+    @property
+    def feature_dim(self) -> int | None:
+        """Return the expected aggregated feature width when VGGT exposes it."""
+
+        embed_dim = getattr(self.model, "embed_dim", None)
+        return None if embed_dim is None else 2 * int(embed_dim)
+
+    def _freeze_teacher(self) -> None:
+        self.model.eval()
+        for parameter in self.model.parameters():
+            parameter.requires_grad_(False)
+            parameter.grad = None
+        super().train(False)
+
+    def train(self, mode: bool = True):
+        self._freeze_teacher()
+        return self
+
+    def _save_to_state_dict(self, destination, prefix, keep_vars):
+        # VGGT is a reproducible external dependency and must not inflate the
+        # deployable student checkpoint by several gigabytes.
+        return None
+
+    def state_dict(self, destination=None, prefix="", keep_vars=False):
+        """Deliberately contribute no teacher tensors to a parent checkpoint."""
+
+        if destination is None:
+            destination = OrderedDict()
+        return destination
+
+    def _load_from_state_dict(
+        self,
+        state_dict,
+        prefix,
+        local_metadata,
+        strict,
+        missing_keys,
+        unexpected_keys,
+        error_msgs,
+    ):
+        # Teacher weights are always loaded from weight_path, never the policy.
+        return None
+
+    def preprocess_images(self, batch_images: list[list[Any]]) -> torch.Tensor:
+        if not batch_images or not batch_images[0]:
+            raise ValueError("batch_images must contain at least one sample and one view")
+        expected_views = len(batch_images[0])
+        if any(len(images) != expected_views for images in batch_images):
+            raise ValueError("Every sample must contain the same number of camera views")
+
+        samples: list[torch.Tensor] = []
+        for images in batch_images:
+            views: list[torch.Tensor] = []
+            for image in images:
+                pil = _to_rgb_pil(image).resize(
+                    (self.input_size, self.input_size),
+                    resample=Image.Resampling.BICUBIC,
+                )
+                array = np.asarray(pil, dtype=np.float32) / 255.0
+                views.append(torch.from_numpy(array).permute(2, 0, 1).contiguous())
+            samples.append(torch.stack(views, dim=0))
+        return torch.stack(samples, dim=0)
+
+    def _add_vggt_position_embedding(
+        self,
+        tokens: torch.Tensor,
+        source_hw: tuple[int, int],
+    ) -> torch.Tensor:
+        try:
+            from vggt.heads.utils import create_uv_grid, position_grid_to_embed
+        except ImportError as exc:
+            raise ImportError(
+                "Official VGGT positional-embedding helpers are unavailable. "
+                "Ensure openvla-SF is on PYTHONPATH or disable use_vggt_positional_embedding."
+            ) from exc
+
+        height, width = source_hw
+        grid = create_uv_grid(
+            width,
+            height,
+            aspect_ratio=width / height,
+            dtype=tokens.dtype,
+            device=tokens.device,
+        )
+        embedding = position_grid_to_embed(grid, tokens.shape[-1])
+        embedding = embedding.reshape(1, 1, height * width, tokens.shape[-1])
+        return tokens + self.positional_embedding_ratio * embedding
+
+    def forward(self, batch_images: list[list[Any]]) -> VGGTTeacherOutput:
+        images = self.preprocess_images(batch_images)
+        try:
+            parameter = next(self.model.parameters())
+            device = parameter.device
+        except StopIteration:
+            device = images.device
+        images = images.to(device=device)
+
+        autocast = (
+            torch.autocast(device_type="cuda", dtype=torch.bfloat16)
+            if device.type == "cuda" and self.use_bf16
+            else nullcontext()
+        )
+        self.model.eval()
+        with torch.no_grad(), autocast:
+            output = self.model(images)
+
+        if "features" not in output or "patch_start_idx" not in output or "images" not in output:
+            raise KeyError("VGGT output must contain features, patch_start_idx, and images")
+        feature_stages = output["features"]
+        if not feature_stages:
+            raise ValueError("VGGT returned no feature stages")
+        aggregated = feature_stages[self.feature_layer]
+        patch_start_idx = int(output["patch_start_idx"])
+        tokens = aggregated[:, :, patch_start_idx:, :].detach()
+
+        image_height, image_width = output["images"].shape[-2:]
+        patch_size = int(getattr(self.model, "patch_size"))
+        source_grid = (image_height // patch_size, image_width // patch_size)
+        if source_grid[0] * source_grid[1] != tokens.shape[2]:
+            raise ValueError(
+                f"VGGT patch grid {source_grid} does not match {tokens.shape[2]} patch tokens"
+            )
+        if self.use_vggt_positional_embedding:
+            tokens = self._add_vggt_position_embedding(tokens, source_grid)
+        source_hw = tuple(source_grid for _ in range(tokens.shape[1]))
+        return VGGTTeacherOutput(tokens=tokens, source_hw=source_hw)
+
+    def forward_independent_views(
+        self,
+        batch_images: list[list[Any]],
+    ) -> VGGTTeacherOutput:
+        """Run every camera through VGGT as an independent one-view sample.
+
+        A fixed external camera and a moving wrist camera are not a calibrated
+        VGGT sequence in this project.  Flattening them into independent
+        one-view samples prevents cross-camera attention from injecting an
+        unverified geometric relation while retaining identical frozen-teacher
+        weights and per-view patch supervision.
+        """
+
+        if not batch_images or not batch_images[0]:
+            raise ValueError("batch_images must contain at least one sample and one view")
+        expected_views = len(batch_images[0])
+        if any(len(images) != expected_views for images in batch_images):
+            raise ValueError("Every sample must contain the same number of camera views")
+
+        flat_images = [[image] for images in batch_images for image in images]
+        flat_output = self.forward(flat_images)
+        batch_size = len(batch_images)
+        tokens = flat_output.tokens[:, 0].reshape(
+            batch_size,
+            expected_views,
+            flat_output.tokens.shape[2],
+            flat_output.tokens.shape[3],
+        )
+        source_hw = tuple(flat_output.source_hw[0] for _ in range(expected_views))
+        return VGGTTeacherOutput(tokens=tokens, source_hw=source_hw)
