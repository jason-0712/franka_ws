+# Copyright 2025 starVLA community. All rights reserved.
+# Licensed under the MIT License, Version 1.0 (the "License");
+"""QwenGR00T trained with a frozen VGGT Spatial-Forcing teacher.
+
+The teacher and alignment head are used only by :meth:`forward`.  Real-robot
+inference inherits the ordinary RGB-only QwenGR00T :meth:`predict_action`;
+only the learned LoRA student adapters and action head remain on the policy
+path.  This is deliberately different from ``QwenGR00TSpatial``, whose DAv2
+branch runs online during deployment.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import List, Mapping, Optional
+
+import numpy as np
+import torch
+
+from deployment.model_server.tools.image_tools import to_pil_preserve
+
+from starVLA.model.framework.share_tools import merge_framework_config
+from starVLA.model.framework.VLM4A.QwenGR00T import QwenGR00TDefaultConfig, Qwen_GR00T
+from starVLA.model.modules.spatial_forcing import (
+    FrozenVGGTTeacher,
+    PairedSpatialForcingAugment,
+    SpatialForcingCenterCrop,
+    SceneRelationalMemoryBank,
+    SpatialForcingAugmentConfig,
+    SpatialAlignmentHead,
+    extract_visual_tokens_by_view,
+    inject_qwen_lora,
+    qwen_visual_token_grids,
+    relational_geometry_loss,
+    remap_plain_checkpoint_for_lora,
+    resample_teacher_tokens_by_view,
+    select_qwen_merger_feature,
+    split_qwen_visual_features_by_view,
+    strip_spatial_teacher_state_dict,
+)
+from starVLA.model.tools import FRAMEWORK_REGISTRY
+
+
+@dataclass
+class QwenGR00TSpatialForcingDefaultConfig(QwenGR00TDefaultConfig):
+    """Defaults modeled after the official OpenVLA Spatial-Forcing recipe."""
+
+    name: str = "QwenGR00TSpatialForcing"
+    spatial_forcing: dict = field(
+        default_factory=lambda: {
+            "expected_num_views": 2,
+            "image_token": "<|image_pad|>",
+            "image_token_id_fallback": 151655,
+            # hidden_states includes the embedding output at index zero.  The
+            # official OpenVLA recipe aligns an intermediate layer (24).
+            "student_hidden_state_index": 24,
+            # ``llm_hidden`` preserves the original Phase-10 path.  The two
+            # visual alternatives are explicit ablations for Qwen3-VL:
+            # ``vision_encoder`` uses the last pre-merger patch tokens and
+            # ``vision_projector`` uses the post-merger image embeddings.
+            "student_feature_source": "llm_hidden",
+            "teacher_enabled": True,
+            "teacher_weight_path": "/data/hanyu/starVLA_checkpoints/vggt/model.pt",
+            "teacher_input_size": 518,
+            "teacher_feature_layer": -1,
+            "teacher_dim": 2048,
+            "teacher_use_bf16": True,
+            "teacher_use_positional_embedding": False,
+            "teacher_positional_embedding_ratio": 0.1,
+            # The uncalibrated static primary and moving wrist cameras are
+            # processed independently by default.  ``joint`` remains
+            # available solely for an explicit matched ablation.
+            "teacher_view_mode": "independent",
+            # ``projected_only`` is the clean, paper-faithful objective used
+            # by Phase 10.  ``hybrid`` retains compatibility with research
+            # checkpoints from the earlier relational ablations.
+            "objective": "hybrid",
+            "alignment_hidden_dim": 2048,
+            "alignment_use_student_norm": True,
+            # ``alignment_alpha`` remains as a legacy fallback so checkpoints
+            # and configs from phases 4--7 stay loadable without edits.
+            "alignment_alpha": 0.5,
+            "projected_alignment_alpha": None,
