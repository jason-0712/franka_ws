diff --git a/starVLA/model/modules/spatial/depth_anything_v2.py b/starVLA/model/modules/spatial/depth_anything_v2.py
new file mode 100644
index 0000000..5365db5
--- /dev/null
+++ b/starVLA/model/modules/spatial/depth_anything_v2.py
@@ -0,0 +1,163 @@
+"""Frozen Depth Anything V2 wrapper for dual-view geometry tokens.
+
+The wrapper deliberately exposes normalized depth plus image-plane coordinates
+instead of depending on internal Depth Anything hidden-state layouts.  This
+keeps the contract stable across compatible Hugging Face transformer versions:
+
+    nested PIL images -> [batch, view, grid_token, (depth, x, y)]
+
+Depth Anything remains frozen and in evaluation mode during VLA training.
+"""
+
+from __future__ import annotations
+
+from contextlib import nullcontext
+from typing import Any, Sequence
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+class FrozenDepthAnythingV2Encoder(nn.Module):
+    """Convert per-view RGB images into compact relative-depth geometry tokens."""
+
+    output_dim = 3  # normalized relative depth, normalized x, normalized y
+
+    def __init__(
+        self,
+        model_id: str = "depth-anything/Depth-Anything-V2-Small-hf",
+        grid_size: tuple[int, int] = (14, 14),
+        use_bf16: bool = True,
+        local_files_only: bool = False,
+        *,
+        depth_model: nn.Module | None = None,
+        image_processor: Any | None = None,
+    ) -> None:
+        super().__init__()
+        if len(grid_size) != 2 or min(grid_size) <= 0:
+            raise ValueError(f"grid_size must contain two positive integers, got {grid_size!r}")
+        if (depth_model is None) != (image_processor is None):
+            raise ValueError("depth_model and image_processor must either both be supplied or both be omitted")
+
+        if depth_model is None:
+            try:
+                from transformers import AutoImageProcessor, AutoModelForDepthEstimation
+            except ImportError as exc:  # pragma: no cover - exercised only in incomplete runtime environments
+                raise ImportError(
+                    "QwenGR00TSpatial requires a transformers build with "
+                    "AutoModelForDepthEstimation support"
+                ) from exc
+
+            image_processor = AutoImageProcessor.from_pretrained(
+                model_id,
+                local_files_only=local_files_only,
+            )
+            depth_model = AutoModelForDepthEstimation.from_pretrained(
+                model_id,
+                local_files_only=local_files_only,
+            )
+
+        self.model_id = model_id
+        self.grid_size = (int(grid_size[0]), int(grid_size[1]))
+        self.use_bf16 = bool(use_bf16)
+        self.image_processor = image_processor
+        self.depth_model = depth_model
+        self._freeze_backbone()
+
+    def _freeze_backbone(self) -> None:
+        self.depth_model.eval()
+        for parameter in self.depth_model.parameters():
+            parameter.requires_grad_(False)
+
+    def train(self, mode: bool = True) -> "FrozenDepthAnythingV2Encoder":
+        """Keep the frozen teacher in eval mode even when its parent trains."""
+
+        super().train(False)
+        self.depth_model.eval()
+        return self
+
+    def _device_and_dtype(self) -> tuple[torch.device, torch.dtype]:
+        first_tensor = next(self.depth_model.parameters(), None)
+        if first_tensor is None:
+            first_tensor = next(self.depth_model.buffers(), None)
+        if first_tensor is None:
+            return torch.device("cpu"), torch.float32
+        dtype = first_tensor.dtype if first_tensor.is_floating_point() else torch.float32
+        return first_tensor.device, dtype
+
+    @staticmethod
+    def _validate_and_flatten(batch_images: Sequence[Sequence[Any]]) -> tuple[list[Any], int, int]:
+        if not batch_images:
+            raise ValueError("Depth encoder received an empty image batch")
+        view_counts = [len(sample_images) for sample_images in batch_images]
+        if not view_counts[0] or any(count != view_counts[0] for count in view_counts):
+            raise ValueError(f"Every sample must contain the same non-zero number of views, got {view_counts}")
+        flat_images = [image for sample_images in batch_images for image in sample_images]
+        return flat_images, len(batch_images), view_counts[0]
+
+    @torch.no_grad()
+    def forward(self, batch_images: Sequence[Sequence[Any]]) -> tuple[torch.Tensor, torch.Tensor]:
+        """Return geometry tokens and their validity mask.
+
+        Args:
+            batch_images: ``B`` samples, each containing ``V`` PIL-compatible RGB images.
+
+        Returns:
+            geometry: ``[B, V, Gh*Gw, 3]`` float tensor.
+            valid_mask: ``[B, V, Gh*Gw]`` bool tensor.
+        """
+
+        flat_images, batch_size, num_views = self._validate_and_flatten(batch_images)
+        processed = self.image_processor(images=flat_images, return_tensors="pt")
+        if "pixel_values" not in processed:
+            raise KeyError("Depth Anything image processor did not return 'pixel_values'")
+
+        device, model_dtype = self._device_and_dtype()
+        pixel_values = processed["pixel_values"].to(device=device)
+        if pixel_values.is_floating_point():
+            pixel_values = pixel_values.to(dtype=model_dtype)
+
+        autocast_context = (
+            torch.autocast(device_type="cuda", dtype=torch.bfloat16)
+            if device.type == "cuda" and self.use_bf16
+            else nullcontext()
+        )
+        with autocast_context:
+            outputs = self.depth_model(pixel_values=pixel_values)
+
+        if not hasattr(outputs, "predicted_depth"):
+            raise AttributeError("Depth Anything output does not expose 'predicted_depth'")
+        depth = outputs.predicted_depth.float()
+        if depth.ndim == 3:
+            depth = depth.unsqueeze(1)
+        if depth.ndim != 4 or depth.shape[1] != 1:
+            raise ValueError(f"Expected predicted depth [N,H,W] or [N,1,H,W], got {tuple(depth.shape)}")
+
+        finite = torch.isfinite(depth)
+        depth = torch.nan_to_num(depth, nan=0.0, posinf=0.0, neginf=0.0).clamp_min_(0.0)
+        # Compress outliers before per-image standardization.  The model predicts
+        # relative depth, so retaining ordering is more useful than absolute scale.
+        depth = torch.log1p(depth)
+        depth = F.adaptive_avg_pool2d(depth, self.grid_size)
+        valid = F.adaptive_avg_pool2d(finite.float(), self.grid_size) >= 1.0
+
+        mean = depth.mean(dim=(-2, -1), keepdim=True)
+        std = depth.std(dim=(-2, -1), keepdim=True, unbiased=False).clamp_min_(1e-6)
+        depth = ((depth - mean) / std).clamp_(-5.0, 5.0)
+
+        grid_h, grid_w = self.grid_size
+        y = torch.linspace(-1.0, 1.0, grid_h, device=depth.device, dtype=depth.dtype)
+        x = torch.linspace(-1.0, 1.0, grid_w, device=depth.device, dtype=depth.dtype)
+        yy, xx = torch.meshgrid(y, x, indexing="ij")
+        xx = xx.expand(depth.shape[0], -1, -1)
+        yy = yy.expand(depth.shape[0], -1, -1)
+
+        geometry = torch.stack((depth[:, 0], xx, yy), dim=-1).reshape(
+            batch_size,
+            num_views,
+            grid_h * grid_w,
+            self.output_dim,
+        )
+        valid_mask = valid[:, 0].reshape(batch_size, num_views, grid_h * grid_w)
+        return geometry, valid_mask
diff --git a/starVLA/model/modules/spatial/gated_cross_attention.py b/starVLA/model/modules/spatial/gated_cross_attention.py
