index 0000000..8a9ba4f
--- /dev/null
+++ b/starVLA/model/modules/spatial/gated_cross_attention.py
@@ -0,0 +1,201 @@
+"""Lightweight, view-aware geometry fusion with exact zero-gate identity."""
+
+from __future__ import annotations
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+def find_image_token_spans(
+    input_ids: torch.Tensor,
+    image_token_id: int,
+    expected_num_views: int,
+) -> list[list[torch.Tensor]]:
+    """Locate the contiguous Qwen image-token block for every camera view.
+
+    Qwen represents each image as one contiguous run of ``<|image_pad|>``
+    tokens.  Splitting on non-consecutive indices preserves camera order and
+    avoids modifying instruction/language tokens.
+    """
+
+    if input_ids.ndim != 2:
+        raise ValueError(f"input_ids must have shape [B,L], got {tuple(input_ids.shape)}")
+    if expected_num_views <= 0:
+        raise ValueError("expected_num_views must be positive")
+
+    batch_spans: list[list[torch.Tensor]] = []
+    for sample_index in range(input_ids.shape[0]):
+        positions = torch.where(input_ids[sample_index] == image_token_id)[0]
+        if positions.numel() == 0:
+            raise ValueError(f"Sample {sample_index} contains no Qwen image tokens (id={image_token_id})")
+        split_points = torch.where(torch.diff(positions) > 1)[0] + 1
+        spans = list(torch.tensor_split(positions, split_points.cpu().tolist()))
+        if len(spans) != expected_num_views:
+            lengths = [int(span.numel()) for span in spans]
+            raise ValueError(
+                f"Sample {sample_index} exposes {len(spans)} image-token spans, expected "
+                f"{expected_num_views}; span lengths={lengths}"
+            )
+        batch_spans.append(spans)
+    return batch_spans
+
+
+class GeometryTokenProjector(nn.Module):
+    """Project compact depth/coordinate tokens and add camera identity."""
+
+    def __init__(
+        self,
+        input_dim: int,
+        geometry_dim: int,
+        num_views: int,
+        hidden_dim: int = 128,
+    ) -> None:
+        super().__init__()
+        if min(input_dim, geometry_dim, num_views, hidden_dim) <= 0:
+            raise ValueError("All projector dimensions must be positive")
+        self.num_views = int(num_views)
+        self.projector = nn.Sequential(
+            nn.Linear(input_dim, hidden_dim),
+            nn.GELU(),
+            nn.Linear(hidden_dim, geometry_dim),
+        )
+        self.camera_embedding = nn.Parameter(torch.zeros(num_views, geometry_dim))
+        nn.init.normal_(self.camera_embedding, mean=0.0, std=0.02)
+
+    def forward(self, geometry: torch.Tensor) -> torch.Tensor:
+        if geometry.ndim != 4:
+            raise ValueError(f"geometry must have shape [B,V,N,D], got {tuple(geometry.shape)}")
+        num_views = geometry.shape[1]
+        if num_views != self.num_views:
+            raise ValueError(f"Expected {self.num_views} geometry views, got {num_views}")
+        projected = self.projector(geometry)
+        camera_embedding = self.camera_embedding.to(dtype=projected.dtype)[None, :, None, :]
+        return projected + camera_embedding
+
+
+class GatedSpatialCrossAttention(nn.Module):
+    """Cross-attend RGB tokens to geometry through a bottleneck residual.
+
+    The residual gate is initialized to zero.  Consequently, before training,
+    this module is an exact identity map (bit-for-bit for finite inputs), which
+    lets a QwenGR00T checkpoint be loaded without perturbing its policy.
+    """
+
+    def __init__(
+        self,
+        rgb_dim: int,
+        geometry_dim: int = 256,
+        attention_dim: int = 256,
+        num_heads: int = 4,
+        num_views: int = 2,
+        dropout: float = 0.0,
+        gate_init: float = 0.0,
+    ) -> None:
+        super().__init__()
+        if attention_dim % num_heads:
+            raise ValueError("attention_dim must be divisible by num_heads")
+        if min(rgb_dim, geometry_dim, attention_dim, num_heads, num_views) <= 0:
+            raise ValueError("All attention dimensions must be positive")
+
+        self.attention_dim = int(attention_dim)
+        self.num_heads = int(num_heads)
+        self.head_dim = self.attention_dim // self.num_heads
+        self.num_views = int(num_views)
+
+        self.query_norm = nn.LayerNorm(rgb_dim)
+        self.geometry_norm = nn.LayerNorm(geometry_dim)
+        self.q_proj = nn.Linear(rgb_dim, attention_dim)
+        self.k_proj = nn.Linear(geometry_dim, attention_dim)
+        self.v_proj = nn.Linear(geometry_dim, attention_dim)
+        self.out_proj = nn.Linear(attention_dim, rgb_dim)
+        self.dropout = nn.Dropout(dropout)
+        self.gates = nn.Parameter(torch.full((num_views,), float(gate_init)))
+
+    def forward(
+        self,
+        rgb_tokens: torch.Tensor,
+        geometry_tokens: torch.Tensor,
+        geometry_mask: torch.Tensor | None = None,
+        *,
+        view_index: int,
+    ) -> torch.Tensor:
+        if rgb_tokens.ndim != 3 or geometry_tokens.ndim != 3:
+            raise ValueError("rgb_tokens and geometry_tokens must both have shape [B,N,D]")
+        if not 0 <= view_index < self.num_views:
+            raise IndexError(f"view_index={view_index} is outside [0, {self.num_views})")
+        if geometry_mask is not None:
+            if geometry_mask.shape != geometry_tokens.shape[:2]:
+                raise ValueError(
+                    f"geometry_mask shape {tuple(geometry_mask.shape)} does not match "
+                    f"geometry tokens {tuple(geometry_tokens.shape[:2])}"
+                )
+            if (~geometry_mask.bool()).all(dim=1).any():
+                raise ValueError("At least one sample has no valid geometry tokens")
+
+        batch_size, num_queries, _ = rgb_tokens.shape
+        q = self.q_proj(self.query_norm(rgb_tokens))
+        k = self.k_proj(self.geometry_norm(geometry_tokens))
+        v = self.v_proj(self.geometry_norm(geometry_tokens))
+
+        def split_heads(tensor: torch.Tensor) -> torch.Tensor:
+            return tensor.reshape(batch_size, -1, self.num_heads, self.head_dim).transpose(1, 2)
+
+        q = split_heads(q)
+        k = split_heads(k)
+        v = split_heads(v)
+        scores = torch.matmul(q, k.transpose(-2, -1)) * (self.head_dim**-0.5)
+        if geometry_mask is not None:
+            scores = scores.masked_fill(~geometry_mask[:, None, None, :].bool(), torch.finfo(scores.dtype).min)
+        weights = F.softmax(scores, dim=-1)
+        weights = self.dropout(weights)
+        update = torch.matmul(weights, v)
+        update = update.transpose(1, 2).reshape(batch_size, num_queries, self.attention_dim)
+        update = self.dropout(self.out_proj(update))
+
+        gate = torch.tanh(self.gates[view_index]).to(dtype=update.dtype)
+        return rgb_tokens + gate * update
+
+
+def fuse_visual_tokens_by_view(
+    last_hidden: torch.Tensor,
+    input_ids: torch.Tensor,
+    image_token_id: int,
+    geometry_tokens: torch.Tensor,
+    geometry_mask: torch.Tensor | None,
+    fuser: GatedSpatialCrossAttention,
+) -> torch.Tensor:
+    """Fuse each camera's visual span while leaving every other token untouched."""
+
+    if last_hidden.ndim != 3:
+        raise ValueError(f"last_hidden must have shape [B,L,H], got {tuple(last_hidden.shape)}")
+    if input_ids.shape != last_hidden.shape[:2]:
+        raise ValueError(
+            f"input_ids shape {tuple(input_ids.shape)} does not match hidden sequence {tuple(last_hidden.shape[:2])}"
+        )
+    if geometry_tokens.ndim != 4:
+        raise ValueError("geometry_tokens must have shape [B,V,N,D]")
+    if geometry_tokens.shape[:2] != (last_hidden.shape[0], fuser.num_views):
+        raise ValueError(
+            f"geometry batch/views {tuple(geometry_tokens.shape[:2])} do not match "
+            f"expected {(last_hidden.shape[0], fuser.num_views)}"
+        )
+    if geometry_mask is not None and geometry_mask.shape != geometry_tokens.shape[:3]:
+        raise ValueError("geometry_mask must have shape [B,V,N]")
+
+    spans_by_sample = find_image_token_spans(input_ids, image_token_id, fuser.num_views)
+    fused_samples: list[torch.Tensor] = []
+    for sample_index, spans in enumerate(spans_by_sample):
+        sample_hidden = last_hidden[sample_index]
+        for view_index, positions in enumerate(spans):
+            query = last_hidden[sample_index : sample_index + 1].index_select(1, positions)
+            valid = geometry_mask[sample_index : sample_index + 1, view_index] if geometry_mask is not None else None
+            fused_query = fuser(
+                query,
+                geometry_tokens[sample_index : sample_index + 1, view_index],
+                valid,
+                view_index=view_index,
+            )
+            sample_hidden = sample_hidden.index_copy(0, positions, fused_query[0])
+        fused_samples.append(sample_hidden)
+    return torch.stack(fused_samples, dim=0)
