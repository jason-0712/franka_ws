@@ -0,0 +1,129 @@
+"""LoRA helpers for the trainable Spatial-Forcing student.
+
+PEFT is imported lazily so ordinary QwenGR00T inference remains independent
+of the training-only adapter dependency.  The helpers also bridge baseline
+StarVLA checkpoints (plain Linear keys) to PEFT's injected ``base_layer``
+keys without altering any tensor values.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping
+from typing import Any
+
+import torch
+import torch.nn as nn
+
+
+DEFAULT_QWEN_LORA_TARGETS = ("q_proj", "k_proj", "v_proj", "o_proj")
+
+
+def inject_qwen_lora(
+    model: nn.Module,
+    *,
+    rank: int = 32,
+    alpha: int = 16,
+    dropout: float = 0.0,
+    target_modules: str | Iterable[str] = DEFAULT_QWEN_LORA_TARGETS,
+    adapter_name: str = "spatial_forcing",
+) -> nn.Module:
+    """Freeze a Qwen backbone and inject trainable, initially no-op LoRA.
+
+    ``inject_adapter_in_model`` keeps the original Transformers model class
+    and forward signature.  That matters for Qwen3-VL because the StarVLA
+    wrapper passes multimodal keyword arguments that a generic causal-LM
+    wrapper may not preserve.
+    """
+
+    if rank <= 0 or alpha <= 0:
+        raise ValueError("LoRA rank and alpha must be positive")
+    if not 0.0 <= dropout < 1.0:
+        raise ValueError("LoRA dropout must be in [0,1)")
+    if isinstance(target_modules, str):
+        targets: str | list[str] = target_modules
+    else:
+        targets = [str(value) for value in target_modules]
+    if not targets:
+        raise ValueError("At least one LoRA target module is required")
+    if isinstance(targets, str) and targets != "all-linear":
+        raise ValueError(
+            "A string LoRA target must be PEFT's special 'all-linear' value; "
+            "use a sequence for explicit module suffixes"
+        )
+
+    try:
+        from peft import LoraConfig, inject_adapter_in_model
+    except ImportError as exc:
+        raise ImportError(
+            "Spatial-Forcing student adaptation requires PEFT. Install the pinned "
+            "compatible package with `python -m pip install --no-deps peft==0.18.1`."
+        ) from exc
+
+    for parameter in model.parameters():
+        parameter.requires_grad_(False)
+
+    adapter_config = LoraConfig(
+        r=int(rank),
+        lora_alpha=int(alpha),
+        lora_dropout=float(dropout),
+        target_modules=targets,
+        bias="none",
+        # This is the initialization used by the official Spatial-Forcing
+        # recipe.  PEFT keeps LoRA-B at zero, so the adapter remains an exact
+        # no-op before optimization.
+        init_lora_weights="gaussian",
+    )
+    injected = inject_adapter_in_model(
+        adapter_config,
+        model,
+        adapter_name=adapter_name,
+    )
+    if injected is not None:
+        model = injected
+
+    trainable = [name for name, parameter in model.named_parameters() if parameter.requires_grad]
+    if not trainable:
+        raise RuntimeError("PEFT injected no trainable LoRA parameters into Qwen")
+    if any("lora_" not in name for name in trainable):
+        raise RuntimeError(
+            "Qwen contains trainable non-LoRA parameters after adapter injection: "
+            + ", ".join(name for name in trainable if "lora_" not in name)[:500]
+        )
+    return model
+
+
+def remap_plain_checkpoint_for_lora(
+    state_dict: Mapping[str, Any],
+    current_keys: Iterable[str],
+) -> dict[str, Any]:
+    """Map a plain StarVLA checkpoint onto an injected-LoRA module tree.
+
+    PEFT replaces (for example) ``q_proj.weight`` with
+    ``q_proj.base_layer.weight``.  All unrelated keys are retained exactly.
+    LoRA tensors are intentionally absent when loading a baseline checkpoint,
+    so they remain at their no-op initialization under ``strict=False``.
+    """
+
+    available = set(current_keys)
+    remapped: dict[str, Any] = {}
+    for key, value in state_dict.items():
+        destination = key
+        if key not in available:
+            prefix, separator, leaf = key.rpartition(".")
+            if separator and leaf in {"weight", "bias"}:
+                candidate = f"{prefix}.base_layer.{leaf}"
+                if candidate in available:
+                    destination = candidate
+        if destination in remapped:
+            raise ValueError(f"Checkpoint remapping produced duplicate key: {destination}")
+        remapped[destination] = value
+    return remapped
+
+
+def trainable_lora_parameter_names(model: nn.Module) -> tuple[str, ...]:
+    """Return the deterministic list used by tests and run audits."""
+
+    return tuple(
+        name for name, parameter in model.named_parameters()
+        if parameter.requires_grad and "lora_" in name
+    )
diff --git a/starVLA/model/modules/spatial_forcing/phase_a_audit.py b/starVLA/model/modules/spatial_forcing/phase_a_audit.py
new file mode 100644
index 0000000..4fe5380
--- /dev/null
+++ b/starVLA/model/modules/spatial_forcing/phase_a_audit.py
@@ -0,0 +1,226 @@
+"""Projection-leakage and patch-structure diagnostics for Spatial Forcing.
+
+These utilities deliberately operate on already-extracted, frozen student and
+teacher token grids.  They never run a robot policy and never backpropagate
+into the VLA.  The central diagnostic asks how much of the VGGT cosine loss a
+fresh projection head can remove while every student token is detached.
+"""
+
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+from typing import Iterable
+
+import torch
+from torch import nn
+import torch.nn.functional as F
+
+from .alignment import SpatialAlignmentHead
+
+
+@dataclass(frozen=True)
+class ProjectionLeakageResult:
+    """Summary of a frozen-feature projection-head fit."""
+
+    train_initial_loss: float
+    train_final_loss: float
+    eval_initial_loss: float
+    eval_final_loss: float
+    train_reduction_fraction: float
+    eval_reduction_fraction: float
+    steps: int
+    learning_rate: float
+
+    def to_dict(self) -> dict[str, float | int]:
+        return asdict(self)
+
+
+def token_cosine_loss_map(
+    student_tokens: torch.Tensor,
+    teacher_tokens: torch.Tensor,
+    *,
+    projector: nn.Module | None = None,
+    eps: float = 1e-6,
+) -> torch.Tensor:
+    """Return per-token cosine distance with shape ``[B,N]``.
+
+    ``projector`` may be a :class:`SpatialAlignmentHead`, an ordinary module,
+    or ``None`` when feature widths already match.  Teacher tokens are always
+    detached, and callers are expected to detach student tokens for leakage
+    experiments.
+    """
+
+    if student_tokens.ndim != 3 or teacher_tokens.ndim != 3:
+        raise ValueError("student_tokens and teacher_tokens must have shape [B,N,D]")
+    if student_tokens.shape[:2] != teacher_tokens.shape[:2]:
+        raise ValueError(
+            "student/teacher batch and token dimensions differ: "
+            f"{tuple(student_tokens.shape[:2])} vs {tuple(teacher_tokens.shape[:2])}"
+        )
+    if eps <= 0:
+        raise ValueError("eps must be positive")
+
+    if projector is None:
+        projected = student_tokens
+    elif hasattr(projector, "project"):
+        projected = projector.project(student_tokens)
+    else:
+        projected = projector(student_tokens)
+    if projected.shape != teacher_tokens.shape:
+        raise ValueError(
+            f"projected shape {tuple(projected.shape)} does not match teacher "
+            f"shape {tuple(teacher_tokens.shape)}"
+        )
+    student = F.normalize(projected.float(), dim=-1, eps=eps)
+    teacher = F.normalize(teacher_tokens.detach().float(), dim=-1, eps=eps)
+    return 1.0 - (student * teacher).sum(dim=-1)
+
+
+def _stack_token_batches(
+    batches: Iterable[tuple[torch.Tensor, torch.Tensor]],
+) -> tuple[torch.Tensor, torch.Tensor]:
+    students: list[torch.Tensor] = []
+    teachers: list[torch.Tensor] = []
+    for student, teacher in batches:
+        if student.ndim == 2:
+            student = student.unsqueeze(0)
+        if teacher.ndim == 2:
+            teacher = teacher.unsqueeze(0)
+        if student.ndim != 3 or teacher.ndim != 3:
+            raise ValueError("Every token batch must have shape [N,D] or [B,N,D]")
+        if student.shape[:2] != teacher.shape[:2]:
+            raise ValueError("Student and teacher token batches must share [B,N]")
+        students.append(student.detach())
+        teachers.append(teacher.detach())
+    if not students:
+        raise ValueError("At least one token batch is required")
+    token_counts = {int(value.shape[1]) for value in students}
+    if len(token_counts) != 1:
+        raise ValueError(f"All batches must use one token count, got {sorted(token_counts)}")
+    return torch.cat(students, dim=0), torch.cat(teachers, dim=0)
+
+
+def _fractional_reduction(initial: float, final: float, eps: float = 1e-12) -> float:
+    return (initial - final) / max(abs(initial), eps)
+
+
+def fit_frozen_projection_head(
+    train_batches: Iterable[tuple[torch.Tensor, torch.Tensor]],
+    eval_batches: Iterable[tuple[torch.Tensor, torch.Tensor]],
+    *,
+    steps: int = 200,
+    learning_rate: float = 1e-3,
+    hidden_dim: int | None = None,
+    use_student_norm: bool = True,
+    seed: int = 42,
+) -> tuple[SpatialAlignmentHead, ProjectionLeakageResult]:
+    """Fit only a fresh SF projection head on completely frozen tokens.
+
+    A large held-out loss reduction shows that alignment-loss reduction can be
+    explained by the projector alone.  It does *not* prove that the original
+    trained head memorized the samples; it is a warning that training alignment
+    loss is not evidence of a changed, action-useful backbone representation.
+    """
+
+    if steps <= 0:
+        raise ValueError("steps must be positive")
+    if learning_rate <= 0:
+        raise ValueError("learning_rate must be positive")
+    train_student, train_teacher = _stack_token_batches(train_batches)
+    eval_student, eval_teacher = _stack_token_batches(eval_batches)
+    if train_student.shape[-1] != eval_student.shape[-1]:
+        raise ValueError("Train/eval student feature widths differ")
+    if train_teacher.shape[-1] != eval_teacher.shape[-1]:
+        raise ValueError("Train/eval teacher feature widths differ")
+    if train_student.device != train_teacher.device:
+        raise ValueError("Train student and teacher tensors must use one device")
+    if eval_student.device != train_student.device or eval_teacher.device != train_student.device:
+        raise ValueError("Train and eval tensors must use one device")
+
+    devices = []
+    if train_student.is_cuda:
+        devices = [train_student.device.index or 0]
+    with torch.random.fork_rng(devices=devices):
+        torch.manual_seed(seed)
+        head = SpatialAlignmentHead(
+            student_dim=int(train_student.shape[-1]),
+            teacher_dim=int(train_teacher.shape[-1]),
+            hidden_dim=hidden_dim,
+            use_student_norm=use_student_norm,
+        ).to(device=train_student.device, dtype=train_student.dtype)
+
+    def loss_for(student: torch.Tensor, teacher: torch.Tensor) -> torch.Tensor:
+        return token_cosine_loss_map(student, teacher, projector=head).mean()
+
+    with torch.no_grad():
+        train_initial = float(loss_for(train_student, train_teacher).float().item())
+        eval_initial = float(loss_for(eval_student, eval_teacher).float().item())
+
+    optimizer = torch.optim.AdamW(head.parameters(), lr=learning_rate, weight_decay=0.0)
+    head.train()
+    for _ in range(steps):
+        optimizer.zero_grad(set_to_none=True)
+        loss = loss_for(train_student, train_teacher)
+        if not torch.isfinite(loss):
+            raise RuntimeError("Projection leakage fit produced a non-finite loss")
+        loss.backward()
+        optimizer.step()
+
+    head.eval()
+    with torch.no_grad():
+        train_final = float(loss_for(train_student, train_teacher).float().item())
+        eval_final = float(loss_for(eval_student, eval_teacher).float().item())
+    result = ProjectionLeakageResult(
+        train_initial_loss=train_initial,
+        train_final_loss=train_final,
+        eval_initial_loss=eval_initial,
+        eval_final_loss=eval_final,
+        train_reduction_fraction=_fractional_reduction(train_initial, train_final),
+        eval_reduction_fraction=_fractional_reduction(eval_initial, eval_final),
+        steps=steps,
+        learning_rate=learning_rate,
+    )
+    return head, result
+
+
+def patch_structure_error(
+    student_tokens: torch.Tensor,
+    teacher_tokens: torch.Tensor,
+    *,
+    eps: float = 1e-6,
+) -> torch.Tensor:
+    """Projection-free error between student and teacher patch Gram matrices."""
+
+    if student_tokens.ndim == 2:
+        student_tokens = student_tokens.unsqueeze(0)
+    if teacher_tokens.ndim == 2:
+        teacher_tokens = teacher_tokens.unsqueeze(0)
+    if student_tokens.ndim != 3 or teacher_tokens.ndim != 3:
+        raise ValueError("tokens must have shape [N,D] or [B,N,D]")
+    if student_tokens.shape[:2] != teacher_tokens.shape[:2]:
+        raise ValueError("student and teacher must share batch and token dimensions")
+    count = int(student_tokens.shape[1])
+    if count < 2:
+        raise ValueError("At least two patch tokens are required")
+    student = F.normalize(student_tokens.float(), dim=-1, eps=eps)
+    teacher = F.normalize(teacher_tokens.detach().float(), dim=-1, eps=eps)
+    student_gram = student @ student.transpose(-1, -2)
+    teacher_gram = teacher @ teacher.transpose(-1, -2)
+    off_diagonal = ~torch.eye(count, dtype=torch.bool, device=student.device)
+    return (student_gram - teacher_gram).square()[:, off_diagonal].mean()
+
+
+def loss_map_summary(loss_map: torch.Tensor) -> dict[str, float]:
+    """Return stable scalar summaries for a finite per-token loss map."""
+
+    values = loss_map.detach().float().flatten()
+    if values.numel() == 0 or not torch.isfinite(values).all():
+        raise ValueError("loss_map must contain finite values")
+    quantiles = torch.quantile(values, torch.tensor([0.5, 0.9, 0.99], device=values.device))
+    return {
+        "mean": float(values.mean().item()),
+        "median": float(quantiles[0].item()),
+        "p90": float(quantiles[1].item()),
+        "p99": float(quantiles[2].item()),
+        "max": float(values.max().item()),
+    }
diff --git a/starVLA/model/modules/spatial_forcing/representation_audit.py b/starVLA/model/modules/spatial_forcing/representation_audit.py
new file mode 100644
index 0000000..bca62d5
--- /dev/null
+++ b/starVLA/model/modules/spatial_forcing/representation_audit.py
@@ -0,0 +1,325 @@
+"""Projection-resistant metrics for auditing Spatial-Forcing representations.
+
+The training alignment loss is not, by itself, evidence that the VLA student
+has acquired a useful spatial representation: a trainable projection head can
+absorb most of that objective.  This module provides small, model-independent
+metrics that compare student and teacher token geometry without relying on the
+student's own alignment head.
+
+All functions operate on ordinary PyTorch tensors and are intentionally free
+of Qwen and VGGT imports so they remain CPU-unit-testable.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping, Sequence
+
+import torch
+import torch.nn.functional as F
+
+
+RecordKey = tuple[str, int]
+
+
+def _as_feature_matrix(name: str, value: torch.Tensor) -> torch.Tensor:
+    if value.ndim != 2:
+        raise ValueError(f"{name} must have shape [N,D], got {tuple(value.shape)}")
+    if min(value.shape) <= 0:
+        raise ValueError(f"{name} must be non-empty, got {tuple(value.shape)}")
+    if not torch.isfinite(value).all():
+        raise ValueError(f"{name} contains non-finite values")
+    return value.float()
+
+
+def pool_token_grid(
+    tokens: torch.Tensor,
+    source_hw: tuple[int, int],
+    output_hw: tuple[int, int] = (7, 7),
+) -> torch.Tensor:
+    """Spatially pool flattened image tokens while retaining their 2-D order."""
+
+    tokens = _as_feature_matrix("tokens", tokens)
+    if len(source_hw) != 2 or min(source_hw) <= 0:
+        raise ValueError(f"source_hw must contain two positive values, got {source_hw}")
+    if len(output_hw) != 2 or min(output_hw) <= 0:
+        raise ValueError(f"output_hw must contain two positive values, got {output_hw}")
+    if source_hw[0] * source_hw[1] != tokens.shape[0]:
+        raise ValueError(
+            f"source_hw={source_hw} contains {source_hw[0] * source_hw[1]} positions, "
+            f"but tokens contains {tokens.shape[0]}"
+        )
+
+    feature_map = tokens.transpose(0, 1).reshape(1, tokens.shape[1], *source_hw)
+    pooled = F.adaptive_avg_pool2d(feature_map, output_hw)
+    return pooled.flatten(2).transpose(1, 2).squeeze(0).contiguous()
+
+
+def linear_cka(
+    student: torch.Tensor,
+    teacher: torch.Tensor,
+    *,
+    eps: float = 1e-12,
+) -> torch.Tensor:
+    """Return linear centered-kernel alignment for two feature matrices.
+
+    The matrices must describe the same observations/tokens but may have
+    different feature widths.  CKA is invariant to isotropic scaling and
+    orthogonal feature rotations and therefore does not require a trainable
+    student-to-teacher projector.
+    """
+
+    student = _as_feature_matrix("student", student)
+    teacher = _as_feature_matrix("teacher", teacher)
+    if student.shape[0] != teacher.shape[0]:
+        raise ValueError(
+            f"student/teacher row counts differ: {student.shape[0]} vs {teacher.shape[0]}"
+        )
+    if student.shape[0] < 2:
+        raise ValueError("CKA requires at least two observations")
+    if eps <= 0:
+        raise ValueError("eps must be positive")
+
+    student = student - student.mean(dim=0, keepdim=True)
+    teacher = teacher - teacher.mean(dim=0, keepdim=True)
+    student_gram = student @ student.transpose(0, 1)
+    teacher_gram = teacher @ teacher.transpose(0, 1)
+    numerator = (student_gram * teacher_gram).sum()
+    denominator = torch.sqrt(
+        student_gram.square().sum() * teacher_gram.square().sum()
+    ).clamp_min(eps)
+    return (numerator / denominator).clamp(min=0.0, max=1.0)
+
+
+def cosine_distance_matrix(features: torch.Tensor, *, eps: float = 1e-8) -> torch.Tensor:
+    """Pairwise cosine distance for one vector per cube position."""
+
+    features = _as_feature_matrix("features", features)
+    normalized = F.normalize(features, dim=-1, eps=eps)
+    return (1.0 - normalized @ normalized.transpose(0, 1)).clamp_min(0.0)
+
+
+def upper_triangle_correlation(
+    first: torch.Tensor,
+    second: torch.Tensor,
+    *,
+    eps: float = 1e-12,
+) -> torch.Tensor:
+    """Pearson correlation between strict upper triangles of square matrices."""
+
+    if first.ndim != 2 or first.shape[0] != first.shape[1]:
+        raise ValueError(f"first must be square, got {tuple(first.shape)}")
+    if second.shape != first.shape:
+        raise ValueError(
+            f"second shape {tuple(second.shape)} does not match first {tuple(first.shape)}"
+        )
+    if first.shape[0] < 3:
+        raise ValueError("At least three positions are required for distance correlation")
+    indices = torch.triu_indices(first.shape[0], first.shape[1], offset=1)
+    first_values = first[indices[0], indices[1]].float()
+    second_values = second[indices[0], indices[1]].float()
+    first_values = first_values - first_values.mean()
+    second_values = second_values - second_values.mean()
+    denominator = (first_values.norm() * second_values.norm()).clamp_min(eps)
+    return (first_values @ second_values / denominator).clamp(min=-1.0, max=1.0)
+
+
+def position_distance_matrices(
+    student_records: Mapping[RecordKey, torch.Tensor],
+    teacher_records: Mapping[RecordKey, torch.Tensor],
+    labels: Sequence[str],
+    *,
+    num_views: int,
+) -> dict[str, dict[str, torch.Tensor]]:
+    """Return per-view cosine-distance matrices over labelled cube positions.
+
+    The matrices are the direct inputs to position RSA.  Exposing them makes
+    the audit inspectable: a heatmap can show *which* position relationships
+    disagree even when the scalar RSA score alone is ambiguous.
+    """
+
+    if len(labels) < 3:
+        raise ValueError("position_distance_matrices requires at least three labels")
+    if num_views <= 0:
+        raise ValueError("num_views must be positive")
+
+    matrices: dict[str, dict[str, torch.Tensor]] = {}
+    for view_index in range(num_views):
+        student_vectors = []
+        teacher_vectors = []
+        for label in labels:
+            key = (label, view_index)
+            if key not in student_records or key not in teacher_records:
+                raise KeyError(f"Missing position record: {key}")
+            student_vectors.append(
+                _as_feature_matrix(f"student[{key}]", student_records[key]).mean(dim=0)
+            )
+            teacher_vectors.append(
+                _as_feature_matrix(f"teacher[{key}]", teacher_records[key]).mean(dim=0)
+            )
+        matrices[f"view_{view_index}"] = {
+            "student": cosine_distance_matrix(torch.stack(student_vectors)),
+            "teacher": cosine_distance_matrix(torch.stack(teacher_vectors)),
+        }
+    return matrices
+
+
+def position_rsa(
+    student_records: Mapping[RecordKey, torch.Tensor],
+    teacher_records: Mapping[RecordKey, torch.Tensor],
+    labels: Sequence[str],
+    *,
+    num_views: int,
+) -> dict[str, float]:
+    """Compare cube-position distance geometry using representational similarity.
+
+    Tokens are mean-pooled per image.  For each camera, the pairwise cosine
+    distance matrix over positions is correlated between student and teacher.
+    """
+
+    matrices = position_distance_matrices(
+        student_records,
+        teacher_records,
+        labels,
+        num_views=num_views,
+    )
+    correlations: dict[str, float] = {}
+    for view_index, per_view in enumerate(matrices.values()):
+        correlations[f"view_{view_index}"] = float(
+            upper_triangle_correlation(
+                per_view["student"],
+                per_view["teacher"],
+            ).item()
+        )
+    correlations["mean"] = sum(correlations.values()) / num_views
+    return correlations
+
+
+def direction_opposition_scores(
+    records: Mapping[RecordKey, torch.Tensor],
+    *,
+    center_label: str,
+    opposite_pairs: Mapping[str, tuple[str, str]],
+    num_views: int,
+    eps: float = 1e-8,
+) -> dict[str, float]:
+    """Measure whether opposite physical moves create opposite feature deltas.
+
+    A score of +1 means the two displacement vectors are exactly opposite,
+    zero means orthogonal, and -1 means they point in the same direction.
+    """
+
+    scores: dict[str, float] = {}
+    for pair_name, (first_label, second_label) in opposite_pairs.items():
+        per_view = []
+        for view_index in range(num_views):
+            center = _as_feature_matrix(
+                f"records[{center_label},{view_index}]",
+                records[(center_label, view_index)],
+            ).mean(dim=0)
+            first = _as_feature_matrix(
+                f"records[{first_label},{view_index}]",
+                records[(first_label, view_index)],
+            ).mean(dim=0)
+            second = _as_feature_matrix(
+                f"records[{second_label},{view_index}]",
+                records[(second_label, view_index)],
+            ).mean(dim=0)
+            first_delta = first - center
+            second_delta = second - center
+            if first_delta.norm() <= eps or second_delta.norm() <= eps:
+                value = 0.0
+            else:
+                value = -float(
+                    F.cosine_similarity(first_delta[None], second_delta[None], dim=-1).item()
+                )
+            per_view.append(value)
+            scores[f"{pair_name}_view_{view_index}"] = value
+        scores[f"{pair_name}_mean"] = sum(per_view) / num_views
+    return scores
+
+
+@dataclass(frozen=True)
+class DualRidgeProbe:
+    """A fitted linear ridge probe represented in dual form."""
+
+    train_features: torch.Tensor
+    dual_weights: torch.Tensor
+    feature_mean: torch.Tensor
+    target_mean: torch.Tensor
+
+    def predict(self, features: torch.Tensor) -> torch.Tensor:
+        features = _as_feature_matrix("features", features).to(
+            device=self.train_features.device,
+            dtype=self.train_features.dtype,
+        )
+        centered = features - self.feature_mean
+        return centered @ self.train_features.transpose(0, 1) @ self.dual_weights + self.target_mean
+
+
+def fit_dual_ridge_probe(
+    features: torch.Tensor,
+    targets: torch.Tensor,
+    *,
+    ridge: float = 1e-2,
+) -> DualRidgeProbe:
+    """Fit one linear probe without constructing a large D-by-D matrix."""
+
+    features = _as_feature_matrix("features", features)
+    targets = _as_feature_matrix("targets", targets).to(features.device)
+    if features.shape[0] != targets.shape[0]:
+        raise ValueError(
+            f"features/targets row counts differ: {features.shape[0]} vs {targets.shape[0]}"
+        )
+    if ridge <= 0:
+        raise ValueError("ridge must be positive")
+
+    feature_mean = features.mean(dim=0, keepdim=True)
+    target_mean = targets.mean(dim=0, keepdim=True)
+    centered_features = features - feature_mean
+    centered_targets = targets - target_mean
+    gram = centered_features @ centered_features.transpose(0, 1)
+    scale = gram.diagonal().mean().clamp_min(1e-8)
+    regularized = gram + (ridge * scale) * torch.eye(
+        gram.shape[0], device=gram.device, dtype=gram.dtype
+    )
+    dual_weights = torch.linalg.solve(regularized, centered_targets)
+    return DualRidgeProbe(
+        train_features=centered_features,
+        dual_weights=dual_weights,
+        feature_mean=feature_mean,
+        target_mean=target_mean,
+    )
+
+
+def cosine_prediction_loss(prediction: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
+    prediction = _as_feature_matrix("prediction", prediction)
+    target = _as_feature_matrix("target", target).to(prediction.device)
+    if prediction.shape != target.shape:
+        raise ValueError(
+            f"prediction shape {tuple(prediction.shape)} does not match target {tuple(target.shape)}"
+        )
+    return (
+        1.0
+        - F.cosine_similarity(prediction, target, dim=-1, eps=1e-8)
+    ).mean()
+
+
+def collect_pooled_records(
+    records: Mapping[RecordKey, torch.Tensor],
+    grids: Mapping[RecordKey, tuple[int, int]],
+    labels: Sequence[str],
+    *,
+    num_views: int,
+    output_hw: tuple[int, int] = (7, 7),
+) -> torch.Tensor:
+    """Concatenate spatially pooled records in deterministic label/view order."""
+
+    pooled = []
+    for label in labels:
+        for view_index in range(num_views):
+            key = (label, view_index)
+            if key not in records or key not in grids:
+                raise KeyError(f"Missing record or grid: {key}")
+            pooled.append(pool_token_grid(records[key], grids[key], output_hw))
+    return torch.cat(pooled, dim=0)
