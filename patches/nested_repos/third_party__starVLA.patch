@@ -0,0 +1,64 @@
+"""CPU tests for the Spatial-Forcing Phase-A diagnostics."""
+
+import unittest
+
+import torch
+
+from starVLA.model.modules.spatial_forcing.phase_a_audit import (
+    fit_frozen_projection_head,
+    loss_map_summary,
+    patch_structure_error,
+    token_cosine_loss_map,
+)
+
+
+class SpatialForcingPhaseAAuditTest(unittest.TestCase):
+    def test_token_cosine_loss_map_is_zero_for_matching_features(self):
+        tokens = torch.randn(2, 7, 5)
+        loss_map = token_cosine_loss_map(tokens, 3.0 * tokens)
+        self.assertEqual(tuple(loss_map.shape), (2, 7))
+        self.assertTrue(torch.allclose(loss_map, torch.zeros_like(loss_map), atol=1e-6))
+
+    def test_patch_structure_error_ignores_feature_rotation(self):
+        generator = torch.Generator().manual_seed(9)
+        student = torch.randn(2, 8, 6, generator=generator)
+        rotation, _ = torch.linalg.qr(torch.randn(6, 6, generator=generator))
+        teacher = student @ rotation
+        unrelated = torch.randn(2, 8, 6, generator=generator)
+        self.assertLess(float(patch_structure_error(student, teacher)), 1e-10)
+        self.assertGreater(float(patch_structure_error(student, unrelated)), 0.05)
+
+    def test_frozen_projection_head_reduces_held_out_loss(self):
+        generator = torch.Generator().manual_seed(17)
+        mapping = torch.randn(4, 6, generator=generator)
+
+        def make_batch():
+            student = torch.randn(1, 12, 4, generator=generator)
+            teacher = student @ mapping + 0.01 * torch.randn(
+                1, 12, 6, generator=generator
+            )
+            return student, teacher
+
+        train_batches = [make_batch() for _ in range(6)]
+        eval_batches = [make_batch() for _ in range(3)]
+        _, result = fit_frozen_projection_head(
+            train_batches,
+            eval_batches,
+            steps=250,
+            learning_rate=3e-3,
+            hidden_dim=16,
+            seed=23,
+        )
+        self.assertGreater(result.train_reduction_fraction, 0.8)
+        self.assertGreater(result.eval_reduction_fraction, 0.7)
+        self.assertLess(result.eval_final_loss, result.eval_initial_loss)
+
+    def test_loss_map_summary(self):
+        summary = loss_map_summary(torch.tensor([[0.0, 1.0], [2.0, 3.0]]))
+        self.assertEqual(summary["mean"], 1.5)
+        self.assertEqual(summary["median"], 1.5)
+        self.assertEqual(summary["max"], 3.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_spatial_forcing_representation_audit.py b/tests/test_spatial_forcing_representation_audit.py
new file mode 100644
index 0000000..a999edd
--- /dev/null
+++ b/tests/test_spatial_forcing_representation_audit.py
@@ -0,0 +1,117 @@
+"""CPU tests for projection-resistant Spatial-Forcing audit metrics."""
+
+import unittest
+
+import torch
+
+from starVLA.model.modules.spatial_forcing.representation_audit import (
+    collect_pooled_records,
+    cosine_prediction_loss,
+    direction_opposition_scores,
+    fit_dual_ridge_probe,
+    linear_cka,
+    pool_token_grid,
+    position_distance_matrices,
+    position_rsa,
+)
+
+
+class SpatialForcingRepresentationAuditTest(unittest.TestCase):
+    def test_pool_token_grid_preserves_shape_and_constant_values(self):
+        tokens = torch.full((4 * 6, 3), 2.5)
+        pooled = pool_token_grid(tokens, (4, 6), (2, 3))
+        self.assertEqual(tuple(pooled.shape), (6, 3))
+        self.assertTrue(torch.allclose(pooled, torch.full_like(pooled, 2.5)))
+
+    def test_linear_cka_is_one_under_orthogonal_feature_rotation(self):
+        generator = torch.Generator().manual_seed(7)
+        features = torch.randn(40, 8, generator=generator)
+        orthogonal, _ = torch.linalg.qr(torch.randn(8, 8, generator=generator))
+        rotated = features @ orthogonal
+        unrelated = torch.randn(40, 8, generator=generator)
+        self.assertAlmostEqual(float(linear_cka(features, rotated)), 1.0, places=5)
+        self.assertLess(float(linear_cka(features, unrelated)), 0.7)
+
+    def test_position_rsa_detects_matching_distance_geometry(self):
+        labels = ["center", "front", "back", "left", "right"]
+        vectors = {
+            "center": torch.tensor([1.0, 0.0, 0.0]),
+            "front": torch.tensor([1.0, 1.0, 0.0]),
+            "back": torch.tensor([1.0, -1.0, 0.0]),
+            "left": torch.tensor([1.0, 0.0, 1.0]),
+            "right": torch.tensor([1.0, 0.0, -1.0]),
+        }
+        student = {}
+        teacher = {}
+        for label in labels:
+            for view in range(2):
+                value = vectors[label] + torch.tensor([0.0, 0.1 * view, 0.0])
+                student[(label, view)] = value.repeat(4, 1)
+                teacher[(label, view)] = (2.0 * value).repeat(4, 1)
+        result = position_rsa(student, teacher, labels, num_views=2)
+        self.assertAlmostEqual(result["mean"], 1.0, places=5)
+
+        matrices = position_distance_matrices(
+            student, teacher, labels, num_views=2
+        )
+        self.assertEqual(set(matrices), {"view_0", "view_1"})
+        for per_view in matrices.values():
+            self.assertEqual(tuple(per_view["student"].shape), (5, 5))
+            self.assertTrue(
+                torch.allclose(per_view["student"], per_view["teacher"], atol=1e-6)
+            )
+            self.assertTrue(
+                torch.allclose(
+                    torch.diagonal(per_view["student"]),
+                    torch.zeros(5),
+                    atol=1e-6,
+                )
+            )
+
+    def test_direction_opposition_reports_opposite_deltas(self):
+        records = {}
+        values = {
+            "center": torch.tensor([0.0, 0.0]),
+            "front": torch.tensor([1.0, 0.0]),
+            "back": torch.tensor([-1.0, 0.0]),
+            "left": torch.tensor([0.0, 1.0]),
+            "right": torch.tensor([0.0, -1.0]),
+        }
+        for label, value in values.items():
+            records[(label, 0)] = value.repeat(3, 1)
+        scores = direction_opposition_scores(
+            records,
+            center_label="center",
+            opposite_pairs={"front_back": ("front", "back"), "left_right": ("left", "right")},
+            num_views=1,
+        )
+        self.assertAlmostEqual(scores["front_back_mean"], 1.0, places=6)
+        self.assertAlmostEqual(scores["left_right_mean"], 1.0, places=6)
+
+    def test_dual_ridge_probe_generalizes_a_linear_mapping(self):
+        generator = torch.Generator().manual_seed(13)
+        mapping = torch.randn(6, 4, generator=generator)
+        train_x = torch.randn(80, 6, generator=generator)
+        train_y = train_x @ mapping + 0.01 * torch.randn(80, 4, generator=generator)
+        eval_x = torch.randn(20, 6, generator=generator)
+        eval_y = eval_x @ mapping
+        probe = fit_dual_ridge_probe(train_x, train_y, ridge=1e-4)
+        loss = cosine_prediction_loss(probe.predict(eval_x), eval_y)
+        self.assertLess(float(loss), 1e-3)
+
+    def test_collect_pooled_records_uses_label_then_view_order(self):
+        records = {
+            ("a", 0): torch.ones(4, 1),
+            ("a", 1): 2.0 * torch.ones(4, 1),
+            ("b", 0): 3.0 * torch.ones(4, 1),
+            ("b", 1): 4.0 * torch.ones(4, 1),
+        }
+        grids = {key: (2, 2) for key in records}
+        pooled = collect_pooled_records(
+            records, grids, ["a", "b"], num_views=2, output_hw=(1, 1)
+        )
+        self.assertEqual(pooled[:, 0].tolist(), [1.0, 2.0, 3.0, 4.0])
+
+
+if __name__ == "__main__":
+    unittest.main()
