+"""CPU tests for the QwenGR00TSpatial geometry branch.
+
+These tests use a tiny fake depth model and never download Qwen or Depth
+Anything weights.
+"""
+
+from types import SimpleNamespace
+import unittest
+
+import torch
+import torch.nn as nn
+
+from starVLA.model.modules.spatial import (
+    FrozenDepthAnythingV2Encoder,
+    GatedSpatialCrossAttention,
+    GeometryTokenProjector,
+    find_image_token_spans,
+    fuse_visual_tokens_by_view,
+)
+
+
+class _FakeDepthProcessor:
+    def __call__(self, images, return_tensors):
+        assert return_tensors == "pt"
+        return {"pixel_values": torch.arange(len(images) * 3 * 8 * 8, dtype=torch.float32).reshape(len(images), 3, 8, 8)}
+
+
+class _FakeDepthModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.scale = nn.Parameter(torch.tensor(0.5))
+
+    def forward(self, pixel_values):
+        depth = pixel_values.mean(dim=1) * self.scale
+        return SimpleNamespace(predicted_depth=depth)
+
+
+class QwenGR00TSpatialTest(unittest.TestCase):
+    def test_image_spans_preserve_two_view_order(self):
+        input_ids = torch.tensor(
+            [
+                [0, 10, 99, 99, 11, 20, 99, 99, 99, 21, 30],
+                [0, 99, 99, 1, 99, 99, 2, 3, 4, 5, 6],
+            ]
+        )
+        spans = find_image_token_spans(input_ids, image_token_id=99, expected_num_views=2)
+        self.assertEqual([span.tolist() for span in spans[0]], [[2, 3], [6, 7, 8]])
+        self.assertEqual([span.tolist() for span in spans[1]], [[1, 2], [4, 5]])
+
+    def test_zero_gate_is_exact_full_sequence_identity(self):
+        torch.manual_seed(7)
+        hidden = torch.randn(2, 12, 16, requires_grad=True)
+        input_ids = torch.tensor(
+            [
+                [0, 99, 99, 1, 2, 99, 99, 99, 3, 4, 5, 6],
+                [0, 1, 99, 99, 2, 3, 99, 99, 4, 5, 6, 7],
+            ]
+        )
+        geometry = torch.randn(2, 2, 9, 8)
+        geometry_mask = torch.ones(2, 2, 9, dtype=torch.bool)
+        fuser = GatedSpatialCrossAttention(
+            rgb_dim=16,
+            geometry_dim=8,
+            attention_dim=8,
+            num_heads=2,
+            num_views=2,
+            dropout=0.0,
+            gate_init=0.0,
+        )
+
+        output = fuse_visual_tokens_by_view(
+            hidden,
+            input_ids,
+            image_token_id=99,
+            geometry_tokens=geometry,
+            geometry_mask=geometry_mask,
+            fuser=fuser,
+        )
+        self.assertTrue(torch.equal(output, hidden))
+
+        output.sum().backward()
+        self.assertIsNotNone(fuser.gates.grad)
+        self.assertTrue(torch.isfinite(fuser.gates.grad).all())
+        self.assertGreater(float(fuser.gates.grad.abs().sum()), 0.0)
+
+    def test_nonzero_gate_updates_only_visual_tokens_and_connector_gets_gradients(self):
+        torch.manual_seed(11)
+        hidden = torch.randn(1, 10, 16, requires_grad=True)
+        input_ids = torch.tensor([[7, 99, 99, 8, 9, 99, 99, 99, 10, 11]])
+        raw_geometry = torch.randn(1, 2, 9, 3)
+        projector = GeometryTokenProjector(input_dim=3, geometry_dim=8, num_views=2, hidden_dim=6)
+        fuser = GatedSpatialCrossAttention(
+            rgb_dim=16,
+            geometry_dim=8,
+            attention_dim=8,
+            num_heads=2,
+            num_views=2,
+            gate_init=0.2,
+        )
+        geometry = projector(raw_geometry)
+        output = fuse_visual_tokens_by_view(
+            hidden,
+            input_ids,
+            image_token_id=99,
+            geometry_tokens=geometry,
+            geometry_mask=torch.ones(1, 2, 9, dtype=torch.bool),
+            fuser=fuser,
+        )
+
+        language_mask = input_ids != 99
+        self.assertTrue(torch.equal(output[language_mask], hidden[language_mask]))
+        self.assertFalse(torch.equal(output[~language_mask], hidden[~language_mask]))
+
+        output.square().mean().backward()
+        self.assertIsNotNone(projector.projector[0].weight.grad)
+        self.assertGreater(float(projector.projector[0].weight.grad.abs().sum()), 0.0)
+        self.assertIsNotNone(fuser.q_proj.weight.grad)
+        self.assertGreater(float(fuser.q_proj.weight.grad.abs().sum()), 0.0)
+
+    def test_depth_encoder_is_frozen_and_returns_dual_view_tokens(self):
+        fake_model = _FakeDepthModel()
+        encoder = FrozenDepthAnythingV2Encoder(
+            grid_size=(4, 5),
