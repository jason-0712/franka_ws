+    def _teacher_output(self, batch_images: list[list]):
+        if self.teacher_view_mode == "independent":
+            return self.spatial_teacher.forward_independent_views(batch_images)
+        return self.spatial_teacher(batch_images)
+
+    def predict_action(self, examples: List[dict], **kwargs) -> dict:
+        """Run RGB-only inference with an optional train-matched centre crop."""
+
+        input_examples = examples if isinstance(examples, list) else [examples]
+        if not self.inference_center_crop_enabled:
+            return super().predict_action(input_examples, **kwargs)
+
+        batch_images = [
+            to_pil_preserve(example["image"])
+            for example in input_examples
+        ]
+        cropped_images = self.inference_center_crop(batch_images)
+        cropped_examples = []
+        for example, images in zip(input_examples, cropped_images):
+            copied = dict(example)
+            copied["image"] = images
+            cropped_examples.append(copied)
+        return super().predict_action(cropped_examples, **kwargs)
+
+    def _alignment_losses(
+        self,
+        *,
+        batch_images: list[list],
+        qwen_inputs: Mapping[str, torch.Tensor],
+        hidden_states: tuple[torch.Tensor, ...],
+        captured_visual_tokens: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, int]:
+        if self.spatial_teacher is None:
+            raise RuntimeError(
+                "Spatial-Forcing training forward requires teacher_enabled=true. "
+                "teacher_enabled=false is only for RGB-only policy inference."
+            )
+        view_counts = [len(images) for images in batch_images]
+        if any(count != self.expected_num_views for count in view_counts):
+            raise ValueError(
+                f"Expected {self.expected_num_views} ordered camera views per sample, got {view_counts}"
+            )
+
+        student_views, target_hw = self._student_views(
+            qwen_inputs=qwen_inputs,
+            hidden_states=hidden_states,
+            captured_visual_tokens=captured_visual_tokens,
+            batch_size=len(batch_images),
+        )
+        student_reference = student_views[0]
+        teacher_output = self._teacher_output(batch_images)
+        teacher_tokens = teacher_output.tokens.to(
+            device=student_reference.device,
+            dtype=student_reference.dtype,
+        )
+        teacher_views = resample_teacher_tokens_by_view(
+            teacher_tokens,
+            source_hw=teacher_output.source_hw,
+            target_hw=target_hw,
+            mode=self.alignment_interpolation,
+        )
+        projected_losses = [
+            self.alignment_head(student, teacher)
+            for student, teacher in zip(student_views, teacher_views)
+        ]
+        # Concatenating camera tokens makes the projection-free objective
+        # preserve both within-view structure and cross-view relationships
+        # learned by the joint VGGT teacher.
+        if self.spatial_forcing_objective == "projected_only":
+            # The clean reproduction deliberately contains no relational or
+            # memory-bank objective.  Avoiding even their forward computation
+            # keeps control and treatment faithful to the official method.
+            relational_loss = projected_losses[0].new_zeros(())
+            scene_relational_loss = projected_losses[0].new_zeros(())
+            scene_queue_fill = 0
+        else:
+            relational_loss = relational_geometry_loss(
+                torch.cat(student_views, dim=1),
+                torch.cat(teacher_views, dim=1),
+            )
+            scene_relational_loss, scene_queue_fill = self.scene_memory(
+                student_views,
+                teacher_views,
+            )
+        return (
+            torch.stack(projected_losses).mean(),
+            relational_loss,
+            scene_relational_loss,
+            scene_queue_fill,
+        )
+
+    def forward(self, examples: List[dict] = None, **kwargs) -> dict[str, torch.Tensor]:
+        batch_images = [example["image"] for example in examples]
+        if self.training and self.image_augmentation_enabled:
+            # Materialize once, then reuse this exact augmented observation in
+            # both Qwen input construction and the VGGT teacher below.
+            batch_images = self.paired_image_augmentation(batch_images)
+        instructions = [example["lang"] for example in examples]
+        actions = [example["action"] for example in examples]
+        state = [example["state"] for example in examples] if "state" in examples[0] else None
+
+        qwen_inputs = self.qwen_vl_interface.build_qwenvl_inputs(
+            images=batch_images,
+            instructions=instructions,
+        )
+        backbone_attention_mask = qwen_inputs.get("attention_mask", None)
+        captured_visual: dict[str, torch.Tensor] = {}
+        visual_hook = None
+        if self.student_feature_source != "llm_hidden":
+            captured_visual, visual_hook = self._capture_qwen_visual_features()
+        try:
+            with torch.autocast("cuda", dtype=torch.bfloat16):
+                qwenvl_outputs = self.qwen_vl_interface(
+                    **qwen_inputs,
+                    output_attentions=False,
+                    output_hidden_states=True,
+                    return_dict=True,
+                )
+        finally:
+            if visual_hook is not None:
+                visual_hook.remove()
+        with torch.autocast("cuda", dtype=torch.bfloat16):
+            hidden_states = qwenvl_outputs.hidden_states
+            last_hidden = hidden_states[-1]
+            (
+                projected_alignment_loss,
+                relational_alignment_loss,
+                scene_relational_loss,
+                scene_queue_fill,
+            ) = self._alignment_losses(
+                batch_images=batch_images,
+                qwen_inputs=qwen_inputs,
+                hidden_states=hidden_states,
+                captured_visual_tokens=captured_visual.get("tokens"),
+            )
+
+        with torch.autocast("cuda", dtype=torch.float32):
+            actions_tensor = torch.tensor(
+                np.array(actions),
+                device=last_hidden.device,
+                dtype=last_hidden.dtype,
+            )
+            actions_target = actions_tensor[:, -self.action_horizon :, :]
+            repeated_steps = int(
+                self.config.framework.action_model.get("repeated_diffusion_steps", 4)
+            )
+            actions_target = actions_target.repeat(repeated_steps, 1, 1)
+            action_hidden = last_hidden.repeat(repeated_steps, 1, 1)
+            repeated_mask = None
+            if backbone_attention_mask is not None:
+                repeated_mask = backbone_attention_mask.repeat(repeated_steps, 1).to(dtype=torch.bool)
+            repeated_state = None
+            if state is not None:
+                state_tensor = torch.tensor(
+                    np.array(state),
+                    device=last_hidden.device,
+                    dtype=last_hidden.dtype,
+                )
+                repeated_state = state_tensor.repeat(repeated_steps, 1, 1)
+            action_loss = self.action_model(
+                action_hidden,
+                actions_target,
+                repeated_state,
+                encoder_attention_mask=repeated_mask,
+            )
+
+        weighted_projected_alignment_loss = (
+            self.projected_alignment_alpha * projected_alignment_loss
+        )
+        weighted_relational_alignment_loss = (
+            self.relational_alignment_alpha * relational_alignment_loss
+        )
+        weighted_scene_relational_loss = (
+            self.scene_relational_alpha * scene_relational_loss
+        )
+        total_spatial_alignment_loss = (
+            weighted_projected_alignment_loss
+            + weighted_relational_alignment_loss
+            + weighted_scene_relational_loss
+        )
+        total_loss = action_loss + total_spatial_alignment_loss
+        return {
+            "action_loss": action_loss,
+            # Legacy aliases retain their phase-4--7 meaning.
+            "alignment_loss": projected_alignment_loss,
+            "weighted_alignment_loss": weighted_projected_alignment_loss,
+            "projected_alignment_loss": projected_alignment_loss,
+            "relational_alignment_loss": relational_alignment_loss,
+            "weighted_projected_alignment_loss": weighted_projected_alignment_loss,
+            "weighted_relational_alignment_loss": weighted_relational_alignment_loss,
+            "scene_relational_loss": scene_relational_loss,
+            "weighted_scene_relational_loss": weighted_scene_relational_loss,
+            "scene_queue_fill": scene_relational_loss.new_tensor(float(scene_queue_fill)),
+            "total_spatial_alignment_loss": total_spatial_alignment_loss,
+            "total_loss": total_loss,
+        }
+
+    def _spatial_forcing_probe_parameters(self) -> dict[str, torch.Tensor]:
+        """Select small, deterministic tensors for ZeRO-safe update audits."""
+
+        lora_b = next(
+            (
+                parameter
+                for name, parameter in self.qwen_vl_interface.model.named_parameters()
+                if "lora_B" in name and parameter.requires_grad
+            ),
+            None,
+        )
+        if lora_b is None:
+            raise RuntimeError("No trainable Spatial-Forcing LoRA-B parameter was found")
+        return {
+            "spatial_forcing_lora_B": lora_b,
+            "alignment_head": self.alignment_head.fc2.weight,
+        }
+
+    def capture_spatial_forcing_parameter_snapshot(self) -> dict[str, torch.Tensor]:
+        """Clone two probes before the optimizer step.
+
+        DeepSpeed ZeRO-2 may clear or partition ``parameter.grad`` before the
+        trainer can inspect it, yielding misleading zero gradient norms.  A
+        before/after parameter delta directly verifies that the optimizer
+        updated each trainable path and remains valid under ZeRO-2.
+        """
+
+        return {
+            name: parameter.detach().reshape(-1)[:4096].float().clone()
+            for name, parameter in self._spatial_forcing_probe_parameters().items()
+        }
+
+    def spatial_forcing_parameter_update_metrics(
+        self,
+        snapshot: Mapping[str, torch.Tensor],
+    ) -> dict[str, float]:
+        probes = self._spatial_forcing_probe_parameters()
+        metrics: dict[str, float] = {}
+        for name, parameter in probes.items():
+            before = snapshot[name].to(device=parameter.device)
+            current = parameter.detach().reshape(-1)[: before.numel()].float()
+            metrics[f"parameter_update_norm/{name}"] = float((current - before).norm().item())
+            metrics[f"parameter_norm/{name}"] = float(current.norm().item())
+        return metrics
+
+    def load_state_dict(self, state_dict, strict: bool = True, assign: bool = False):
+        """Accept checkpoints with or without the external VGGT teacher.
+
+        DeepSpeed has produced both formats across Spatial-Forcing phases.
+        VGGT is always reconstructed from ``teacher_weight_path`` for
+        training and is absent for RGB-only inference, so serialized teacher
+        tensors and teacher-only incompatibilities are intentionally ignored.
+        Every non-teacher key remains strictly validated.
+        """
+
+        current_keys = [name for name, _ in self.named_parameters()]
+        current_keys.extend(name for name, _ in self.named_buffers())
+        compatible = remap_plain_checkpoint_for_lora(state_dict, current_keys)
+        compatible = strip_spatial_teacher_state_dict(compatible)
+        incompatible = super().load_state_dict(compatible, strict=False, assign=assign)
+
+        def is_teacher_key(key: str) -> bool:
+            return key.startswith("spatial_teacher.") or ".spatial_teacher." in key
+
+        missing_keys = [key for key in incompatible.missing_keys if not is_teacher_key(key)]
+        unexpected_keys = [key for key in incompatible.unexpected_keys if not is_teacher_key(key)]
+        if strict and (missing_keys or unexpected_keys):
+            details = []
+            if missing_keys:
+                details.append("Missing key(s): " + ", ".join(repr(key) for key in missing_keys))
+            if unexpected_keys:
+                details.append(
+                    "Unexpected key(s): " + ", ".join(repr(key) for key in unexpected_keys)
+                )
+            raise RuntimeError(
+                f"Error(s) in loading state_dict for {self.__class__.__name__}:\n\t"
+                + "\n\t".join(details)
+            )
+        return type(incompatible)(missing_keys, unexpected_keys)
+
+    def filter_state_dict_for_save(self, state_dict):
+        """Return a deployable checkpoint with the training-only VGGT removed."""
+
+        return strip_spatial_teacher_state_dict(state_dict)
