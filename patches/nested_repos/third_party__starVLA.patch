+        invoking it a second time.  This preserves Qwen's exact processor,
+        DeepStack behavior, gradients, and memory profile.
+        """
+
+        captured: dict[str, torch.Tensor] = {}
+        visual_merger = self._qwen_visual_merger()
+
+        def hook(_module, _inputs, output):
+            captured["tokens"] = select_qwen_merger_feature(
+                self.student_feature_source,
+                _inputs,
+                output,
+            )
+
+        handle = visual_merger.register_forward_hook(hook)
+        return captured, handle
+
+    def _qwen_visual_merger(self):
+        """Resolve Qwen's main post-encoder image-token merger."""
+
+        visual = self._qwen_visual_module()
+        merger = getattr(visual, "merger", None)
+        if not isinstance(merger, torch.nn.Module):
+            raise RuntimeError(
+                "Resolved Qwen vision tower does not expose a main 'merger' module"
+            )
+        return merger
+
+    def _qwen_visual_module(self):
+        """Resolve Qwen's vision tower before or after PEFT wrapping."""
+
+        root = self.qwen_vl_interface.model
+        candidate_paths = (
+            "visual",
+            "model.visual",
+            "model.model.visual",
+            "base_model.model.visual",
+            "base_model.model.model.visual",
+        )
+        for path in candidate_paths:
+            value = root
+            try:
+                for attribute in path.split("."):
+                    value = getattr(value, attribute)
+            except AttributeError:
+                continue
+            if isinstance(value, torch.nn.Module):
+                return value
+
+        matches = [
+            module
+            for name, module in root.named_modules()
+            if name == "visual" or name.endswith(".visual")
+        ]
+        unique_matches = list(dict.fromkeys(matches))
+        if len(unique_matches) == 1:
+            return unique_matches[0]
+        raise RuntimeError(
+            "Could not uniquely resolve the Qwen vision tower after PEFT wrapping; "
+            f"found {len(unique_matches)} candidates"
+        )
+
+    def _student_views(
+        self,
+        *,
+        qwen_inputs: Mapping[str, torch.Tensor],
+        hidden_states: tuple[torch.Tensor, ...],
+        captured_visual_tokens: torch.Tensor | None,
+        batch_size: int,
