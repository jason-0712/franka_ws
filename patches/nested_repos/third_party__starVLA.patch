+#!/usr/bin/env python3
+"""Audit whether Spatial-Forcing changes Qwen representations, not just its head.
+
+This script is deliberately action-free: it loads held-out RGB snapshots,
+extracts Qwen intermediate image tokens from several checkpoints, and compares
+them with one frozen VGGT teacher.  It never imports ROS or sends robot
+commands.
+"""
+
+from __future__ import annotations
+
+import argparse
+from contextlib import nullcontext
+import csv
+import gc
+import json
+from pathlib import Path
+import time
+from typing import Any
+
+import torch
+from PIL import Image
+
+from starVLA.model.framework.base_framework import build_framework
+from starVLA.model.framework.share_tools import dict_to_namespace, read_mode_config
+from starVLA.model.modules.spatial_forcing.alignment import (
+    extract_visual_tokens_by_view,
+    qwen_visual_token_grids,
+    resample_teacher_tokens_by_view,
+    strip_spatial_teacher_state_dict,
+)
+from starVLA.model.modules.spatial_forcing.representation_audit import (
+    collect_pooled_records,
+    cosine_prediction_loss,
+    direction_opposition_scores,
+    fit_dual_ridge_probe,
+    linear_cka,
+    position_distance_matrices,
+    position_rsa,
+)
+from starVLA.model.modules.spatial_forcing.vggt_teacher import FrozenVGGTTeacher
+
+
+TASK = "pick up the cube and place it on the box"
+DEFAULT_SNAPSHOT_ROOT = Path(
+    "/data/hanyu/starVLA_audit_inputs/dav2_cube_shift_20260803_144954"
+)
+DEFAULT_MODELS = {
+    "libero74": Path(
+        "/data/hanyu/starVLA_runs/"
+        "quest3_franka_dualcam_74eps_from_libero30k_vision_frozen_20k_retry3/"
+        "final_model/pytorch_model.pt"
+    ),
+    "alpha0": Path(
+        "/data/hanyu/starVLA_runs/"
+        "qwengroot_spatial_forcing_libero74_control500_alpha0_20260804_074900_rgb_inference/"
+        "final_model/pytorch_model.pt"
+    ),
+    "alpha01": Path(
+        "/data/hanyu/starVLA_runs/"
+        "qwengroot_spatial_forcing_libero74_pilot500_alpha01_20260804_064832_rgb_inference/"
+        "final_model/pytorch_model.pt"
+    ),
+}
+DEFAULT_TEACHER = Path("/data/hanyu/starVLA_checkpoints/VGGT-1B/model.pt")
+DEFAULT_LABELS = (
+    "center",
+    "primary_front",
+    "primary_back",
+    "primary_left",
+    "primary_right",
+)
+VIEW_NAMES = ("primary", "wrist")
+
+
+def load_rgb_only_framework(checkpoint: Path):
+    """Load a policy for representation audit without constructing VGGT.
+
+    Historical DeepSpeed runs contain either zero or many
+    ``spatial_teacher.*`` tensors depending on the exact save path.  Audit
+    needs only the RGB student and loads one shared VGGT teacher separately,
+    so it normalizes both checkpoint formats here and strictly validates all
+    remaining policy parameters.
+    """
+
+    model_config, norm_stats = read_mode_config(checkpoint)
+    framework_config = model_config.get("framework", {})
+    spatial_config = framework_config.get("spatial_forcing")
+    if spatial_config is not None:
+        spatial_config["teacher_enabled"] = False
+    config = dict_to_namespace(model_config)
+    config.trainer.pretrained_checkpoint = None
+    framework = build_framework(config)
+    framework.norm_stats = norm_stats
+    # Be defensive against legacy config-merging paths that reconstruct the
+    # external teacher despite the explicit false override above.  Assigning
+    # None unregisters it from the effective policy state for this audit.
+    if hasattr(framework, "spatial_teacher"):
+        framework.spatial_teacher = None
+
+    if checkpoint.suffix == ".safetensors":
+        from safetensors.torch import load_file
+
+        state_dict = load_file(str(checkpoint))
+    else:
+        try:
+            state_dict = torch.load(
+                checkpoint,
+                map_location="cpu",
+                weights_only=True,
+                mmap=True,
+            )
+        except TypeError:
+            state_dict = torch.load(checkpoint, map_location="cpu")
+    state_dict = strip_spatial_teacher_state_dict(state_dict)
+    # Call torch's base implementation directly.  This deliberately bypasses
+    # subclass/PEFT loading hooks whose historical strictness differs across
+    # server installations; the audit performs its own strict validation of
+    # every non-teacher key immediately below.
+    incompatible = torch.nn.Module.load_state_dict(
+        framework,
+        state_dict,
+        strict=False,
+    )
+    missing = [key for key in incompatible.missing_keys if "spatial_teacher." not in key]
+    unexpected = [key for key in incompatible.unexpected_keys if "spatial_teacher." not in key]
+    if missing or unexpected:
+        raise RuntimeError(
+            "RGB-only audit checkpoint mismatch after removing VGGT: "
+            f"missing={missing}, unexpected={unexpected}"
+        )
+    print(
+        f"RGB_ONLY_AUDIT_LOAD=PASS checkpoint={checkpoint} "
+        f"policy_keys={len(state_dict)} teacher_enabled=false "
+        f"missing_non_teacher={len(missing)} unexpected_non_teacher={len(unexpected)}",
+        flush=True,
+    )
+    return framework
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--baseline-checkpoint", type=Path, default=DEFAULT_MODELS["libero74"])
+    parser.add_argument("--control-checkpoint", type=Path, default=DEFAULT_MODELS["alpha0"])
+    parser.add_argument("--spatial-checkpoint", type=Path, default=DEFAULT_MODELS["alpha01"])
+    parser.add_argument("--teacher-weight", type=Path, default=DEFAULT_TEACHER)
+    parser.add_argument("--snapshot-root", type=Path, default=DEFAULT_SNAPSHOT_ROOT)
+    parser.add_argument("--labels", nargs="+", default=list(DEFAULT_LABELS))
+    parser.add_argument(
+        "--probe-train-labels",
+        nargs="+",
+        default=["center", "primary_front", "primary_back"],
+    )
+    parser.add_argument(
+        "--probe-eval-labels",
+        nargs="+",
+        default=["primary_left", "primary_right"],
+    )
+    parser.add_argument("--task", default=TASK)
+    parser.add_argument("--image-size", type=int, default=224)
+    parser.add_argument("--student-hidden-state-index", type=int, default=24)
+    parser.add_argument("--pool-size", type=int, default=7)
+    parser.add_argument("--probe-ridge", type=float, default=1e-2)
+    parser.add_argument("--device", default="cuda:0")
+    parser.add_argument("--use-bf16", action=argparse.BooleanOptionalAction, default=True)
+    parser.add_argument("--output-dir", type=Path, default=None)
+    return parser.parse_args()
+
+
+def validate_inputs(args: argparse.Namespace) -> dict[str, Path]:
+    models = {
+        "libero74": args.baseline_checkpoint.expanduser().resolve(),
+        "alpha0": args.control_checkpoint.expanduser().resolve(),
+        "alpha01": args.spatial_checkpoint.expanduser().resolve(),
+    }
+    required = [*models.values(), args.teacher_weight]
+    for path in required:
+        if not path.is_file() or path.stat().st_size == 0:
+            raise FileNotFoundError(f"Required file is missing or empty: {path}")
+    if args.image_size <= 0 or args.pool_size <= 0:
+        raise ValueError("image-size and pool-size must be positive")
+    if args.probe_ridge <= 0:
+        raise ValueError("probe-ridge must be positive")
+    if len(args.labels) < 5:
+        raise ValueError("At least five cube-position labels are required")
+    if set(args.probe_train_labels) & set(args.probe_eval_labels):
+        raise ValueError("probe train/eval labels must be disjoint")
+    unknown = (set(args.probe_train_labels) | set(args.probe_eval_labels)) - set(args.labels)
+    if unknown:
+        raise ValueError(f"Probe labels are absent from --labels: {sorted(unknown)}")
+    for label in args.labels:
+        for view_name in VIEW_NAMES:
+            path = args.snapshot_root / label / f"{view_name}_original.png"
+            if not path.is_file():
+                raise FileNotFoundError(f"Held-out snapshot is missing: {path}")
+    return models
+
+
+def load_snapshots(root: Path, labels: list[str], image_size: int) -> dict[str, list[Image.Image]]:
+    snapshots: dict[str, list[Image.Image]] = {}
+    for label in labels:
+        views = []
+        for view_name in VIEW_NAMES:
+            with Image.open(root / label / f"{view_name}_original.png") as image:
+                views.append(image.convert("RGB").resize((image_size, image_size)))
+        snapshots[label] = views
+    return snapshots
+
+
+def autocast_context(device: torch.device, use_bf16: bool):
+    if device.type == "cuda" and use_bf16:
+        return torch.autocast(device_type="cuda", dtype=torch.bfloat16)
+    return nullcontext()
+
+
+def resolve_image_token_id(framework) -> int:
+    if hasattr(framework, "image_token_id"):
+        return int(framework.image_token_id)
+    tokenizer = framework.qwen_vl_interface.processor.tokenizer
+    token = "<|image_pad|>"
+    token_id = tokenizer.convert_tokens_to_ids(token)
+    unknown_id = getattr(tokenizer, "unk_token_id", None)
+    if token_id is None or token_id == unknown_id:
+        token_id = 151655
+    return int(token_id)
+
+
+def extract_teacher_cache(
+    snapshots: dict[str, list[Image.Image]],
+    *,
+    teacher_weight: Path,
+    device: torch.device,
+    use_bf16: bool,
+) -> dict[str, dict[str, Any]]:
+    print(f"Loading frozen VGGT teacher: {teacher_weight}", flush=True)
+    teacher = FrozenVGGTTeacher(
+        weight_path=teacher_weight,
+        input_size=518,
+        feature_layer=-1,
+        use_bf16=use_bf16,
+        use_vggt_positional_embedding=True,
+        positional_embedding_ratio=0.1,
+    )
+    if use_bf16:
+        teacher = teacher.to(dtype=torch.bfloat16)
+    teacher = teacher.to(device).eval()
+
+    cache: dict[str, dict[str, Any]] = {}
+    for label, images in snapshots.items():
+        output = teacher([images])
+        cache[label] = {
+            "tokens": output.tokens.detach().float().cpu(),
+            "source_hw": tuple(tuple(int(value) for value in grid) for grid in output.source_hw),
+        }
+        print(
+            f"teacher label={label} tokens={tuple(output.tokens.shape)} "
+            f"source_hw={output.source_hw}",
+            flush=True,
+        )
+
+    del teacher
+    gc.collect()
+    if device.type == "cuda":
+        torch.cuda.empty_cache()
+    return cache
+
+
+def extract_model_records(
+    model_name: str,
+    checkpoint: Path,
+    snapshots: dict[str, list[Image.Image]],
+    teacher_cache: dict[str, dict[str, Any]],
+    *,
+    instruction: str,
+    device: torch.device,
+    use_bf16: bool,
+    default_hidden_index: int,
+) -> dict[str, Any]:
+    print(f"Loading model={model_name}: {checkpoint}", flush=True)
+    framework = load_rgb_only_framework(checkpoint)
+    if use_bf16:
+        framework = framework.to(dtype=torch.bfloat16)
+    framework = framework.to(device).eval()
+
+    expected_views = int(getattr(framework, "expected_num_views", len(VIEW_NAMES)))
+    if expected_views != len(VIEW_NAMES):
+        raise ValueError(
+            f"model={model_name} expects {expected_views} views, audit provides {len(VIEW_NAMES)}"
+        )
+    hidden_index = int(getattr(framework, "student_hidden_state_index", default_hidden_index))
+    image_token_id = resolve_image_token_id(framework)
+    vision_config = framework.qwen_vl_interface.model.config.vision_config
+    spatial_merge_size = int(getattr(vision_config, "spatial_merge_size", 2))
+
+    student_records: dict[tuple[str, int], torch.Tensor] = {}
+    teacher_records: dict[tuple[str, int], torch.Tensor] = {}
+    grids: dict[tuple[str, int], tuple[int, int]] = {}
+    own_alignment_losses: list[float] = []
+
+    with torch.inference_mode():
+        for label, images in snapshots.items():
+            qwen_inputs = framework.qwen_vl_interface.build_qwenvl_inputs(
+                images=[images],
+                instructions=[instruction],
+            )
+            with autocast_context(device, use_bf16):
+                output = framework.qwen_vl_interface(
+                    **qwen_inputs,
+                    output_attentions=False,
+                    output_hidden_states=True,
+                    return_dict=True,
+                )
+            hidden_states = output.hidden_states
+            if not -len(hidden_states) <= hidden_index < len(hidden_states):
+                raise IndexError(
+                    f"model={model_name} hidden index {hidden_index} is invalid for "
+                    f"{len(hidden_states)} states"
+                )
+            selected = hidden_states[hidden_index]
+            input_ids = qwen_inputs["input_ids"].to(selected.device)
+            student_views = extract_visual_tokens_by_view(
+                selected,
+                input_ids,
+                image_token_id=image_token_id,
+                expected_num_views=expected_views,
+            )
+            target_hw = qwen_visual_token_grids(
+                qwen_inputs["image_grid_thw"],
+                token_counts_by_view=[int(tokens.shape[1]) for tokens in student_views],
+                batch_size=1,
+                expected_num_views=expected_views,
+                spatial_merge_size=spatial_merge_size,
+            )
+            cached = teacher_cache[label]
+            teacher_views = resample_teacher_tokens_by_view(
+                cached["tokens"],
+                source_hw=cached["source_hw"],
+                target_hw=target_hw,
+                mode="bilinear",
+            )
+            for view_index, (student, teacher, grid) in enumerate(
+                zip(student_views, teacher_views, target_hw, strict=True)
+            ):
+                key = (label, view_index)
+                student_records[key] = student[0].detach().float().cpu()
+                teacher_records[key] = teacher[0].detach().float().cpu()
+                grids[key] = tuple(int(value) for value in grid)
+                if hasattr(framework, "alignment_head"):
+                    teacher_on_device = teacher.to(device=student.device, dtype=student.dtype)
+                    own_loss = framework.alignment_head(student, teacher_on_device)
+                    own_alignment_losses.append(float(own_loss.float().item()))
+            print(
+                f"model={model_name} label={label} grids={target_hw} "
+                f"hidden_index={hidden_index}",
+                flush=True,
+            )
+            del output, hidden_states, selected, student_views, teacher_views, qwen_inputs
+
+    framework_class = type(framework).__name__
+    del framework
+    gc.collect()
+    if device.type == "cuda":
+        torch.cuda.empty_cache()
+    return {
+        "checkpoint": str(checkpoint),
+        "framework_class": framework_class,
+        "hidden_index": hidden_index,
+        "student": student_records,
+        "teacher": teacher_records,
+        "grids": grids,
+        "own_alignment_loss": (
+            sum(own_alignment_losses) / len(own_alignment_losses)
+            if own_alignment_losses
+            else None
+        ),
+    }
+
+
+def calculate_metrics(
+    extracted: dict[str, dict[str, Any]],
+    *,
+    labels: list[str],
+    probe_train_labels: list[str],
+    probe_eval_labels: list[str],
+    num_views: int,
+    pool_size: int,
+    probe_ridge: float,
+    metric_device: torch.device,
+) -> dict[str, Any]:
+    output_hw = (pool_size, pool_size)
+    per_model: dict[str, dict[str, Any]] = {}
+    pooled_by_model: dict[str, dict[str, torch.Tensor]] = {}
+
+    for model_name, data in extracted.items():
+        student_all = collect_pooled_records(
+            data["student"], data["grids"], labels,
+            num_views=num_views, output_hw=output_hw,
+        ).to(metric_device)
+        teacher_all = collect_pooled_records(
+            data["teacher"], data["grids"], labels,
+            num_views=num_views, output_hw=output_hw,
+        ).to(metric_device)
+        cka_by_view = {}
+        for view_index in range(num_views):
+            view_student = collect_pooled_records(
+                data["student"], data["grids"], labels,
+                num_views=num_views, output_hw=output_hw,
+            ).reshape(len(labels), num_views, pool_size * pool_size, -1)[:, view_index]
+            view_teacher = collect_pooled_records(
+                data["teacher"], data["grids"], labels,
+                num_views=num_views, output_hw=output_hw,
+            ).reshape(len(labels), num_views, pool_size * pool_size, -1)[:, view_index]
+            cka_by_view[VIEW_NAMES[view_index]] = float(
+                linear_cka(
+                    view_student.reshape(-1, view_student.shape[-1]).to(metric_device),
+                    view_teacher.reshape(-1, view_teacher.shape[-1]).to(metric_device),
+                ).item()
+            )
+        rsa = position_rsa(
+            data["student"], data["teacher"], labels, num_views=num_views
+        )
+        raw_distance_matrices = position_distance_matrices(
+            data["student"], data["teacher"], labels, num_views=num_views
+        )
+        distance_matrices = {}
+        for view_index, view_name in enumerate(VIEW_NAMES):
+            per_view = raw_distance_matrices[f"view_{view_index}"]
+            distance_matrices[view_name] = {
+                "student": per_view["student"].tolist(),
+                "teacher": per_view["teacher"].tolist(),
+            }
+        student_opposition = direction_opposition_scores(
+            data["student"],
+            center_label="center",
+            opposite_pairs={
+                "front_back": ("primary_front", "primary_back"),
+                "left_right": ("primary_left", "primary_right"),
+            },
+            num_views=num_views,
+        )
+        teacher_opposition = direction_opposition_scores(
+            data["teacher"],
+            center_label="center",
+            opposite_pairs={
+                "front_back": ("primary_front", "primary_back"),
+                "left_right": ("primary_left", "primary_right"),
+            },
+            num_views=num_views,
+        )
+        per_model[model_name] = {
+            "checkpoint": data["checkpoint"],
+            "framework_class": data["framework_class"],
+            "student_hidden_state_index": data["hidden_index"],
+            "own_alignment_loss": data["own_alignment_loss"],
+            "linear_cka": float(linear_cka(student_all, teacher_all).item()),
+            "linear_cka_by_view": cka_by_view,
+            "position_rsa": rsa,
+            "position_distance_matrices": distance_matrices,
+            "student_direction_opposition": student_opposition,
+            "teacher_direction_opposition": teacher_opposition,
+        }
+        pooled_by_model[model_name] = {
+            "train_x": collect_pooled_records(
+                data["student"], data["grids"], probe_train_labels,
+                num_views=num_views, output_hw=output_hw,
+            ),
+            "train_y": collect_pooled_records(
+                data["teacher"], data["grids"], probe_train_labels,
+                num_views=num_views, output_hw=output_hw,
+            ),
+            "eval_x": collect_pooled_records(
+                data["student"], data["grids"], probe_eval_labels,
+                num_views=num_views, output_hw=output_hw,
+            ),
+            "eval_y": collect_pooled_records(
+                data["teacher"], data["grids"], probe_eval_labels,
+                num_views=num_views, output_hw=output_hw,
+            ),
+        }
+
+    shared_train_x = torch.cat(
+        [pooled_by_model[name]["train_x"] for name in sorted(pooled_by_model)], dim=0
+    ).to(metric_device)
+    shared_train_y = torch.cat(
+        [pooled_by_model[name]["train_y"] for name in sorted(pooled_by_model)], dim=0
+    ).to(metric_device)
+    probe = fit_dual_ridge_probe(shared_train_x, shared_train_y, ridge=probe_ridge)
+    for model_name, pooled in pooled_by_model.items():
+        eval_x = pooled["eval_x"].to(metric_device)
+        eval_y = pooled["eval_y"].to(metric_device)
+        prediction = probe.predict(eval_x)
+        per_model[model_name]["shared_probe_cosine_loss"] = float(
+            cosine_prediction_loss(prediction, eval_y).item()
+        )
+
+    alpha0 = per_model["alpha0"]
+    alpha01 = per_model["alpha01"]
+    comparison = {
+        "alpha01_minus_alpha0_linear_cka": alpha01["linear_cka"] - alpha0["linear_cka"],
+        "alpha01_minus_alpha0_position_rsa": (
+            alpha01["position_rsa"]["mean"] - alpha0["position_rsa"]["mean"]
+        ),
+        "alpha01_minus_alpha0_shared_probe_loss": (
+            alpha01["shared_probe_cosine_loss"] - alpha0["shared_probe_cosine_loss"]
+        ),
+        "interpretation": (
+            "Positive CKA/RSA differences and a negative shared-probe-loss difference "
+            "are the expected direction if alpha=0.1 transferred VGGT geometry into "
+            "the student representation. Own-head loss alone is not sufficient."
+        ),
+    }
+    return {"per_model": per_model, "comparison": comparison}
+
+
+def write_outputs(output_dir: Path, report: dict[str, Any]) -> None:
+    output_dir.mkdir(parents=True, exist_ok=True)
+    json_path = output_dir / "representation_audit.json"
+    csv_path = output_dir / "representation_audit.csv"
+    json_path.write_text(json.dumps(report, indent=2) + "\n")
+
+    rows = []
+    for model_name, metrics in report["results"]["per_model"].items():
+        rows.append(
+            {
+                "model": model_name,
+                "own_alignment_loss": metrics["own_alignment_loss"],
+                "linear_cka": metrics["linear_cka"],
+                "primary_cka": metrics["linear_cka_by_view"]["primary"],
+                "wrist_cka": metrics["linear_cka_by_view"]["wrist"],
+                "position_rsa": metrics["position_rsa"]["mean"],
+                "shared_probe_cosine_loss": metrics["shared_probe_cosine_loss"],
+                "front_back_opposition": metrics["student_direction_opposition"][
+                    "front_back_mean"
+                ],
+                "left_right_opposition": metrics["student_direction_opposition"][
+                    "left_right_mean"
+                ],
+            }
+        )
+    with csv_path.open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+    print(f"AUDIT_JSON={json_path}")
+    print(f"AUDIT_CSV={csv_path}")
+
+
+def main() -> None:
+    args = parse_args()
+    models = validate_inputs(args)
+    if args.device.startswith("cuda") and not torch.cuda.is_available():
+        raise RuntimeError(f"CUDA device requested but CUDA is unavailable: {args.device}")
+    device = torch.device(args.device)
+    snapshots = load_snapshots(args.snapshot_root, args.labels, args.image_size)
+
+    started = time.time()
+    teacher_cache = extract_teacher_cache(
+        snapshots,
+        teacher_weight=args.teacher_weight,
+        device=device,
+        use_bf16=args.use_bf16,
+    )
+    extracted = {}
+    for model_name, checkpoint in models.items():
+        extracted[model_name] = extract_model_records(
+            model_name,
+            checkpoint,
+            snapshots,
+            teacher_cache,
+            instruction=args.task,
+            device=device,
+            use_bf16=args.use_bf16,
+            default_hidden_index=args.student_hidden_state_index,
+        )
+
+    results = calculate_metrics(
+        extracted,
+        labels=args.labels,
+        probe_train_labels=args.probe_train_labels,
+        probe_eval_labels=args.probe_eval_labels,
+        num_views=len(VIEW_NAMES),
+        pool_size=args.pool_size,
+        probe_ridge=args.probe_ridge,
+        metric_device=device,
+    )
+    output_dir = args.output_dir
+    if output_dir is None:
+        output_dir = Path("/data/hanyu/starVLA_runs") / time.strftime(
+            "spatial_forcing_representation_audit_%Y%m%d_%H%M%S"
+        )
+    report = {
+        "status": "PASS",
+        "robot_commands_sent": 0,
+        "held_out_snapshot_root": str(args.snapshot_root),
+        "labels": args.labels,
+        "probe_train_labels": args.probe_train_labels,
+        "probe_eval_labels": args.probe_eval_labels,
+        "image_size": args.image_size,
+        "pool_size": args.pool_size,
+        "teacher_weight": str(args.teacher_weight),
+        "elapsed_seconds": time.time() - started,
+        "results": results,
+    }
+    write_outputs(output_dir, report)
+    print(json.dumps(results, indent=2))
+    print("SPATIAL_FORCING_REPRESENTATION_AUDIT=PASS")
+    print("ROBOT_COMMANDS_SENT=0")
+
+
+if __name__ == "__main__":
+    main()
