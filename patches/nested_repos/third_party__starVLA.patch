index 0000000..63e7e25
--- /dev/null
+++ b/examples/realRobots/Franka/train_files/run_qwengroot_sf_action_conditioned_smoke.sh
@@ -0,0 +1,147 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo="${STARVLA_REPO:-/home/hanyu/starVLA}"
+cd "${repo}"
+export PATH="/home/hanyu/miniconda3/envs/starVLA/bin:${PATH}"
+
+matched_arm="${MATCHED_ARM:?Set MATCHED_ARM=control or treatment}"
+case "${matched_arm}" in
+  control) expected_gate_trainable="false" ; default_gpu=0 ; default_port=29950 ;;
+  treatment) expected_gate_trainable="true" ; default_gpu=1 ; default_port=29951 ;;
+  *) echo "MATCHED_ARM must be control or treatment, got ${matched_arm}" >&2; exit 1 ;;
+esac
+gate_trainable="${ACTION_GATE_TRAINABLE:-${expected_gate_trainable}}"
+if [[ "${gate_trainable}" != "${expected_gate_trainable}" ]]; then
+  echo "ERROR: ${matched_arm} requires gate_trainable=${expected_gate_trainable}" >&2
+  exit 1
+fi
+
+patch_alpha="${PATCH_STRUCTURE_ALPHA:-0.1}"
+if [[ "${patch_alpha}" != "0.1" ]]; then
+  echo "ERROR: both Phase-C arms require patch alpha 0.1" >&2
+  exit 1
+fi
+
+gpu_id="${GPU_ID:-${default_gpu}}"
+main_port="${MAIN_PROCESS_PORT:-${default_port}}"
+tag="${PHASE_C_TAG:-$(date +%Y%m%d_%H%M%S)}"
+run_id="${RUN_ID:-sf_phase_c_action_conditioned_${matched_arm}_smoke20_${tag}}"
+run_root="${RUN_ROOT_DIR:-/data/hanyu/starVLA_runs}"
+log_dir="${LOG_DIR:-/home/hanyu/starVLA_logs}"
+log_path="${log_dir}/${run_id}.log"
+config="${CONFIG_YAML:-examples/realRobots/Franka/train_files/starvla_cotrain_quest3_franka_sf_action_conditioned.yaml}"
+teacher="${VGGT_WEIGHT:-/data/hanyu/starVLA_checkpoints/VGGT-1B/model.pt}"
+baseline="${PRETRAINED_CHECKPOINT:-/data/hanyu/starVLA_runs/replay94_from_successful_libero74_5k_retry1_20260810/final_model/pytorch_model.pt}"
+data_root="${DATA_ROOT_DIR:-/data/hanyu/quest3_franka_real/snkdjn}"
+data_mix="${DATA_MIX:-quest3_franka_dualcam_replay_94eps_v1}"
+max_steps="${MAX_TRAIN_STEPS:-20}"
+save_interval="${SAVE_INTERVAL:-$((max_steps + 1))}"
+eval_interval="${EVAL_INTERVAL:-${max_steps}}"
+
+for path in "${config}" "${teacher}" "${baseline}"; do
+  if [[ ! -s "${path}" ]]; then
+    echo "ERROR: required input missing or empty: ${path}" >&2
+    exit 1
+  fi
+done
+if [[ ! -f vggt/models/vggt.py ]]; then
+  echo "ERROR: pinned VGGT source missing at ${repo}/vggt" >&2
+  exit 1
+fi
+
+available_kb="$(df -Pk "${run_root}" | awk 'NR==2 {print $4}')"
+if (( available_kb < 15728640 )); then
+  echo "ERROR: less than 15 GiB is free on ${run_root}" >&2
+  exit 1
+fi
+read -r used_mib total_mib < <(
+  nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits \
+    -i "${gpu_id}" | tr -d ','
+)
+echo "GPU ${gpu_id} currently uses ${used_mib}/${total_mib} MiB"
+if (( used_mib > 1024 )); then
+  echo "ERROR: GPU ${gpu_id} is occupied" >&2
+  exit 1
+fi
+if (( total_mib < 79000 )); then
+  echo "ERROR: Phase-C smoke requires an 80GB-or-larger GPU" >&2
+  exit 1
+fi
+
+mkdir -p "${run_root}" "${log_dir}"
+export CUDA_DEVICE_ORDER=PCI_BUS_ID
+export CUDA_VISIBLE_DEVICES="${gpu_id}"
+export PYTHONPATH="${repo}:${PYTHONPATH:-}"
+export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
+export WANDB_MODE="${WANDB_MODE:-disabled}"
+
+echo "SF_PHASE_C_ARM=${matched_arm}"
+echo "SF_PHASE_C_PATCH_ALPHA=${patch_alpha}"
+echo "SF_PHASE_C_ACTION_GATE_TRAINABLE=${gate_trainable}"
+echo "SF_PHASE_C_ACTION_GATE_INIT=0.0"
+echo "SF_PHASE_C_LAYER=16"
+echo "SF_PHASE_C_FEATURE_SOURCE=llm_hidden"
+echo "SF_PHASE_C_TEACHER=VGGT_joint_frozen_training_only"
+echo "SF_PHASE_C_DEPLOYMENT=RGB_student_only"
+echo "SF_PHASE_C_RUN_ID=${run_id}"
+
+set +e
+accelerate launch \
+  --config_file starVLA/config/deepseeds/deepspeed_zero2.yaml \
+  --num_processes 1 \
+  --main_process_port "${main_port}" \
+  --gpu_ids "${gpu_id}" \
+  starVLA/training/train_starvla.py \
+  --config_yaml "${config}" \
+  --framework.name QwenGR00TSpatialForcingActionConditioned \
+  --framework.spatial_forcing.teacher_weight_path "${teacher}" \
+  --framework.spatial_forcing.patch_structure_alpha "${patch_alpha}" \
+  --framework.spatial_forcing.action_conditioning_gate_trainable "${gate_trainable}" \
+  --framework.spatial_forcing.action_conditioning_gate_init 0.0 \
+  --framework.spatial_forcing.projected_alignment_alpha 0.0 \
+  --framework.spatial_forcing.relational_alignment_alpha 0.0 \
+  --framework.spatial_forcing.scene_relational_alpha 0.0 \
+  --framework.spatial_forcing.student_hidden_state_index 16 \
+  --framework.spatial_forcing.student_feature_source llm_hidden \
+  --framework.spatial_forcing.image_augmentation_enabled false \
+  --framework.spatial_forcing.inference_center_crop_enabled false \
+  --datasets.vla_data.data_root_dir "${data_root}" \
+  --datasets.vla_data.data_mix "${data_mix}" \
+  --trainer.pretrained_checkpoint "${baseline}" \
+  --trainer.max_train_steps "${max_steps}" \
+  --trainer.num_warmup_steps "${NUM_WARMUP_STEPS:-5}" \
+  --trainer.save_interval "${save_interval}" \
+  --trainer.eval_interval "${eval_interval}" \
+  --trainer.learning_rate.action_model "${ACTION_MODEL_LR:-3e-5}" \
+  --trainer.learning_rate.qwen_vl_interface "${QWEN_VL_LR:-1e-5}" \
+  --trainer.learning_rate.alignment_head "${ALIGNMENT_HEAD_LR:-1e-4}" \
+  --trainer.learning_rate.action_spatial_conditioner "${ACTION_CONDITIONER_LR:-1e-4}" \
+  --trainer.learning_rate.base "${BASE_LR:-1e-6}" \
+  --trainer.freeze_modules= \
+  --run_root_dir "${run_root}" \
+  --run_id "${run_id}" \
+  2>&1 | tee "${log_path}"
+status="${PIPESTATUS[0]}"
+set -e
+
+checkpoint="${run_root}/${run_id}/final_model/pytorch_model.pt"
+if [[ "${status}" -ne 0 || ! -s "${checkpoint}" ]]; then
+  echo "SF_PHASE_C_SMOKE=FAIL status=${status}" >&2
+  echo "LOG=${log_path}" >&2
+  failure_status="${status}"
+  if [[ "${failure_status}" -eq 0 ]]; then failure_status=1; fi
+  exit "${failure_status}"
+fi
+if grep -Eiq 'Traceback|OutOfMemoryError|CUDA out of memory|(^|[^[:alnum:]_])nan([^[:alnum:]_]|$)' "${log_path}"; then
+  echo "ERROR: suspicious output in ${log_path}" >&2
+  exit 1
+fi
+
+{
+  echo "SF_PHASE_C_SMOKE=PASS arm=${matched_arm}"
+  echo "ROBOT_COMMANDS_SENT=0"
+  echo "RUN_DIR=${run_root}/${run_id}"
+  echo "CHECKPOINT=${checkpoint}"
+  echo "LOG=${log_path}"
+} | tee -a "${log_path}"
