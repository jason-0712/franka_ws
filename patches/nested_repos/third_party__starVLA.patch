+"""CPU integration test for the PEFT Spatial-Forcing student path."""
+
+import unittest
+
+import torch
+import torch.nn as nn
+
+from starVLA.model.modules.spatial_forcing import (
+    SpatialAlignmentHead,
+    inject_qwen_lora,
+    remap_plain_checkpoint_for_lora,
+    trainable_lora_parameter_names,
+)
+
+
+class _TinyAttention(nn.Module):
+    def __init__(self, width: int):
+        super().__init__()
+        self.q_proj = nn.Linear(width, width, bias=False)
+        self.k_proj = nn.Linear(width, width, bias=False)
+        self.v_proj = nn.Linear(width, width, bias=False)
+        self.o_proj = nn.Linear(width, width, bias=False)
+
+    def forward(self, value):
+        return self.o_proj(self.q_proj(value) + self.k_proj(value) + self.v_proj(value))
+
+
+class _TinyQwen(nn.Module):
+    def __init__(self, width: int = 8):
+        super().__init__()
+        self.self_attn = _TinyAttention(width)
+
+    def forward(self, value):
+        return self.self_attn(value)
+
+
+class _TinyAllLinearStudent(nn.Module):
+    def __init__(self, width: int = 8):
+        super().__init__()
+        self.input_projection = nn.Linear(width, width)
+        self.mlp = nn.Sequential(
+            nn.Linear(width, 2 * width),
+            nn.GELU(),
+            nn.Linear(2 * width, width),
+        )
+
+    def forward(self, value):
+        return self.mlp(self.input_projection(value))
+
+
+class SpatialForcingLoraTest(unittest.TestCase):
+    def test_all_linear_special_target_is_forwarded_and_initially_noop(self):
+        torch.manual_seed(17)
+        student = _TinyAllLinearStudent()
+        inputs = torch.randn(2, 3, 8)
+        reference = student(inputs).detach().clone()
+
+        student = inject_qwen_lora(
+            student,
+            rank=4,
+            alpha=4,
+            target_modules="all-linear",
+        )
+
+        trainable = trainable_lora_parameter_names(student)
+        self.assertEqual(len(trainable), 6)
+        self.assertTrue(torch.equal(reference, student(inputs).detach()))
+        self.assertTrue(
+            all(
+                ("lora_" in name) == parameter.requires_grad
+                for name, parameter in student.named_parameters()
+            )
+        )
+
+    def test_invalid_string_target_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, "all-linear"):
+            inject_qwen_lora(_TinyQwen(), target_modules="q_proj")
+
+    def test_lora_is_noop_then_receives_alignment_gradient(self):
+        torch.manual_seed(31)
+        student = _TinyQwen()
+        inputs = torch.randn(2, 5, 8)
+        reference = student(inputs).detach().clone()
+        plain_checkpoint = {
+            key: value.detach().clone() for key, value in student.state_dict().items()
+        }
+
+        student = inject_qwen_lora(
+            student,
+            rank=4,
+            alpha=4,
+            target_modules=("q_proj", "k_proj", "v_proj", "o_proj"),
+        )
+        adapter_names = trainable_lora_parameter_names(student)
+        self.assertTrue(adapter_names)
+        self.assertTrue(all("lora_" in name for name in adapter_names))
+        self.assertTrue(
+            all(
+                ("lora_" in name) == parameter.requires_grad
+                for name, parameter in student.named_parameters()
+            )
+        )
+
+        remapped = remap_plain_checkpoint_for_lora(
+            plain_checkpoint,
+            student.state_dict().keys(),
+        )
+        incompatible = student.load_state_dict(remapped, strict=False)
+        self.assertFalse(incompatible.unexpected_keys)
+        self.assertTrue(all("lora_" in key for key in incompatible.missing_keys))
+        self.assertTrue(torch.equal(reference, student(inputs).detach()))
+
+        head = SpatialAlignmentHead(student_dim=8, teacher_dim=6, hidden_dim=10)
+        teacher = torch.randn(2, 5, 6, requires_grad=True)
+        loss = head(student(inputs), teacher)
+        loss.backward()
+
+        adapter_grad = sum(
+            float(parameter.grad.abs().sum())
+            for name, parameter in student.named_parameters()
+            if "lora_" in name and parameter.grad is not None
+        )
+        self.assertGreater(adapter_grad, 0.0)
+        self.assertIsNone(teacher.grad)
+
+
+if __name__ == "__main__":
+    unittest.main()
