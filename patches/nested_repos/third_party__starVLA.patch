+"""Calibration-free view crops and projection-resistant patch alignment."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+import math
+from typing import Any
+
+from PIL import Image
+import torch
+
+from .alignment import relational_geometry_loss
+from .image_augmentation import _to_rgb_pil
+
+
+def validate_normalized_crop_box(box: Sequence[float]) -> tuple[float, float, float, float]:
+    if len(box) != 4:
+        raise ValueError(f"crop box must contain x0,y0,x1,y1, got {box}")
+    x0, y0, x1, y1 = (float(value) for value in box)
+    if not (0.0 <= x0 < x1 <= 1.0 and 0.0 <= y0 < y1 <= 1.0):
+        raise ValueError(
+            "normalized crop must satisfy 0<=x0<x1<=1 and 0<=y0<y1<=1, "
+            f"got {(x0, y0, x1, y1)}"
+        )
+    return x0, y0, x1, y1
+
+
+class SpatialForcingViewCrop:
+    """Apply one deterministic normalized crop per ordered camera view.
+
+    Each crop is resized back to the source resolution so Qwen and VGGT keep
+    their existing input contracts.  A full-frame box returns an RGB copy.
+    The Franka dual-camera contract is ordered ``primary, wrist``.
+    """
+
+    def __init__(
+        self,
+        crop_boxes: Sequence[Sequence[float]],
+        *,
+        view_names: Sequence[str] | None = None,
+    ) -> None:
+        self.crop_boxes = tuple(validate_normalized_crop_box(box) for box in crop_boxes)
+        if not self.crop_boxes:
+            raise ValueError("at least one view crop is required")
+        if view_names is None:
+            view_names = tuple(f"view_{index}" for index in range(len(self.crop_boxes)))
+        self.view_names = tuple(str(name) for name in view_names)
+        if len(self.view_names) != len(self.crop_boxes):
+            raise ValueError("view_names and crop_boxes must have the same length")
+
+    @staticmethod
+    def _crop_one(image: Any, box: tuple[float, float, float, float]) -> Image.Image:
+        output = _to_rgb_pil(image)
+        if box == (0.0, 0.0, 1.0, 1.0):
+            return output.copy()
+        width, height = output.size
+        x0, y0, x1, y1 = box
+        # Match the preceding Replay94 coverage audit exactly: lower bounds
+        # use floor and upper bounds use ceil, so no audited boundary pixel is
+        # silently removed by the training transform.
+        left = max(0, min(width - 1, int(math.floor(x0 * width))))
+        top = max(0, min(height - 1, int(math.floor(y0 * height))))
+        right = max(left + 1, min(width, int(math.ceil(x1 * width))))
+        bottom = max(top + 1, min(height, int(math.ceil(y1 * height))))
+        return output.crop((left, top, right, bottom)).resize(
+            (width, height),
+            resample=Image.Resampling.BICUBIC,
+        )
+
+    def __call__(self, batch_images: list[list[Any]]) -> list[list[Image.Image]]:
+        if not batch_images:
+            raise ValueError("batch_images must not be empty")
+        expected_views = len(self.crop_boxes)
+        counts = [len(images) for images in batch_images]
+        if any(count != expected_views for count in counts):
+            raise ValueError(
+                f"expected {expected_views} ordered views {self.view_names}, got {counts}"
+            )
+        return [
+            [self._crop_one(image, box) for image, box in zip(images, self.crop_boxes)]
+            for images in batch_images
+        ]
+
+    def contract(self) -> dict[str, tuple[float, float, float, float]]:
+        return dict(zip(self.view_names, self.crop_boxes))
+
+
+def patch_structure_alignment_loss(
+    student_tokens: torch.Tensor,
+    teacher_tokens: torch.Tensor,
+) -> torch.Tensor:
+    """Match off-diagonal patch Gram matrices without a learned projector."""
+
+    return relational_geometry_loss(student_tokens, teacher_tokens)
