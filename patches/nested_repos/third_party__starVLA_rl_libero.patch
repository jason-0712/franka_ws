@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+"""Persistent length-prefixed TCP transport for low-jitter shadow inference."""
+
+from __future__ import annotations
+
+import socket
+import struct
+import time
+from typing import Any, Mapping
+
+try:
+    from .qwengroot_low_jitter_websocket_server import (
+        LowJitterWebsocketPolicyServer,
+        _pack_array,
+        _unpack_array,
+    )
+except ImportError:  # Direct execution on the GPU host.
+    from qwengroot_low_jitter_websocket_server import (
+        LowJitterWebsocketPolicyServer,
+        _pack_array,
+        _unpack_array,
+    )
+
+_FRAME_HEADER = struct.Struct("!I")
+_MAX_FRAME_BYTES = 32 * 1024 * 1024
+
+
+def _recv_exact(connection: socket.socket, size: int) -> bytes | None:
+    chunks = bytearray()
+    while len(chunks) < size:
+        block = connection.recv(size - len(chunks))
+        if not block:
+            if not chunks:
+                return None
+            raise ConnectionError("TCP frame ended before the requested byte count")
+        chunks.extend(block)
+    return bytes(chunks)
+
+
+def _recv_frame(connection: socket.socket) -> bytes | None:
+    payload, _ = _recv_frame_with_timing(connection)
+    return payload
+
+
+def _recv_frame_with_timing(
+    connection: socket.socket,
+) -> tuple[bytes | None, dict[str, float | int]]:
+    header_started = time.perf_counter()
+    header = _recv_exact(connection, _FRAME_HEADER.size)
+    header_finished = time.perf_counter()
+    if header is None:
+        return None, {
+            "request_header_wait_s": header_finished - header_started,
+            "request_payload_receive_s": 0.0,
+            "request_frame_receive_s": header_finished - header_started,
+            "request_frame_bytes": 0,
+        }
+    (size,) = _FRAME_HEADER.unpack(header)
+    if size <= 0 or size > _MAX_FRAME_BYTES:
+        raise ValueError(f"Invalid TCP frame size: {size}")
+    payload_started = time.perf_counter()
+    payload = _recv_exact(connection, size)
+    payload_finished = time.perf_counter()
+    if payload is None:
+        raise ConnectionError("TCP frame payload is missing")
+    return payload, {
+        "request_header_wait_s": header_finished - header_started,
+        "request_payload_receive_s": payload_finished - payload_started,
+        "request_frame_receive_s": payload_finished - header_started,
+        "request_frame_bytes": size,
+    }
+
+
+def _send_frame(connection: socket.socket, payload: bytes) -> None:
+    if not payload or len(payload) > _MAX_FRAME_BYTES:
+        raise ValueError(f"Invalid outbound TCP frame size: {len(payload)}")
+    connection.sendall(_FRAME_HEADER.pack(len(payload)) + payload)
+
+
+class LowJitterTcpPolicyServer(LowJitterWebsocketPolicyServer):
+    """Single-client-at-a-time TCP server using the established MsgPack schema."""
+
+    def __init__(
+        self,
+        *,
+        policy: Any,
+        host: str,
+        port: int,
+        idle_timeout: int = -1,
+        metadata: Mapping[str, Any] | None = None,
+    ) -> None:
+        super().__init__(
+            policy=policy,
+            host=host,
+            port=port,
+            idle_timeout=idle_timeout,
+            metadata=metadata,
+        )
+
+    def serve_forever(self) -> None:
+        import msgpack
+
+        packer = msgpack.Packer(default=_pack_array)
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as listener:
+            listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            listener.bind((self._host, self._port))
+            listener.listen(8)
+            listener.settimeout(5.0)
+            while True:
+                if self._idle_timeout > 0 and time.monotonic() - self._last_active > self._idle_timeout:
+                    return
+                try:
+                    connection, _ = listener.accept()
+                except TimeoutError:
+                    continue
+                with connection:
+                    connection.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+                    connection.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
+                    _send_frame(connection, packer.pack(self._metadata))
+                    while True:
+                        frame, receive_timing = _recv_frame_with_timing(connection)
+                        if frame is None:
+                            break
+                        received = time.perf_counter()
+                        message = msgpack.unpackb(frame, object_hook=_unpack_array)
+                        unpacked = time.perf_counter()
+                        self._last_active = time.monotonic()
+                        response = self._route_message(message)
+                        routed = time.perf_counter()
+                        timing = response.setdefault("timing", {})
+                        timing.update(
+                            {
+                                **receive_timing,
+                                "request_unpack_s": unpacked - received,
+                                "server_route_s": routed - unpacked,
+                                "response_pack_probe_s": 0.0,
+                            }
+                        )
+                        pack_started = time.perf_counter()
+                        packer.pack(response)
+                        timing["response_pack_probe_s"] = time.perf_counter() - pack_started
+                        _send_frame(connection, packer.pack(response))
+
+
+__all__ = [
+    "LowJitterTcpPolicyServer",
+    "_recv_exact",
+    "_recv_frame",
+    "_recv_frame_with_timing",
+    "_send_frame",
+]
