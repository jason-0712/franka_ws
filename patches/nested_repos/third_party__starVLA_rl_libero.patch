+"""Lightweight contract tests for the Qwen-VL LM-head bypass."""
+
+from __future__ import annotations
+
+import unittest
+from importlib.util import module_from_spec, spec_from_file_location
+from pathlib import Path
+from types import SimpleNamespace
+
+_MODULE_PATH = Path("examples/realRobots/Franka/rl/qwen_backbone_inference.py").resolve()
+_SPEC = spec_from_file_location("qwen_backbone_inference_under_test", _MODULE_PATH)
+assert _SPEC is not None and _SPEC.loader is not None
+_MODULE = module_from_spec(_SPEC)
+_SPEC.loader.exec_module(_MODULE)
+QwenBackboneInferenceError = _MODULE.QwenBackboneInferenceError
+install_qwen_lm_head_bypass = _MODULE.install_qwen_lm_head_bypass
+
+
+class _HiddenStates:
+    def __init__(self) -> None:
+        self.slice_key = None
+
+    def __getitem__(self, key):
+        self.slice_key = key
+        return "empty-logits"
+
+
+class _LMHead:
+    def forward(self, hidden_states):
+        return ("projected-logits", hidden_states)
+
+
+class QwenBackboneInferenceTest(unittest.TestCase):
+    def test_bypasses_only_lm_head_projection(self):
+        lm_head = _LMHead()
+        original_forward = lm_head.forward
+        interface = SimpleNamespace(model=SimpleNamespace(lm_head=lm_head))
+        hidden_states = _HiddenStates()
+
+        install_qwen_lm_head_bypass(interface)
+
+        self.assertEqual(lm_head.forward(hidden_states), "empty-logits")
+        self.assertEqual(hidden_states.slice_key, (Ellipsis, slice(None, 0, None)))
+        self.assertTrue(lm_head._qwengroot_lm_head_bypass_v1)
+        self.assertEqual(lm_head._qwengroot_original_forward, original_forward)
+
+    def test_missing_lm_head_fails_closed(self):
+        with self.assertRaisesRegex(QwenBackboneInferenceError, "model.lm_head.forward"):
+            install_qwen_lm_head_bypass(SimpleNamespace(model=object()))
+
+    def test_double_install_fails_closed(self):
+        interface = SimpleNamespace(model=SimpleNamespace(lm_head=_LMHead()))
+        install_qwen_lm_head_bypass(interface)
+
+        with self.assertRaisesRegex(QwenBackboneInferenceError, "already installed"):
+            install_qwen_lm_head_bypass(interface)
+
+
+if __name__ == "__main__":
+    unittest.main()
