@@ -0,0 +1,182 @@
+#!/usr/bin/env python3
+"""Small auditable WebSocket transport for latency-sensitive shadow policy calls."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import socket
+import time
+import traceback
+from typing import Any, Mapping
+
+import numpy as np
+
+
+def _pack_array(value: Any) -> Any:
+    if isinstance(value, (np.ndarray, np.generic)) and value.dtype.kind in {"V", "O", "c"}:
+        raise ValueError(f"Unsupported dtype: {value.dtype}")
+    if isinstance(value, np.ndarray):
+        return {
+            b"__ndarray__": True,
+            b"data": value.tobytes(),
+            b"dtype": value.dtype.str,
+            b"shape": value.shape,
+        }
+    if isinstance(value, np.generic):
+        return {
+            b"__npgeneric__": True,
+            b"data": value.item(),
+            b"dtype": value.dtype.str,
+        }
+    return value
+
+
+def _unpack_array(value: dict[Any, Any]) -> Any:
+    if b"__ndarray__" in value:
+        return np.ndarray(
+            buffer=value[b"data"],
+            dtype=np.dtype(value[b"dtype"]),
+            shape=value[b"shape"],
+        )
+    if b"__npgeneric__" in value:
+        return np.dtype(value[b"dtype"]).type(value[b"data"])
+    return value
+
+
+class LowJitterWebsocketPolicyServer:
+    """Single-process shadow transport with no per-request logging."""
+
+    def __init__(
+        self,
+        *,
+        policy: Any,
+        host: str,
+        port: int,
+        idle_timeout: int = -1,
+        metadata: Mapping[str, Any] | None = None,
+    ) -> None:
+        self._policy = policy
+        self._host = str(host)
+        self._port = int(port)
+        self._idle_timeout = int(idle_timeout)
+        self._metadata = dict(metadata or {})
+        self._last_active = time.monotonic()
+
+    def serve_forever(self) -> None:
+        asyncio.run(self.run())
+
+    async def run(self) -> None:
+        import websockets.asyncio.server
+
+        async with websockets.asyncio.server.serve(
+            self._handler,
+            self._host,
+            self._port,
+            compression=None,
+            max_size=None,
+            max_queue=1,
+            ping_interval=None,
+            ping_timeout=None,
+        ) as server:
+            logging.warning("Low-jitter shadow server listening on %s:%d", self._host, self._port)
+            if self._idle_timeout > 0:
+                await self._idle_watchdog(server)
+            else:
+                await server.serve_forever()
+
+    async def _idle_watchdog(self, server: Any) -> None:
+        while True:
+            await asyncio.sleep(5)
+            if time.monotonic() - self._last_active > self._idle_timeout:
+                server.close()
+                await server.wait_closed()
+                return
+
+    @staticmethod
+    def _configure_socket(websocket: Any) -> None:
+        transport = getattr(websocket, "transport", None)
+        sock = transport.get_extra_info("socket") if transport is not None else None
+        if sock is not None:
+            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+            sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
+
+    async def _handler(self, websocket: Any) -> None:
+        import msgpack
+        import websockets
+
+        self._configure_socket(websocket)
+        packer = msgpack.Packer(default=_pack_array)
+        await websocket.send(packer.pack(self._metadata))
+        while True:
+            try:
+                frame = await websocket.recv()
+                received = time.perf_counter()
+                if isinstance(frame, str):
+                    raise TypeError("Shadow transport accepts binary MsgPack frames only")
+                message = msgpack.unpackb(frame, object_hook=_unpack_array)
+                unpacked = time.perf_counter()
+                self._last_active = time.monotonic()
+                response = self._route_message(message)
+                routed = time.perf_counter()
+                timing = response.setdefault("timing", {})
+                timing.update(
+                    {
+                        "request_unpack_s": unpacked - received,
+                        "server_route_s": routed - unpacked,
+                        "response_pack_probe_s": 0.0,
+                    }
+                )
+                pack_started = time.perf_counter()
+                packer.pack(response)
+                timing["response_pack_probe_s"] = time.perf_counter() - pack_started
+                await websocket.send(packer.pack(response))
+            except websockets.ConnectionClosed:
+                return
+            except Exception:
+                await websocket.send(traceback.format_exc())
+                await websocket.close(code=1011, reason="Internal shadow transport error")
+                raise
+
+    def _route_message(self, message: Mapping[str, Any]) -> dict[str, Any]:
+        request_id = message.get("request_id", "default")
+        message_type = message.get("type", "infer")
+        payload = message.get("payload", message)
+        if message_type == "ping":
+            return {"status": "ok", "ok": True, "type": "ping", "request_id": request_id}
+        if message_type not in {"infer", "predict_action"}:
+            return {
+                "status": "error",
+                "ok": False,
+                "type": "unknown",
+                "request_id": request_id,
+                "error": {"message": f"Unsupported message type {message_type!r}"},
+            }
+        if not isinstance(payload, Mapping):
+            return {
+                "status": "error",
+                "ok": False,
+                "type": "inference_result",
+                "request_id": request_id,
+                "error": {"message": "Payload must be a mapping"},
+            }
+        try:
+            data = self._policy.predict_action(**dict(payload))
+        except Exception as exc:
+            return {
+                "status": "error",
+                "ok": False,
+                "type": "inference_result",
+                "request_id": request_id,
+                "error": {"message": str(exc)},
+            }
+        return {
+            "status": "ok",
+            "ok": True,
+            "type": "inference_result",
+            "request_id": request_id,
+            "data": data,
+        }
+
+
+__all__ = ["LowJitterWebsocketPolicyServer"]
