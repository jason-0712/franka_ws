+"""Framing tests for the low-jitter shadow TCP transport."""
+
+from __future__ import annotations
+
+import socket
+import unittest
+
+from examples.realRobots.Franka.rl.qwengroot_low_jitter_tcp_server import (
+    _recv_frame,
+    _recv_frame_with_timing,
+    _send_frame,
+)
+
+
+class LowJitterTcpTest(unittest.TestCase):
+    def test_roundtrips_one_length_prefixed_frame(self):
+        left, right = socket.socketpair()
+        try:
+            _send_frame(left, b"shadow-payload")
+            self.assertEqual(_recv_frame(right), b"shadow-payload")
+        finally:
+            left.close()
+            right.close()
+
+    def test_clean_close_returns_none_before_header(self):
+        left, right = socket.socketpair()
+        left.close()
+        try:
+            self.assertIsNone(_recv_frame(right))
+        finally:
+            right.close()
+
+    def test_timed_frame_reports_payload_size_and_nonnegative_stages(self):
+        left, right = socket.socketpair()
+        try:
+            _send_frame(left, b"timed-shadow-payload")
+            payload, timing = _recv_frame_with_timing(right)
+            self.assertEqual(payload, b"timed-shadow-payload")
+            self.assertEqual(timing["request_frame_bytes"], len(payload))
+            self.assertGreaterEqual(timing["request_header_wait_s"], 0.0)
+            self.assertGreaterEqual(timing["request_payload_receive_s"], 0.0)
+            self.assertGreaterEqual(timing["request_frame_receive_s"], 0.0)
+        finally:
+            left.close()
+            right.close()
+
+
+if __name__ == "__main__":
+    unittest.main()
