+"""Contract tests for the candidate-local low-jitter shadow transport."""
+
+from __future__ import annotations
+
+import unittest
+
+from examples.realRobots.Franka.rl.qwengroot_low_jitter_websocket_server import (
+    LowJitterWebsocketPolicyServer,
+)
+
+
+class _Policy:
+    def __init__(self) -> None:
+        self.calls = []
+
+    def predict_action(self, **payload):
+        self.calls.append(payload)
+        return {"action_execution": "NOT_RUN"}
+
+
+class LowJitterServerTest(unittest.TestCase):
+    def test_routes_ping_without_calling_policy(self):
+        policy = _Policy()
+        server = LowJitterWebsocketPolicyServer(policy=policy, host="127.0.0.1", port=10099)
+
+        response = server._route_message({"type": "ping", "request_id": "p0", "payload": {}})
+
+        self.assertTrue(response["ok"])
+        self.assertEqual(response["request_id"], "p0")
+        self.assertEqual(policy.calls, [])
+
+    def test_routes_prediction_payload_exactly_once(self):
+        policy = _Policy()
+        server = LowJitterWebsocketPolicyServer(policy=policy, host="127.0.0.1", port=10099)
+
+        response = server._route_message(
+            {"type": "predict_action", "request_id": "r0", "payload": {"mode": "shadow"}}
+        )
+
+        self.assertTrue(response["ok"])
+        self.assertEqual(response["data"]["action_execution"], "NOT_RUN")
+        self.assertEqual(policy.calls, [{"mode": "shadow"}])
+
+    def test_rejects_unknown_message_type(self):
+        server = LowJitterWebsocketPolicyServer(policy=_Policy(), host="127.0.0.1", port=10099)
+
+        response = server._route_message({"type": "execute", "request_id": "bad", "payload": {}})
+
+        self.assertFalse(response["ok"])
+        self.assertEqual(response["type"], "unknown")
+
+
+if __name__ == "__main__":
+    unittest.main()
