+_TCP_FRAME_HEADER = struct.Struct("!I")
+_TCP_MAX_FRAME_BYTES = 32 * 1024 * 1024
+
+
+def _tcp_recv_exact(connection: socket.socket, size: int) -> bytes:
+    chunks = bytearray()
+    while len(chunks) < size:
+        block = connection.recv(size - len(chunks))
+        if not block:
+            raise ShadowAdapterError("TCP policy connection closed mid-frame")
+        chunks.extend(block)
+    return bytes(chunks)
+
+
+def _tcp_recv_frame(connection: socket.socket) -> bytes:
+    payload, _ = _tcp_recv_frame_with_timing(connection)
+    return payload
+
+
+def _tcp_recv_frame_with_timing(connection: socket.socket) -> tuple[bytes, dict[str, float | int]]:
+    header_started = time.perf_counter()
+    (size,) = _TCP_FRAME_HEADER.unpack(_tcp_recv_exact(connection, _TCP_FRAME_HEADER.size))
+    header_finished = time.perf_counter()
+    _require(0 < size <= _TCP_MAX_FRAME_BYTES, f"Invalid TCP policy frame size: {size}")
+    payload_started = time.perf_counter()
+    payload = _tcp_recv_exact(connection, size)
+    payload_finished = time.perf_counter()
+    return payload, {
+        "response_header_wait_s": header_finished - header_started,
+        "response_payload_receive_s": payload_finished - payload_started,
+        "response_frame_receive_s": payload_finished - header_started,
+        "response_frame_bytes": size,
+    }
+
+
+def _tcp_send_frame(connection: socket.socket, payload: bytes) -> None:
+    _require(0 < len(payload) <= _TCP_MAX_FRAME_BYTES, f"Invalid outbound TCP frame size: {len(payload)}")
+    connection.sendall(_TCP_FRAME_HEADER.pack(len(payload)) + payload)
+
+
+class DirectShadowTcpClient:
+    """Persistent raw-TCP alternative using exactly the same MsgPack payloads."""
+
+    def __init__(self, *, host: str, port: int) -> None:
+        import msgpack
+
+        _require(bool(host.strip()), "Policy host must not be empty")
+        _require(1 <= port <= 65535, "Policy port must be within 1..65535")
+        self._msgpack = msgpack
+        self._packer = msgpack.Packer(default=_pack_array)
+        self._connection = socket.create_connection((host, port), timeout=30.0)
+        self._connection.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+        self._connection.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
+        metadata = _tcp_recv_frame(self._connection)
+        self._metadata = self._msgpack.unpackb(metadata, object_hook=_unpack_array)
+        self._last_transport_timing: dict[str, float | int] = {}
+        _require(isinstance(self._metadata, Mapping), "TCP shadow server metadata is invalid")
+
+    def get_server_metadata(self) -> Mapping[str, Any]:
+        return self._metadata
+
+    def predict_action(self, query_info: Mapping[str, Any]) -> Mapping[str, Any]:
+        total_started = time.perf_counter()
+        pack_started = time.perf_counter()
+        request_payload = self._packer.pack(dict(query_info))
+        pack_finished = time.perf_counter()
+        send_started = time.perf_counter()
+        _tcp_send_frame(self._connection, request_payload)
+        send_finished = time.perf_counter()
+        response_payload, receive_timing = _tcp_recv_frame_with_timing(self._connection)
+        unpack_started = time.perf_counter()
+        unpacked = self._msgpack.unpackb(response_payload, object_hook=_unpack_array)
+        unpack_finished = time.perf_counter()
+        self._last_transport_timing = {
+            "client_total_s": unpack_finished - total_started,
+            "request_pack_s": pack_finished - pack_started,
+            "request_send_s": send_finished - send_started,
+            "request_frame_bytes": len(request_payload),
+            **receive_timing,
+            "response_unpack_s": unpack_finished - unpack_started,
+        }
+        _require(isinstance(unpacked, Mapping), "TCP shadow server response is invalid")
+        return unpacked
+
+    def get_last_transport_timing(self) -> Mapping[str, float | int]:
+        return MappingProxyType(dict(self._last_transport_timing))
+
+    def close(self) -> None:
+        self._connection.close()
+
+
 def _require(condition: bool, message: str) -> None:
     if not condition:
         raise ShadowAdapterError(message)
