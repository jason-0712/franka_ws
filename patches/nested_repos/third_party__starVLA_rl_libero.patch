diff --git a/examples/realRobots/Franka/rl/benchmark_qwengroot_shadow_latency.py b/examples/realRobots/Franka/rl/benchmark_qwengroot_shadow_latency.py
new file mode 100644
index 0000000..6902c8a
--- /dev/null
+++ b/examples/realRobots/Franka/rl/benchmark_qwengroot_shadow_latency.py
@@ -0,0 +1,364 @@
+#!/usr/bin/env python3
+"""Benchmark deterministic QwenGR00T shadow latency and action parity offline."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import statistics
+import time
+from pathlib import Path
+from typing import Any, Mapping
+
+import numpy as np
+
+try:
+    from .franka_ros2_shadow_adapter import DirectShadowTcpClient, DirectShadowWebsocketClient
+except ImportError:  # Direct script execution in the robot container.
+    from franka_ros2_shadow_adapter import DirectShadowTcpClient, DirectShadowWebsocketClient
+
+
+SAFETY = "SHADOW_BENCHMARK_ONLY; NO_ROS; NO_ROBOT_COMMAND; NO_OPTIMIZER"
+ACTION_FIELDS = (
+    "policy_action_normalized_raw",
+    "policy_action_normalized",
+    "policy_action_physical",
+    "base_first_action",
+    "proposed_action",
+)
+
+
+class ShadowLatencyBenchmarkError(RuntimeError):
+    """Raised when latency inputs, server identity, or parity fail closed."""
+
+
+def _require(condition: bool, message: str) -> None:
+    if not condition:
+        raise ShadowLatencyBenchmarkError(message)
+
+
+def _percentile(values: list[float], fraction: float) -> float:
+    ordered = sorted(values)
+    index = min(len(ordered) - 1, max(0, round(fraction * (len(ordered) - 1))))
+    return ordered[index]
+
+
+def _summary(values: list[float]) -> dict[str, float]:
+    _require(bool(values), "Cannot summarize an empty latency sequence")
+    return {
+        "min": min(values),
+        "p50": statistics.median(values),
+        "p95": _percentile(values, 0.95),
+        "max": max(values),
+        "mean": statistics.mean(values),
+    }
+
+
+def _canonical_sha256(value: Any) -> str:
+    payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _load_episode_observations(episode: Path) -> list[dict[str, Any]]:
+    manifest = json.loads((episode / "manifest.json").read_text(encoding="utf-8"))
+    _require(manifest.get("episode_id") == episode.name, "Episode ID/path mismatch")
+    rows = [json.loads(line) for line in (episode / "transitions.jsonl").read_text().splitlines() if line]
+    _require(bool(rows), "Episode contains no transitions")
+    observations: list[dict[str, Any]] = []
+    for row in rows:
+        value = row["observation"]
+        observations.append(
+            {
+                "main_images": np.load(episode / value["main_image_ref"], allow_pickle=False)[None, ...],
+                "wrist_images": np.load(episode / value["wrist_image_ref"], allow_pickle=False)[None, ...],
+                "states": np.asarray(value["raw_state"], dtype=np.float32)[None, ...],
+                "task_descriptions": [row["task_description"]],
+            }
+        )
+    return observations
+
+
+def _action_record(data: Mapping[str, Any]) -> dict[str, Any]:
+    record: dict[str, Any] = {}
+    for field in ACTION_FIELDS:
+        value = np.asarray(data.get(field), dtype=np.float32)
+        _require(bool(np.isfinite(value).all()), f"{field} contains NaN/Inf")
+        record[field] = value.tolist()
+    return record
+
+
+def _max_abs(left: Mapping[str, Any], right: Mapping[str, Any]) -> float:
+    differences = []
+    for field in ACTION_FIELDS:
+        left_value = np.asarray(left[field], dtype=np.float32)
+        right_value = np.asarray(right[field], dtype=np.float32)
+        _require(left_value.shape == right_value.shape, f"Reference shape mismatch: {field}")
+        differences.append(float(np.max(np.abs(left_value - right_value), initial=0.0)))
+    return max(differences, default=0.0)
+
+
+def run(args: argparse.Namespace) -> dict[str, Any]:
+    episode = args.episode.expanduser().resolve()
+    _require(episode.is_dir() and not episode.is_symlink(), f"Invalid episode: {episode}")
+    _require(args.warmup_calls >= 0, "--warmup-calls must be non-negative")
+    _require(args.measured_calls > 0, "--measured-calls must be positive")
+    _require(args.p95_gate_ms > 0.0 and args.max_gate_ms > 0.0, "Latency gates must be positive")
+    observations = _load_episode_observations(episode)
+    reference = None
+    if args.reference_report is not None:
+        reference_report = json.loads(args.reference_report.read_text(encoding="utf-8"))
+        reference = reference_report.get("action_reference")
+        _require(isinstance(reference, list), "Reference report has no action_reference")
+        _require(len(reference) == len(observations), "Reference observation count mismatch")
+
+    client_class = DirectShadowTcpClient if args.transport == "tcp" else DirectShadowWebsocketClient
+    client = client_class(host=args.host, port=args.port)
+    metadata = dict(client.get_server_metadata())
+    policy_metadata = metadata.get("policy_metadata")
+    _require(isinstance(policy_metadata, Mapping), "Server policy metadata is missing")
+    _require(
+        policy_metadata.get("checkpoint_sha256") == args.checkpoint_sha256,
+        "Server checkpoint identity mismatch",
+    )
+    if args.expect_optimization is not None:
+        _require(
+            policy_metadata.get("inference_optimization") == args.expect_optimization,
+            "Server inference-optimization identity mismatch",
+        )
+
+    roundtrip_ms: list[float] = []
+    service_ms: list[float] = []
+    service_total_ms: list[float] = []
+    server_route_ms: list[float] = []
+    request_unpack_ms: list[float] = []
+    response_pack_ms: list[float] = []
+    tcp_timing_ms: dict[str, list[float]] = {
+        "client_total_ms": [],
+        "request_pack_ms": [],
+        "request_send_ms": [],
+        "response_header_wait_ms": [],
+        "response_payload_receive_ms": [],
+        "response_frame_receive_ms": [],
+        "response_unpack_ms": [],
+        "server_request_header_wait_ms": [],
+        "server_request_payload_receive_ms": [],
+        "server_request_frame_receive_ms": [],
+    }
+    measured_call_timings: list[dict[str, Any]] = []
+    measured_actions: list[dict[str, Any] | None] = [None] * len(observations)
+    total_calls = args.warmup_calls + args.measured_calls
+    try:
+        for call_index in range(total_calls):
+            observation_index = call_index % len(observations)
+            request = {
+                "type": "predict_action",
+                "request_id": f"latency-{args.port}-{call_index}",
+                "payload": {
+                    "env_obs": observations[observation_index],
+                    "residual_action": np.zeros((1, 6), dtype=np.float32),
+                    "mode": "shadow",
+                    "seed": args.seed,
+                },
+            }
+            started = time.perf_counter()
+            response = client.predict_action(request)
+            elapsed_ms = (time.perf_counter() - started) * 1000.0
+            _require(response.get("ok") is True, f"Policy request failed: {response}")
+            data = response.get("data")
+            _require(isinstance(data, Mapping), "Policy response data is missing")
+            action = _action_record(data)
+            if call_index >= args.warmup_calls:
+                roundtrip_ms.append(elapsed_ms)
+                timing = data.get("service_timing", {})
+                if isinstance(timing, Mapping) and "policy_predict_action_s" in timing:
+                    service_ms.append(float(timing["policy_predict_action_s"]) * 1000.0)
+                if isinstance(timing, Mapping) and "service_total_s" in timing:
+                    service_total_ms.append(float(timing["service_total_s"]) * 1000.0)
+                outer_timing = response.get("timing", {})
+                if isinstance(outer_timing, Mapping) and "server_route_s" in outer_timing:
+                    server_route_ms.append(float(outer_timing["server_route_s"]) * 1000.0)
+                if isinstance(outer_timing, Mapping) and "request_unpack_s" in outer_timing:
+                    request_unpack_ms.append(float(outer_timing["request_unpack_s"]) * 1000.0)
+                if isinstance(outer_timing, Mapping) and "response_pack_probe_s" in outer_timing:
+                    response_pack_ms.append(float(outer_timing["response_pack_probe_s"]) * 1000.0)
+                sample: dict[str, Any] = {
+                    "call_index": call_index,
+                    "observation_index": observation_index,
+                    "roundtrip_ms": elapsed_ms,
+                }
+                if args.transport == "tcp":
+                    client_timing = client.get_last_transport_timing()
+                    client_fields = {
+                        "client_total_s": "client_total_ms",
+                        "request_pack_s": "request_pack_ms",
+                        "request_send_s": "request_send_ms",
+                        "response_header_wait_s": "response_header_wait_ms",
+                        "response_payload_receive_s": "response_payload_receive_ms",
+                        "response_frame_receive_s": "response_frame_receive_ms",
+                        "response_unpack_s": "response_unpack_ms",
+                    }
+                    server_fields = {
+                        "request_header_wait_s": "server_request_header_wait_ms",
+                        "request_payload_receive_s": "server_request_payload_receive_ms",
+                        "request_frame_receive_s": "server_request_frame_receive_ms",
+                    }
+                    for source, target in client_fields.items():
+                        value = float(client_timing[source]) * 1000.0
+                        tcp_timing_ms[target].append(value)
+                        sample[target] = value
+                    for source, target in server_fields.items():
+                        value = float(outer_timing[source]) * 1000.0
+                        tcp_timing_ms[target].append(value)
+                        sample[target] = value
+                    sample["request_frame_bytes"] = int(client_timing["request_frame_bytes"])
+                    sample["response_frame_bytes"] = int(client_timing["response_frame_bytes"])
+                if isinstance(outer_timing, Mapping):
+                    for source, target in (
+                        ("request_unpack_s", "request_unpack_ms"),
+                        ("server_route_s", "server_route_ms"),
+                        ("response_pack_probe_s", "response_pack_probe_ms"),
+                    ):
+                        if source in outer_timing:
+                            sample[target] = float(outer_timing[source]) * 1000.0
+                measured_call_timings.append(sample)
+                if measured_actions[observation_index] is None:
+                    measured_actions[observation_index] = action
+                else:
+                    _require(
+                        _max_abs(measured_actions[observation_index], action) == 0.0,
+                        f"Repeated deterministic output changed for observation {observation_index}",
+                    )
+    finally:
+        client.close()
+
+    _require(all(value is not None for value in measured_actions), "Not every observation was measured")
+    action_reference = [value for value in measured_actions if value is not None]
+    reference_max_abs = None
+    if reference is not None:
+        reference_max_abs = max(
+            _max_abs(expected, actual)
+            for expected, actual in zip(reference, action_reference, strict=True)
+        )
+        _require(reference_max_abs <= args.parity_atol, f"Action parity failed: max_abs={reference_max_abs}")
+
+    roundtrip = _summary(roundtrip_ms)
+    latency_gate_pass = roundtrip["p95"] <= args.p95_gate_ms and roundtrip["max"] <= args.max_gate_ms
+    if args.require_latency_gate:
+        _require(latency_gate_pass, f"Latency gate failed: p95={roundtrip['p95']}, max={roundtrip['max']}")
+    report = {
+        "status": "PASS",
+        "safety": SAFETY,
+        "host": args.host,
+        "port": args.port,
+        "transport": args.transport,
+        "episode": str(episode),
+        "observation_count": len(observations),
+        "warmup_calls": args.warmup_calls,
+        "measured_calls": args.measured_calls,
+        "seed": args.seed,
+        "checkpoint_sha256": args.checkpoint_sha256,
+        "inference_optimization": policy_metadata.get("inference_optimization"),
+        "roundtrip_ms": roundtrip,
+        "service_policy_ms": _summary(service_ms) if service_ms else None,
+        "service_total_ms": _summary(service_total_ms) if service_total_ms else None,
+        "server_route_ms": _summary(server_route_ms) if server_route_ms else None,
+        "request_unpack_ms": _summary(request_unpack_ms) if request_unpack_ms else None,
+        "response_pack_probe_ms": _summary(response_pack_ms) if response_pack_ms else None,
+        "tcp_stage_ms": (
+            {name: _summary(values) for name, values in tcp_timing_ms.items()}
+            if args.transport == "tcp"
+            else None
+        ),
+        "measured_call_timings": measured_call_timings,
+        "transport_serialization_gap_ms_mean": (
+            statistics.mean(
+                roundtrip_value - service_value
+                for roundtrip_value, service_value in zip(
+                    roundtrip_ms,
+                    service_total_ms if len(service_total_ms) == len(roundtrip_ms) else service_ms,
+                    strict=True,
+                )
+            )
+            if len(service_total_ms) == len(roundtrip_ms) or len(service_ms) == len(roundtrip_ms)
+            else None
+        ),
+        "policy_wrapper_gap_ms_mean": (
+            statistics.mean(
+                total_value - policy_value
+                for total_value, policy_value in zip(service_total_ms, service_ms, strict=True)
+            )
+            if len(service_total_ms) == len(service_ms) == len(roundtrip_ms)
+            else None
+        ),
+        "client_minus_measured_server_ms_mean": (
+            statistics.mean(
+                roundtrip_value - unpack_value - route_value - pack_value
+                for roundtrip_value, unpack_value, route_value, pack_value in zip(
+                    roundtrip_ms,
+                    request_unpack_ms,
+                    server_route_ms,
+                    response_pack_ms,
+                    strict=True,
+                )
+            )
+            if len(request_unpack_ms) == len(server_route_ms) == len(response_pack_ms) == len(roundtrip_ms)
+            else None
+        ),
+        "latency_gate": {
+            "p95_max_ms": args.p95_gate_ms,
+            "absolute_max_ms": args.max_gate_ms,
+            "pass": latency_gate_pass,
+        },
+        "reference_report": str(args.reference_report.resolve()) if args.reference_report else None,
+        "reference_parity_atol": args.parity_atol,
+        "reference_max_abs": reference_max_abs,
+        "action_reference": action_reference,
+    }
+    report["action_reference_sha256"] = _canonical_sha256(action_reference)
+    return report
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--host", default="192.168.1.113")
+    parser.add_argument("--port", type=int, default=10098)
+    parser.add_argument("--transport", choices=("websocket", "tcp"), default="websocket")
+    parser.add_argument("--episode", type=Path, required=True)
+    parser.add_argument("--checkpoint-sha256", required=True)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--warmup-calls", type=int, default=5)
+    parser.add_argument("--measured-calls", type=int, default=30)
+    parser.add_argument("--p95-gate-ms", type=float, default=180.0)
+    parser.add_argument("--max-gate-ms", type=float, default=220.0)
+    parser.add_argument("--require-latency-gate", action="store_true")
+    parser.add_argument("--expect-optimization")
+    parser.add_argument("--reference-report", type=Path)
+    parser.add_argument("--parity-atol", type=float, default=0.0)
+    parser.add_argument("--report", type=Path, required=True)
+    return parser
+
+
+def main() -> int:
+    args = build_parser().parse_args()
+    try:
+        report = run(args)
+        exit_code = 0
+    except Exception as exc:
+        report = {
+            "status": "FAIL",
+            "error_type": type(exc).__name__,
+            "error": str(exc),
+            "safety": SAFETY,
+        }
+        exit_code = 1
+    rendered = json.dumps(report, indent=2, sort_keys=True)
+    print(rendered)
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_text(rendered + "\n", encoding="utf-8")
+    print(f"REPORT_PATH={args.report}")
+    return exit_code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
