@@ -0,0 +1,42 @@
+"""Inference-only Qwen-VL path that bypasses only the unused LM projection."""
+
+from __future__ import annotations
+
+from types import MethodType
+from typing import Any
+
+
+class QwenBackboneInferenceError(RuntimeError):
+    """Raised when the expected Qwen conditional-generation layout is absent."""
+
+
+def install_qwen_lm_head_bypass(qwen_vl_interface: Any) -> None:
+    """Keep the baseline Qwen forward exact while skipping unused logits.
+
+    StarVLA consumes ``CausalLMOutput.hidden_states[-1]`` and never reads
+    ``logits``.  Calling a nested Qwen backbone directly proved unsafe because
+    wrapper and Transformers versions can differ in how they prepare and
+    capture multimodal hidden states.  Instead, preserve the authoritative
+    conditional-generation forward byte-for-byte and replace only
+    ``lm_head.forward`` with a zero-compute empty view.
+    """
+
+    causal_model = getattr(qwen_vl_interface, "model", None)
+    lm_head = getattr(causal_model, "lm_head", None)
+    if lm_head is None or not callable(getattr(lm_head, "forward", None)):
+        raise QwenBackboneInferenceError("QwenGR00T fast path requires model.lm_head.forward")
+    if getattr(lm_head, "_qwengroot_lm_head_bypass_v1", False):
+        raise QwenBackboneInferenceError("Qwen LM-head bypass is already installed")
+
+    original_forward = lm_head.forward
+
+    def empty_logits_forward(lm_head_self: Any, hidden_states: Any) -> Any:
+        del lm_head_self
+        return hidden_states[..., :0]
+
+    lm_head._qwengroot_original_forward = original_forward
+    lm_head._qwengroot_lm_head_bypass_v1 = True
+    lm_head.forward = MethodType(empty_logits_forward, lm_head)
+
+
+__all__ = ["QwenBackboneInferenceError", "install_qwen_lm_head_bypass"]
