+    # Newer torchvision builds no longer expose ``torchvision.io.VideoReader``.
+    # Prefer PyAV when it is available so validation still checks the actual
+    # decoded frame count instead of reporting every valid video as empty.
+    try:
+        import av
+
+        with av.open(video_path) as container:
+            frame_count = sum(1 for _ in container.decode(video=0))
