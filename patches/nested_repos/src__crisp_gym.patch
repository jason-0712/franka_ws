+"""Regression tests for externally controlled streamed gripper recording."""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import numpy as np
+from crisp_py.utils.geometry import Pose
+from scipy.spatial.transform import Rotation
+
+from crisp_gym.envs.manipulator_env import ManipulatorBaseEnv, ManipulatorCartesianEnv
+from crisp_gym.envs.manipulator_env_config import ObservationKeys
+from crisp_gym.record.record_functions import make_teleop_streamer_fn
+from crisp_gym.util.gripper_mode import GripperMode
+
+
+class _CartesianStepHarness(ManipulatorCartesianEnv):
+    def __init__(self) -> None:
+        self.action_space = SimpleNamespace(shape=(7,))
+        self.config = SimpleNamespace(
+            use_relative_actions=True,
+            gripper_mode=GripperMode.ABSOLUTE_CONTINUOUS,
+            max_episode_steps=None,
+        )
+        self.robot = SimpleNamespace(
+            target_pose=Pose(np.zeros(3), Rotation.identity()),
+            set_target=Mock(),
+        )
+        self.timestep = 0
+        self._set_gripper_action = Mock()
+
+    @staticmethod
+    def action_to_rotation(action: np.ndarray) -> Rotation:
+        return Rotation.from_rotvec(action)
+
+    @staticmethod
+    def clip_position_for_safety(position: np.ndarray) -> np.ndarray:
+        return position
+
+    @staticmethod
+    def _get_obs() -> dict:
+        return {ObservationKeys.GRIPPER_OBS: np.array([0.25], dtype=np.float32)}
+
+
+def test_step_can_skip_command_without_disabling_feedback() -> None:
+    """Skipping commands must not switch off observation feedback."""
+    env = _CartesianStepHarness()
+    action = np.zeros(7, dtype=np.float32)
+
+    obs, *_ = env.step(action, block=False, control_gripper=False)
+
+    env._set_gripper_action.assert_not_called()
+    assert env.config.gripper_mode == GripperMode.ABSOLUTE_CONTINUOUS
+    np.testing.assert_array_equal(obs[ObservationKeys.GRIPPER_OBS], [0.25])
+
+
+def test_base_observation_reads_physical_gripper_feedback() -> None:
+    """The gripper observation must reflect physical joint feedback."""
+    env = object.__new__(ManipulatorBaseEnv)
+    env.config = SimpleNamespace(
+        gripper_mode=GripperMode.ABSOLUTE_CONTINUOUS,
+        observations_to_include_to_state=[ObservationKeys.GRIPPER_OBS],
+    )
+    env.robot = SimpleNamespace(
+        end_effector_pose=Pose(np.zeros(3), Rotation.identity()),
+    )
+    env.gripper = SimpleNamespace(value=0.25)
+    env.cameras = []
+    env.sensors = []
+    env.rotation_to_representation = lambda rotation: rotation.as_rotvec()
+
+    obs = ManipulatorBaseEnv._get_obs(env)
+
+    # The environment stores gripper closure: open=0, closed=1.
+    np.testing.assert_array_equal(obs[ObservationKeys.GRIPPER_OBS], [0.75])
+
+
+def test_streamer_forwards_external_control_flag() -> None:
+    """Streamed recording must forward the external-control setting."""
+    env = SimpleNamespace(
+        rotation_to_representation=lambda rotation: rotation.as_rotvec(),
+        step=Mock(return_value=({}, 0.0, False, False, {})),
+    )
+    leader = SimpleNamespace(
+        last_pose=Pose(np.zeros(3), Rotation.identity()),
+        last_gripper=0.0,
+    )
+    teleop_fn = make_teleop_streamer_fn(env, leader, control_gripper=False)
+
+    assert teleop_fn() == (None, None)
+    leader.last_pose = Pose(np.array([0.01, 0.0, 0.0]), Rotation.identity())
+    teleop_fn()
+
+    assert env.step.call_args.kwargs == {"block": False, "control_gripper": False}
