+    def _handle_char(self, char: str | None) -> None:
+        """Apply a keyboard command character to the recording state."""
+        if char is None:
+            return
+
+        char = char.lower()
+        old_state = self.state
+        if self.state == "is_waiting":
+            if char == "r":
+                self.state = "recording"
+            if char == "q":
+                self.state = "exit"
+        elif self.state == "recording":
+            if char == "r":
+                self.state = "paused"
+        elif self.state == "paused":
+            if char == "q":
+                self.state = "exit"
+            if char == "s":
+                self.state = "to_be_saved"
+            if char == "d":
+                self.state = "to_be_deleted"
+
+        if char in {"r", "s", "d", "q"}:
+            logger.info(f"Keyboard command received: {char} ({old_state} -> {self.state})")
+
+    def _poll_stdin_once(self) -> None:
+        """Poll the recorder terminal once for a single keypress."""
+        if not sys.stdin.isatty():
+            return
+        readable, _, _ = select.select([sys.stdin], [], [], 0.0)
+        if readable:
+            char = sys.stdin.read(1)
+            self._handle_char(char)
+
+    def _stdin_loop(self) -> None:
+        """Fallback listener for terminals where pynput cannot receive key events."""
+        while not self._stdin_stop.is_set():
+            self._poll_stdin_once()
+            time.sleep(0.05)
