+            self._stdin_thread = threading.Thread(target=self._stdin_loop, daemon=True)
+            self._stdin_thread.start()
+            logger.info("Keyboard stdin fallback enabled. Press r/s/d/q in this terminal.")
+        else:
+            logger.warning(
+                "Keyboard stdin fallback disabled because stdin is not a TTY. "
