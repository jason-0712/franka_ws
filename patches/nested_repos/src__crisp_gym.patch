+++ b/crisp_gym/scripts/convert_lerobot_abs_joint_to_delta_joint.py
@@ -0,0 +1,307 @@
+#!/usr/bin/env python3
+"""Convert CRISP Franka LeRobot datasets from absolute joint actions to deltas.
+
+The original CRISP Franka recorder stores an 8-D action:
+
+    [target_joint_0, ..., target_joint_6, gripper]
+
+This script writes a separate dataset root whose action is:
+
+    [delta_joint_0, ..., delta_joint_6, gripper]
+
+where delta_joint[t] = target_joint[t + 1] - target_joint[t]. The final frame
+has zero joint deltas because there is no next target.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import shutil
+from pathlib import Path
+from typing import Iterable
+
+import numpy as np
+import pandas as pd
+
+
+DEFAULT_DATASETS = [
+    "franka_test_135",
+    "franka_test_136",
+    "franka_test_137",
+    "franka_test_139",
+    "franka_test_140",
+    "franka_test_141",
+    "franka_test_144",
+    "franka_test_146",
+    "franka_test_148",
+    "franka_test_149",
+    "franka_test_150",
+    "franka_test_151",
+    "franka_test_152",
+    "franka_test_153",
+    "franka_test_154",
+    "franka_test_155",
+    "franka_test_156",
+    "franka_test_157",
+    "franka_test_158",
+    "franka_test_161",
+]
+
+
+DELTA_MODALITY = {
+    "state": {
+        "joints": {
+            "start": 7,
+            "end": 14,
+            "original_key": "observation.state",
+        },
+        "gripper": {
+            "start": 6,
+            "end": 7,
+            "original_key": "observation.state",
+        },
+    },
+    "action": {
+        "delta_joints": {
+            "start": 0,
+            "end": 7,
+            "original_key": "action",
+            "absolute": False,
+        },
+        "gripper": {
+            "start": 7,
+            "end": 8,
+            "original_key": "action",
+            "absolute": True,
+        },
+    },
+    "video": {
+        "primary_image": {
+            "original_key": "observation.images.primary",
+        },
+    },
+    "annotation": {
+        "human.action.task_description": {
+            "original_key": "task_index",
+        },
+    },
+}
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="Create a delta-joint copy of CRISP Franka LeRobot datasets."
+    )
+    parser.add_argument(
+        "--input-root",
+        type=Path,
+        required=True,
+        help="Directory containing the original franka_test_* datasets.",
+    )
+    parser.add_argument(
+        "--output-root",
+        type=Path,
+        required=True,
+        help="Directory where converted datasets will be written.",
+    )
+    parser.add_argument(
+        "--datasets",
+        nargs="+",
+        default=DEFAULT_DATASETS,
+        help="Dataset directory names to convert.",
+    )
+    parser.add_argument(
+        "--overwrite",
+        action="store_true",
+        help="Replace existing output dataset directories.",
+    )
+    parser.add_argument(
+        "--media-mode",
+        choices=["copy", "symlink"],
+        default="copy",
+        help="Copy or symlink images/videos directories into the output dataset.",
+    )
+    parser.add_argument(
+        "--max-abs-delta",
+        type=float,
+        default=None,
+        help="Optional symmetric clip for joint deltas in radians.",
+    )
+    return parser.parse_args()
+
+
+def copy_dataset_tree(src: Path, dst: Path, media_mode: str) -> None:
+    dst.mkdir(parents=True, exist_ok=False)
+    media_dirs = {"images", "videos"}
+    for child in src.iterdir():
+        target = dst / child.name
+        if child.is_dir():
+            if child.name in media_dirs and media_mode == "symlink":
+                target.symlink_to(child.resolve(), target_is_directory=True)
+            else:
+                shutil.copytree(child, target, symlinks=True)
+        else:
+            shutil.copy2(child, target)
+
+
+def load_json(path: Path) -> dict:
+    with path.open("r", encoding="utf-8") as f:
+        return json.load(f)
+
+
+def write_json(path: Path, data: dict) -> None:
+    with path.open("w", encoding="utf-8") as f:
+        json.dump(data, f, indent=2)
+        f.write("\n")
+
+
+def stat_block(values: np.ndarray) -> dict:
+    return {
+        "min": values.min(axis=0).astype(float).tolist(),
+        "max": values.max(axis=0).astype(float).tolist(),
+        "mean": values.mean(axis=0).astype(float).tolist(),
+        "std": values.std(axis=0).astype(float).tolist(),
+        "count": [int(values.shape[0])],
+    }
+
+
+def update_episode_stats(stats_path: Path, action_stats_by_episode: dict[int, dict]) -> None:
+    if not stats_path.exists():
+        return
+
+    updated_lines = []
+    with stats_path.open("r", encoding="utf-8") as f:
+        for line in f:
+            if not line.strip():
+                continue
+            entry = json.loads(line)
+            episode_index = int(entry.get("episode_index", 0))
+            if episode_index in action_stats_by_episode:
+                entry.setdefault("stats", {})["action"] = action_stats_by_episode[episode_index]
+            updated_lines.append(entry)
+
+    with stats_path.open("w", encoding="utf-8") as f:
+        for entry in updated_lines:
+            f.write(json.dumps(entry) + "\n")
+
+
+def remove_starvla_caches(meta_dir: Path) -> None:
+    cache_names = [
+        "statistics.json",
+        "dataset_statistics.json",
+        "steps_data_index.pkl",
+        "episode_data_index.safetensors",
+    ]
+    for name in cache_names:
+        path = meta_dir / name
+        if path.exists():
+            path.unlink()
+
+
+def parquet_paths(dataset_dir: Path) -> Iterable[Path]:
+    return sorted((dataset_dir / "data").glob("chunk-*/episode_*.parquet"))
+
+
+def convert_parquet(path: Path, max_abs_delta: float | None) -> tuple[int, dict, float]:
+    df = pd.read_parquet(path)
+    if "action" not in df.columns:
+        raise KeyError(f"{path} has no 'action' column")
+
+    action = np.stack(df["action"].to_numpy()).astype(np.float32)
+    if action.ndim != 2 or action.shape[1] != 8:
+        raise ValueError(f"{path} action shape is {action.shape}, expected (N, 8)")
+
+    delta_action = np.zeros_like(action, dtype=np.float32)
+    if action.shape[0] > 1:
+        delta_action[:-1, :7] = action[1:, :7] - action[:-1, :7]
+    delta_action[:, 7] = action[:, 7]
+
+    if max_abs_delta is not None:
+        delta_action[:, :7] = np.clip(delta_action[:, :7], -max_abs_delta, max_abs_delta)
+
+    df["action"] = [row for row in delta_action]
+    df.to_parquet(path, index=False)
+
+    episode_index = int(df["episode_index"].iloc[0]) if "episode_index" in df.columns else 0
+    max_delta = float(np.max(np.abs(delta_action[:, :7]))) if delta_action.size else 0.0
+    return episode_index, stat_block(delta_action), max_delta
+
+
+def update_info_json(dataset_dir: Path) -> None:
+    info_path = dataset_dir / "meta" / "info.json"
+    if not info_path.exists():
+        return
+
+    info = load_json(info_path)
+    action_feature = info.get("features", {}).get("action")
+    if action_feature:
+        action_feature["names"] = [
+            "delta_joint_0",
+            "delta_joint_1",
+            "delta_joint_2",
+            "delta_joint_3",
+            "delta_joint_4",
+            "delta_joint_5",
+            "delta_joint_6",
+            "gripper",
+        ]
+    write_json(info_path, info)
+
+
+def convert_dataset(src: Path, dst: Path, args: argparse.Namespace) -> None:
+    if not src.exists():
+        raise FileNotFoundError(src)
+
+    if dst.exists():
+        if not args.overwrite:
+            raise FileExistsError(f"{dst} already exists; pass --overwrite to replace it")
+        shutil.rmtree(dst)
+
+    copy_dataset_tree(src, dst, args.media_mode)
+
+    action_stats_by_episode = {}
+    max_deltas = []
+    for path in parquet_paths(dst):
+        episode_index, action_stats, max_delta = convert_parquet(path, args.max_abs_delta)
+        action_stats_by_episode[episode_index] = action_stats
+        max_deltas.append(max_delta)
+
+    meta_dir = dst / "meta"
+    meta_dir.mkdir(exist_ok=True)
+    update_episode_stats(meta_dir / "episodes_stats.jsonl", action_stats_by_episode)
+    update_info_json(dst)
+    write_json(meta_dir / "modality.json", DELTA_MODALITY)
+    remove_starvla_caches(meta_dir)
+    write_json(
+        meta_dir / "delta_conversion.json",
+        {
+            "source_dataset": str(src),
+            "formula": "action_delta[t, :7] = action_abs[t + 1, :7] - action_abs[t, :7]; last delta is zero; gripper copied from action_abs[t, 7]",
+            "max_abs_delta_clip": args.max_abs_delta,
+            "media_mode": args.media_mode,
+        },
+    )
+
+    print(
+        f"{src.name}: converted {len(action_stats_by_episode)} episode(s), "
+        f"max |joint delta|={max(max_deltas) if max_deltas else 0.0:.6f}"
+    )
+
+
+def main() -> None:
+    args = parse_args()
+    args.output_root.mkdir(parents=True, exist_ok=True)
+
+    for dataset_name in args.datasets:
+        convert_dataset(
+            args.input_root / dataset_name,
+            args.output_root / dataset_name,
+            args,
+        )
+
+    print(f"Done. Delta datasets are in: {args.output_root}")
+
+
+if __name__ == "__main__":
+    main()
