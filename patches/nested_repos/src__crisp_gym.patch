+            )
         return super().__enter__()
 
     def __exit__(self, exc_type, exc_value, traceback) -> None:  # noqa: ANN001, D105
+        self._stdin_stop.set()
+        if self._stdin_thread is not None:
+            self._stdin_thread.join(timeout=1.0)
+        if self._stdin_settings is not None:
+            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self._stdin_settings)
         self.listener.stop()
         super().__exit__(exc_type, exc_value, traceback)
 
