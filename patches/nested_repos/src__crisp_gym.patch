@@ -0,0 +1,304 @@
+"""ROS2 joint-control teleop node with internal spin thread."""
+
+import threading
+
+import numpy as np
+import rclpy
+import rclpy.executors
+from rclpy.node import Node
+from scipy.spatial.transform import Rotation as R
+from std_msgs.msg import Float64MultiArray
+from crisp_py.gripper.gripper import make_gripper
+from crisp_py.robot import make_robot
+from crisp_py.utils.geometry import Pose
+from crisp_py.robot import Robot
+from crisp_py.utils.geometry import OrientationRepresentation
+from crisp_py.gripper import Gripper, GripperConfig
+from rclpy.callback_groups import ReentrantCallbackGroup
+from rclpy.qos import qos_profile_sensor_data
+
+import time
+class JointControlNode(Node):
+    def __init__(self, robot: Robot | None = None, gripper: Gripper | None = None):
+        super().__init__('joint_control_node')
+        self.robot = robot if robot is not None else make_robot("fr3")
+        self.robot.wait_until_ready()
+        self.home_config: list =  [
+                0,
+                - 8 * np.pi / 16,
+                0,
+                -15 * np.pi / 16,
+                0,
+                6 * np.pi / 8,
+                np.pi / 4,
+            ]
+        if robot is None:
+            self.robot.home(home_config=self.home_config)
+        # Do not call ControllerSwitcherClient here. On the real Franka setup,
+        # /controller_manager/list_controllers can stop responding while the
+        # arm topics are still healthy, and the switch helper waits forever.
+        # The controller launch should prepare joint_impedance_controller before
+        # leader-arm teleop starts.
+        self.get_logger().info(
+            "Skipping blocking controller switch; assuming joint_impedance_controller "
+            "is already ready for /target_joint."
+        )
+        self.gripper = gripper if gripper is not None else make_gripper("gripper_franka")
+        # config = GripperConfig(
+        # min_value=1046.0, 
+        # max_value=2065.0, 
+        # joint_state_topic="/gripper/joint_states",
+        # command_topic="/gripper/gripper_position_controller/commands",
+        # # enable_torque_service="TODO/set_torque",
+        # )
+        # self.gripper = Gripper(gripper_config=config)
+        if self.gripper is not None:
+            self.gripper.wait_until_ready()
+
+        # self.gripper.wait_until_ready()
+        # self.gripper.config.min_value=0.1046
+        # self.gripper.config.max_value=0.2065
+
+        # self.gripper.config.min_delta = 0.0
+        if self.gripper is not None:
+            self.gripper.config.max_delta = 1.0
+            self.gripper.set_target(1.0)
+        self.gripper_command_publisher = self.create_publisher(
+            Float64MultiArray,
+            "/gripper/gripper_position_controller/commands",
+            10,
+        )
+        self._last_gripper = 1.0
+        # 记录初始角度（零点）
+        self.initial_angles = None
+        self.first_frame = True
+        self.subscription = self.create_subscription(
+            Float64MultiArray,
+            "servo_angles",
+            self.listener_callback,
+            10,
+        )
+        self.prev_angles = None
+        self.filtered_angles = None
+        self.home_joint_values = self.robot.joint_values
+        self.filtered_joint_target = None
+        self.commanded_joint_velocity = None
+        self.target_joint = None
+        self.command_period = 0.01
+        self.max_joint_velocity = 0.8
+        self.max_joint_acceleration = 1.2
+        self.angle_smoothing_alpha = 0.45
+        self.angle_deadband_deg = 0.02
+        self.joint_target_tolerance = 0.002
+        self._last_pose: Pose | None = None
+        self._last_gripper: float | None = 1.0
+        self.last_action = None
+        # 标记节点是否运行
+        self.is_running = True
+        self.current_gripper_state = None  # 记录当前夹爪状态：0=关闭，1=打开
+        self.gripper_settle_time = 0.1     # 夹爪执行稳定时间（秒）
+        self.last_gripper_cmd_time = 0     # 上次发送夹爪指令的时间
+        self.pending_gripper_target = None
+        self.pending_gripper_until = 0.0
+        self.last_end_pose = None
+        self._executor = rclpy.executors.MultiThreadedExecutor(num_threads=2)
+        self._executor.add_node(self)
+        self._spin_thread = threading.Thread(target=self._spin_node, daemon=True)
+        self._spin_thread.start()
+        self.command_timer = self.create_timer(self.command_period, self._publish_joint_target)
+
+    def _spin_node(self):
+        while rclpy.ok() and self.is_running:
+            self._executor.spin_once(timeout_sec=0.1)
+
+    @property
+    def last_pose(self) -> Pose:
+        """Get the last received pose.
+
+        Returns:
+            Pose | None: The last received pose or None if no pose has been received yet.
+        """
+        if self._last_pose is None:
+            raise RuntimeError(
+                f"No pose received yet. Is the teleop device running? Check with 'ros2 topic echo {self._pose_topic}'"
+            )
+        return self._last_pose
+    @property
+    def last_gripper(self) -> float:
+        """Get the last received gripper value.
+
+        Returns:
+            float | None: The last received gripper value or None if no gripper value has been received yet.
+        """
+        if self._last_gripper is None:
+            raise RuntimeError("No gripper value received yet. Is the teleop device running?")
+        return self._last_gripper
+    
+    def listener_callback(self, msg):
+        self._last_pose = self.robot.end_effector_pose
+        if len(msg.data) < 8:
+            self.get_logger().warn(
+                f"Skipping /servo_angles message with {len(msg.data)} values; expected 8."
+            )
+            return
+
+        angles = np.asarray(msg.data[:7], dtype=float)
+        gripper = msg.data[-1]
+        current_time = time.time()
+        target_gripper = 0.0 if gripper >= 300 else 1.0
+        # 处理夹爪
+        if (self.current_gripper_state != target_gripper and
+            current_time - self.last_gripper_cmd_time > self.gripper_settle_time):
+            if target_gripper == 0.0:
+                print("Close gripper (stable)")
+                if self.gripper is not None:
+                    self.gripper.set_target(0.0)
+                self._publish_gripper_command(0.0)
+                self._last_gripper = 0.0
+            else:
+                print("Open gripper (stable)")
+                if self.gripper is not None:
+                    self.gripper.set_target(1.0)
+                self._publish_gripper_command(1.0)
+                self._last_gripper = 1.0
+            
+            # 更新状态和时间戳
+            self.current_gripper_state = target_gripper
+            self.last_gripper_cmd_time = current_time
+        
+        if self.first_frame:
+            self.initial_angles = angles.copy()
+            self.filtered_angles = angles.copy()
+            self.first_frame = False
+            self.prev_angles = angles.copy()
+            return
+
+        self.filtered_angles += self.angle_smoothing_alpha * (angles - self.filtered_angles)
+        angle_delta = self.filtered_angles - self.initial_angles
+        angle_delta[np.abs(angle_delta) < self.angle_deadband_deg] = 0.0
+        angle_delta_rad = np.deg2rad(angle_delta)
+        angle_delta_rad[3] *= -1
+
+        home_joint_values = np.asarray(self.home_joint_values, dtype=float).reshape(-1)
+        if home_joint_values.shape[0] != 7:
+            self.get_logger().warn(
+                f"Skipping servo target because home_joint_values has shape "
+                f"{home_joint_values.shape}; expected 7 joints."
+            )
+            self.reset()
+            return
+
+        self.target_joint = home_joint_values + angle_delta_rad
+        self.prev_angles = angles.copy()
+        self.last_action = np.concatenate(
+            [np.asarray(self.target_joint, dtype=float).reshape(-1), [self._last_gripper]]
+        )
+
+        self.last_end_pose = self.robot.end_effector_pose
+        # self.get_logger().info(f'Target joint: {q_new}')
+
+    def _publish_gripper_command(self, target: float):
+        msg = Float64MultiArray()
+        msg.data = [float(target)]
+        self.gripper_command_publisher.publish(msg)
+        self.pending_gripper_target = float(target)
+        self.pending_gripper_until = time.time() + 1.0
+        self.get_logger().info(f"Published gripper command: {target}")
+
+    def _publish_joint_target(self):
+        if (
+            self.pending_gripper_target is not None
+            and time.time() < self.pending_gripper_until
+        ):
+            msg = Float64MultiArray()
+            msg.data = [self.pending_gripper_target]
+            self.gripper_command_publisher.publish(msg)
+
+        if self.target_joint is None:
+            return
+        if self.filtered_joint_target is None:
+            joint_values = np.asarray(self.robot.joint_values, dtype=float).reshape(-1)
+            if joint_values.shape[0] != 7:
+                self.get_logger().warn(
+                    f"Skipping joint target publish because robot.joint_values has shape "
+                    f"{joint_values.shape}; expected 7 joints."
+                )
+                return
+            self.filtered_joint_target = joint_values.copy()
+        if self.commanded_joint_velocity is None:
+            self.commanded_joint_velocity = np.zeros_like(self.filtered_joint_target)
+
+        position_error = self.target_joint - self.filtered_joint_target
+        close_to_target = np.abs(position_error) < self.joint_target_tolerance
+        if np.all(close_to_target):
+            self.commanded_joint_velocity[:] = 0.0
+            self.filtered_joint_target = self.target_joint.copy()
+            self.robot.set_target_joint(self.filtered_joint_target)
+            self.last_action = np.concatenate(
+                [np.asarray(self.filtered_joint_target, dtype=float).reshape(-1), [self._last_gripper]]
+            )
+            return
+
+        braking_velocity = np.sqrt(2.0 * self.max_joint_acceleration * np.abs(position_error))
+        desired_velocity = np.sign(position_error) * np.minimum(
+            self.max_joint_velocity,
+            braking_velocity,
+        )
+        desired_velocity[close_to_target] = 0.0
+        max_velocity_delta = self.max_joint_acceleration * self.command_period
+        velocity_delta = np.clip(
+            desired_velocity - self.commanded_joint_velocity,
+            -max_velocity_delta,
+            max_velocity_delta,
+        )
+        self.commanded_joint_velocity += velocity_delta
+        step = self.commanded_joint_velocity * self.command_period
+        overshoot = np.abs(step) > np.abs(position_error)
+        step[overshoot] = position_error[overshoot]
+        self.filtered_joint_target += step
+        self.robot.set_target_joint(self.filtered_joint_target)
+        self.last_action = np.concatenate(
+            [np.asarray(self.filtered_joint_target, dtype=float).reshape(-1), [self._last_gripper]]
+        )
+
+    def reset(self):
+        """Reset the internal state of the teleop node."""
+        self.first_frame = True
+        self.initial_angles = None
+        self.prev_angles = None
+        self.filtered_angles = None
+        self.last_action = None
+        joint_values = np.asarray(self.robot.joint_values, dtype=float).reshape(-1)
+        if joint_values.shape[0] != 7:
+            self.get_logger().warn(
+                f"Cannot reset servo teleop from robot.joint_values with shape "
+                f"{joint_values.shape}; keeping previous home joint values."
+            )
+            self.filtered_joint_target = None
+            self.commanded_joint_velocity = None
+            self.target_joint = None
+            return
+        self.home_joint_values = joint_values
+        self.filtered_joint_target = self.home_joint_values.copy()
+        self.commanded_joint_velocity = np.zeros_like(self.home_joint_values)
+        self.target_joint = None
+
+    def prepare_for_teleop(self, home: bool = True):
+        """Prepare the follower robot for servo-angle joint teleoperation."""
+        self.robot.reset_targets()
+        if home:
+            self.robot.home(home_config=self.home_config)
+        # Avoid blocking on /controller_manager/list_controllers here. The real
+        # Franka setup can have healthy /joint_states and /target_joint topics
+        # while the controller manager service call does not return.
+        self.get_logger().info(
+            "Skipping blocking controller switch in prepare_for_teleop; "
+            "using the current /target_joint subscriber setup."
+        )
+        self.reset()
+
+    def stop(self):
+        """停止节点并清理资源"""
+        self.is_running = False
+        self._executor.shutdown()
+        self.destroy_node()
