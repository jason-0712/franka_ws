@@ -0,0 +1,615 @@
+"""Adapt Quest 3 controller pose/buttons to Franka delta end-pose commands.
+
+The Franka recorder already knows how to consume `/phone_pose` and
+`/phone_gripper` through `TeleopStreamedPose`. This adapter keeps the Quest side
+separate from the Franka command path by default: it converts controller deltas
+into a virtual streamed pose, while the recorder/environment still owns robot
+control. It also publishes an explicit 7D delta end-pose action stream and can
+optionally publish absolute `/target_pose` commands for direct
+`cartesian_impedance_controller` bringup.
+"""
+
+from __future__ import annotations
+
+import time
+
+import numpy as np
+import rclpy
+from geometry_msgs.msg import PoseStamped
+from rclpy.executors import ExternalShutdownException
+from rclpy.node import Node
+from scipy.spatial.transform import Rotation
+from sensor_msgs.msg import Joy
+from std_msgs.msg import Float32
+from std_msgs.msg import Float64MultiArray
+from std_msgs.msg import String
+
+
+def _button_pressed(msg: Joy, index: int) -> bool:
+    """Return whether a Joy button is pressed; negative index disables it."""
+    return index >= 0 and index < len(msg.buttons) and msg.buttons[index] == 1
+
+
+def _axis_pressed(msg: Joy, index: int, threshold: float) -> bool:
+    """Return whether a Joy axis crosses the configured threshold."""
+    return index >= 0 and index < len(msg.axes) and msg.axes[index] < threshold
+
+
+def _clip_vector_norm(vector: np.ndarray, max_norm: float) -> np.ndarray:
+    """Clip a vector by total norm while preserving direction."""
+    if max_norm <= 0.0:
+        return np.zeros_like(vector)
+
+    norm = float(np.linalg.norm(vector))
+    if norm <= max_norm or norm == 0.0:
+        return vector
+    return vector * (max_norm / norm)
+
+
+def _parse_axis_selector(selector: str) -> tuple[int, float]:
+    """Parse an axis selector such as x, -y, or z."""
+    cleaned = selector.strip().lower()
+    sign = -1.0 if cleaned.startswith("-") else 1.0
+    axis = cleaned[1:] if cleaned.startswith("-") else cleaned
+    axis_to_index = {"x": 0, "y": 1, "z": 2}
+    if axis not in axis_to_index:
+        raise ValueError(
+            f"Invalid axis selector '{selector}'. Use x, y, z, or a negative axis."
+        )
+    return axis_to_index[axis], sign
+
+
+def _axis_mapping_matrix(selectors: list[str], signs: np.ndarray) -> np.ndarray:
+    """Build a signed permutation matrix from Quest axes to Franka base axes."""
+    matrix = np.zeros((3, 3), dtype=float)
+    for out_axis, selector in enumerate(selectors):
+        in_axis, selector_sign = _parse_axis_selector(selector)
+        matrix[out_axis, in_axis] = selector_sign * signs[out_axis]
+    return matrix
+
+
+def _parse_matrix_param(value: str) -> np.ndarray | None:
+    """Parse a row-major 3x3 matrix from a ROS string parameter."""
+    value = value.strip()
+    if not value:
+        return None
+
+    parts = value.replace(",", " ").split()
+    if len(parts) != 9:
+        raise ValueError(
+            "quest_to_franka_matrix must contain 9 row-major numbers, "
+            f"got {len(parts)} values."
+        )
+    return np.asarray([float(part) for part in parts], dtype=float).reshape(3, 3)
+
+
+def _rotation_from_pose(msg: PoseStamped) -> Rotation | None:
+    """Read a valid scipy rotation from a PoseStamped message."""
+    quat = np.array(
+        [
+            msg.pose.orientation.x,
+            msg.pose.orientation.y,
+            msg.pose.orientation.z,
+            msg.pose.orientation.w,
+        ],
+        dtype=float,
+    )
+    if np.linalg.norm(quat) < 1e-6:
+        return None
+    return Rotation.from_quat(quat)
+
+
+def _pose_to_arrays(msg: PoseStamped) -> tuple[np.ndarray, Rotation | None]:
+    """Read position and orientation from a PoseStamped."""
+    position = np.array(
+        [msg.pose.position.x, msg.pose.position.y, msg.pose.position.z],
+        dtype=float,
+    )
+    return position, _rotation_from_pose(msg)
+
+
+def _rotation_to_action(rotation: Rotation, representation: str) -> np.ndarray:
+    """Convert a delta rotation to the configured action representation."""
+    if representation == "euler_xyz":
+        return rotation.as_euler("xyz")
+    if representation == "rotvec":
+        return rotation.as_rotvec()
+    raise ValueError("rotation_representation must be 'euler_xyz' or 'rotvec'.")
+
+
+class Quest3StreamAdapter(Node):
+    """Convert Quest controller topics into delta end-pose teleop commands."""
+
+    def __init__(self) -> None:
+        super().__init__("quest3_stream_adapter")
+
+        self.declare_parameter("quest_pose_topic", "/quest/right_controller/pose")
+        self.declare_parameter("quest_joy_topic", "/quest/right_controller/joy")
+        self.declare_parameter("output_pose_topic", "/phone_pose")
+        self.declare_parameter("output_gripper_topic", "/phone_gripper")
+        self.declare_parameter(
+            "output_delta_action_topic",
+            "/quest/right_controller/delta_end_pose",
+        )
+        self.declare_parameter("franka_gripper_command_topic", "")
+        self.declare_parameter("publish_target_pose", False)
+        self.declare_parameter("target_pose_topic", "/target_pose")
+        self.declare_parameter("current_pose_topic", "/current_pose")
+        self.declare_parameter("output_frame_id", "quest3_virtual")
+        self.declare_parameter("target_frame_id", "base")
+        self.declare_parameter("deadman_button", 4)
+        self.declare_parameter("deadman_latch_button", -1)
+        self.declare_parameter("reset_button", 0)
+        self.declare_parameter("pause_button", 1)
+        self.declare_parameter("gripper_button", -1)
+        self.declare_parameter("trigger_axis", 5)
+        self.declare_parameter("trigger_threshold", -0.5)
+        self.declare_parameter("gripper_release_delay", 0.25)
+        self.declare_parameter("record_transition_topic", "")
+        self.declare_parameter("record_button", -1)
+        self.declare_parameter("save_button", 0)
+        self.declare_parameter("delete_button", 1)
+        self.declare_parameter("gripper_requires_deadman", True)
+        self.declare_parameter("gripper_open_value", 1.0)
+        self.declare_parameter("gripper_closed_value", 0.0)
+        self.declare_parameter("publish_rate", 30.0)
+        self.declare_parameter("translation_scale", 0.15)
+        self.declare_parameter("x_scale", 1.0)
+        self.declare_parameter("y_scale", 1.0)
+        self.declare_parameter("z_scale", 1.0)
+        self.declare_parameter("rotation_scale", 0.0)
+        self.declare_parameter("rotation_representation", "euler_xyz")
+        self.declare_parameter("max_step", 0.03)
+        self.declare_parameter("max_translation_step", 0.03)
+        self.declare_parameter("max_rotation_step", 0.08)
+        self.declare_parameter("quest_to_franka_matrix", "")
+        self.declare_parameter("x_sign", 1.0)
+        self.declare_parameter("y_sign", 1.0)
+        self.declare_parameter("z_sign", 1.0)
+        self.declare_parameter("x_axis", "x")
+        self.declare_parameter("y_axis", "y")
+        self.declare_parameter("z_axis", "z")
+        self.declare_parameter("roll_sign", 1.0)
+        self.declare_parameter("pitch_sign", 1.0)
+        self.declare_parameter("yaw_sign", 1.0)
+
+        self.quest_pose_topic = str(self.get_parameter("quest_pose_topic").value)
+        self.quest_joy_topic = str(self.get_parameter("quest_joy_topic").value)
+        self.output_pose_topic = str(self.get_parameter("output_pose_topic").value)
+        self.output_gripper_topic = str(
+            self.get_parameter("output_gripper_topic").value
+        )
+        self.output_delta_action_topic = str(
+            self.get_parameter("output_delta_action_topic").value
+        )
+        self.franka_gripper_command_topic = str(
+            self.get_parameter("franka_gripper_command_topic").value
+        )
+        self.publish_target_pose_enabled = bool(
+            self.get_parameter("publish_target_pose").value
+        )
+        self.target_pose_topic = str(self.get_parameter("target_pose_topic").value)
+        self.current_pose_topic = str(self.get_parameter("current_pose_topic").value)
+        self.output_frame_id = str(self.get_parameter("output_frame_id").value)
+        self.target_frame_id = str(self.get_parameter("target_frame_id").value)
+        self.deadman_button = int(self.get_parameter("deadman_button").value)
+        self.deadman_latch_button = int(
+            self.get_parameter("deadman_latch_button").value
+        )
+        self.reset_button = int(self.get_parameter("reset_button").value)
+        self.pause_button = int(self.get_parameter("pause_button").value)
+        self.gripper_button = int(self.get_parameter("gripper_button").value)
+        self.trigger_axis = int(self.get_parameter("trigger_axis").value)
+        self.trigger_threshold = float(self.get_parameter("trigger_threshold").value)
+        self.gripper_release_delay = float(
+            self.get_parameter("gripper_release_delay").value
+        )
+        self.record_transition_topic = str(
+            self.get_parameter("record_transition_topic").value
+        )
+        self.record_button = int(self.get_parameter("record_button").value)
+        self.save_button = int(self.get_parameter("save_button").value)
+        self.delete_button = int(self.get_parameter("delete_button").value)
+        self.gripper_requires_deadman = bool(
+            self.get_parameter("gripper_requires_deadman").value
+        )
+        self.gripper_open_value = float(self.get_parameter("gripper_open_value").value)
+        self.gripper_closed_value = float(
+            self.get_parameter("gripper_closed_value").value
+        )
+        self.translation_scale = float(self.get_parameter("translation_scale").value)
+        self.axis_scale = np.array(
+            [
+                float(self.get_parameter("x_scale").value),
+                float(self.get_parameter("y_scale").value),
+                float(self.get_parameter("z_scale").value),
+            ],
+            dtype=float,
+        )
+        self.rotation_scale = float(self.get_parameter("rotation_scale").value)
+        self.rotation_representation = str(
+            self.get_parameter("rotation_representation").value
+        )
+        _rotation_to_action(Rotation.identity(), self.rotation_representation)
+
+        max_step = float(self.get_parameter("max_step").value)
+        max_translation_step = float(self.get_parameter("max_translation_step").value)
+        if max_step != 0.03 and max_translation_step == 0.03:
+            max_translation_step = max_step
+        self.max_translation_step = max_translation_step
+        self.max_rotation_step = float(self.get_parameter("max_rotation_step").value)
+
+        axis_sign = np.array(
+            [
+                float(self.get_parameter("x_sign").value),
+                float(self.get_parameter("y_sign").value),
+                float(self.get_parameter("z_sign").value),
+            ],
+            dtype=float,
+        )
+        axis_selectors = [
+            str(self.get_parameter("x_axis").value),
+            str(self.get_parameter("y_axis").value),
+            str(self.get_parameter("z_axis").value),
+        ]
+        parsed_matrix = _parse_matrix_param(
+            str(self.get_parameter("quest_to_franka_matrix").value)
+        )
+        self.quest_to_franka = (
+            parsed_matrix
+            if parsed_matrix is not None
+            else _axis_mapping_matrix(axis_selectors, axis_sign)
+        )
+        self.rotation_sign = np.array(
+            [
+                float(self.get_parameter("roll_sign").value),
+                float(self.get_parameter("pitch_sign").value),
+                float(self.get_parameter("yaw_sign").value),
+            ],
+            dtype=float,
+        )
+
+        publish_rate = max(1.0, float(self.get_parameter("publish_rate").value))
+
+        self.pose_pub = self.create_publisher(PoseStamped, self.output_pose_topic, 10)
+        self.gripper_pub = self.create_publisher(Float32, self.output_gripper_topic, 10)
+        self.delta_action_pub = self.create_publisher(
+            Float64MultiArray,
+            self.output_delta_action_topic,
+            10,
+        )
+        self.franka_gripper_pub = (
+            self.create_publisher(
+                Float64MultiArray,
+                self.franka_gripper_command_topic,
+                10,
+            )
+            if self.franka_gripper_command_topic
+            else None
+        )
+        self.record_transition_pub = (
+            self.create_publisher(String, self.record_transition_topic, 10)
+            if self.record_transition_topic
+            else None
+        )
+        self.target_pose_pub = (
+            self.create_publisher(PoseStamped, self.target_pose_topic, 10)
+            if self.publish_target_pose_enabled
+            else None
+        )
+
+        self.enabled = False
+        self.paused = False
+        self.teleop_latched = False
+        self.current_gripper = self.gripper_open_value
+        self.gripper_last_pressed_time = 0.0
+        self.last_raw_pos: np.ndarray | None = None
+        self.last_raw_rot: Rotation | None = None
+        self.virtual_pos = np.zeros(3, dtype=float)
+        self.virtual_rot = Rotation.identity()
+        self.pending_delta_pos = np.zeros(3, dtype=float)
+        self.pending_delta_rot = Rotation.identity()
+        self.target_pos: np.ndarray | None = None
+        self.target_rot: Rotation | None = None
+        self.warned_missing_current_pose = False
+        self.reanchor_requested = False
+        self.reset_button_was_pressed = False
+        self.deadman_latch_was_pressed = False
+        self.record_button_was_pressed = False
+        self.save_button_was_pressed = False
+        self.delete_button_was_pressed = False
+
+        self.create_subscription(PoseStamped, self.quest_pose_topic, self.on_pose, 10)
+        self.create_subscription(Joy, self.quest_joy_topic, self.on_joy, 10)
+        if self.publish_target_pose_enabled:
+            self.create_subscription(
+                PoseStamped,
+                self.current_pose_topic,
+                self.on_current_pose,
+                10,
+            )
+        self.create_timer(1.0 / publish_rate, self.publish_stream)
+
+        self.get_logger().info(f"Quest pose topic: {self.quest_pose_topic}")
+        self.get_logger().info(f"Quest joy topic: {self.quest_joy_topic}")
+        self.get_logger().info(
+            f"Publishing {self.output_pose_topic} and {self.output_gripper_topic}"
+        )
+        self.get_logger().info(
+            "Quest-to-Franka base transform matrix: "
+            f"{np.array2string(self.quest_to_franka, precision=3)}"
+        )
+        self.get_logger().info(
+            "Quest translation scale: "
+            f"{self.translation_scale:.3f}, axis scale: "
+            f"{np.array2string(self.axis_scale, precision=3)}"
+        )
+        self.get_logger().info(
+            "Publishing 7D delta end-pose actions on "
+            f"{self.output_delta_action_topic} as "
+            f"[dx, dy, dz, d{self.rotation_representation}, gripper]"
+        )
+        if self.franka_gripper_pub is not None:
+            self.get_logger().info(
+                f"Publishing Franka gripper commands on {self.franka_gripper_command_topic}"
+            )
+        if self.deadman_latch_button >= 0:
+            self.get_logger().info(
+                "Quest teleop latch enabled: button "
+                f"{self.deadman_latch_button} toggles teleop on/off."
+            )
+        if self.record_transition_pub is not None:
+            self.get_logger().info(
+                "Publishing recording commands on "
+                f"{self.record_transition_topic}: record button={self.record_button}, "
+                f"save button={self.save_button}, delete button={self.delete_button}."
+            )
+        if self.target_pose_pub is not None:
+            self.get_logger().info(
+                f"Publishing absolute target poses on {self.target_pose_topic}; "
+                f"initial target comes from {self.current_pose_topic}. "
+                "Start cartesian_impedance_controller separately and keep other "
+                "target_pose publishers stopped."
+            )
+        if self.rotation_scale == 0.0:
+            self.get_logger().info("Quest orientation streaming is disabled.")
+
+    def on_current_pose(self, msg: PoseStamped) -> None:
+        """Initialize direct target-pose publishing from the robot's current pose."""
+        if self.target_pos is not None and self.target_rot is not None:
+            return
+
+        position, rotation = _pose_to_arrays(msg)
+        if rotation is None:
+            return
+
+        self.target_pos = position
+        self.target_rot = rotation
+        self.get_logger().info("Initialized Quest target_pose from current_pose.")
+
+    def on_joy(self, msg: Joy) -> None:
+        """Handle deadman, reset, pause, and trigger input."""
+        latch_pressed = _button_pressed(msg, self.deadman_latch_button)
+        if latch_pressed and not self.deadman_latch_was_pressed:
+            self.teleop_latched = not self.teleop_latched
+            self.reanchor_requested = self.teleop_latched
+            state = "enabled" if self.teleop_latched else "disabled"
+            self.get_logger().info(f"Quest teleop latch {state}.")
+        self.deadman_latch_was_pressed = latch_pressed
+
+        deadman_pressed = self.deadman_button < 0 or _button_pressed(
+            msg,
+            self.deadman_button,
+        )
+
+        reset_pressed = _button_pressed(msg, self.reset_button)
+        if reset_pressed and not self.reset_button_was_pressed:
+            self.reanchor_requested = True
+            self.get_logger().info("Quest controller re-anchor requested.")
+        self.reset_button_was_pressed = reset_pressed
+
+        if _button_pressed(msg, self.pause_button):
+            self.paused = True
+
+        if self.deadman_latch_button >= 0:
+            self.enabled = self.teleop_latched and not self.paused
+        elif not deadman_pressed:
+            self.enabled = False
+            self.paused = False
+        else:
+            self.enabled = not self.paused
+
+        self._publish_recording_commands(msg)
+
+        control_active = self.enabled if self.deadman_latch_button >= 0 else deadman_pressed
+        if not self.gripper_requires_deadman or control_active:
+            if self.gripper_button >= 0:
+                trigger_pressed = _button_pressed(msg, self.gripper_button)
+            else:
+                trigger_pressed = _axis_pressed(
+                    msg,
+                    self.trigger_axis,
+                    self.trigger_threshold,
+                )
+            now = time.monotonic()
+            if trigger_pressed:
+                self.gripper_last_pressed_time = now
+                gripper_should_close = True
+            else:
+                gripper_should_close = (
+                    now - self.gripper_last_pressed_time
+                ) < self.gripper_release_delay
+            self.current_gripper = (
+                self.gripper_closed_value
+                if gripper_should_close
+                else self.gripper_open_value
+            )
+
+    def _publish_recording_commands(self, msg: Joy) -> None:
+        """Publish ROS recording-manager commands from Quest button edges."""
+        if self.record_transition_pub is None:
+            return
+
+        record_pressed = _button_pressed(msg, self.record_button)
+        if record_pressed != self.record_button_was_pressed:
+            self._publish_record_transition("record")
+        self.record_button_was_pressed = record_pressed
+
+        save_pressed = _button_pressed(msg, self.save_button)
+        if save_pressed and not self.save_button_was_pressed:
+            self._publish_record_transition("save")
+        self.save_button_was_pressed = save_pressed
+
+        delete_pressed = _button_pressed(msg, self.delete_button)
+        if delete_pressed and not self.delete_button_was_pressed:
+            self._publish_record_transition("delete")
+        self.delete_button_was_pressed = delete_pressed
+
+    def _publish_record_transition(self, command: str) -> None:
+        """Publish one recording-manager transition command."""
+        if self.record_transition_pub is None:
+            return
+        msg = String()
+        msg.data = command
+        self.record_transition_pub.publish(msg)
+        self.get_logger().info(f"Quest recording command: {command}")
+
+    def on_pose(self, msg: PoseStamped) -> None:
+        """Accumulate controller motion while the deadman is held."""
+        raw_pos, raw_rot = _pose_to_arrays(msg)
+        if raw_rot is None:
+            raw_rot = (
+                self.last_raw_rot
+                if self.last_raw_rot is not None
+                else Rotation.identity()
+            )
+
+        if self.last_raw_pos is None or self.last_raw_rot is None:
+            self.last_raw_pos = raw_pos
+            self.last_raw_rot = raw_rot
+            return
+
+        if self.reanchor_requested:
+            self.last_raw_pos = raw_pos
+            self.last_raw_rot = raw_rot
+            self.reanchor_requested = False
+            self.get_logger().info(
+                "Quest controller re-anchored without moving robot target."
+            )
+            return
+
+        raw_delta = raw_pos - self.last_raw_pos
+        raw_delta_rot = raw_rot * self.last_raw_rot.inv()
+        self.last_raw_pos = raw_pos
+        self.last_raw_rot = raw_rot
+
+        if not self.enabled:
+            return
+
+        mapped_delta = self.quest_to_franka @ raw_delta
+        scaled_delta = mapped_delta * self.axis_scale * self.translation_scale
+        clipped_delta = _clip_vector_norm(scaled_delta, self.max_translation_step)
+        self.virtual_pos += clipped_delta
+        self.pending_delta_pos += clipped_delta
+
+        delta_rot = Rotation.identity()
+        if self.rotation_scale > 0.0:
+            mapped_rotvec = self.quest_to_franka @ raw_delta_rot.as_rotvec()
+            scaled_rotvec = mapped_rotvec * self.rotation_sign * self.rotation_scale
+            clipped_rotvec = _clip_vector_norm(scaled_rotvec, self.max_rotation_step)
+            delta_rot = Rotation.from_rotvec(clipped_rotvec)
+            self.virtual_rot = delta_rot * self.virtual_rot
+            self.pending_delta_rot = delta_rot * self.pending_delta_rot
+
+        if (
+            self.target_pose_pub is not None
+            and self.target_pos is not None
+            and self.target_rot is not None
+        ):
+            self.target_pos = self.target_pos + clipped_delta
+            self.target_rot = delta_rot * self.target_rot
+
+    def publish_stream(self) -> None:
+        """Publish the virtual teleop pose, delta action, and gripper state."""
+        stamp = self.get_clock().now().to_msg()
+
+        pose_msg = PoseStamped()
+        pose_msg.header.stamp = stamp
+        pose_msg.header.frame_id = self.output_frame_id
+        pose_msg.pose.position.x = float(self.virtual_pos[0])
+        pose_msg.pose.position.y = float(self.virtual_pos[1])
+        pose_msg.pose.position.z = float(self.virtual_pos[2])
+        quat = self.virtual_rot.as_quat()
+        pose_msg.pose.orientation.x = float(quat[0])
+        pose_msg.pose.orientation.y = float(quat[1])
+        pose_msg.pose.orientation.z = float(quat[2])
+        pose_msg.pose.orientation.w = float(quat[3])
+        self.pose_pub.publish(pose_msg)
+
+        gripper_msg = Float32()
+        gripper_msg.data = float(self.current_gripper)
+        self.gripper_pub.publish(gripper_msg)
+
+        rot_action = _rotation_to_action(
+            self.pending_delta_rot,
+            self.rotation_representation,
+        )
+        delta_action_msg = Float64MultiArray()
+        delta_action_msg.data = [
+            float(self.pending_delta_pos[0]),
+            float(self.pending_delta_pos[1]),
+            float(self.pending_delta_pos[2]),
+            float(rot_action[0]),
+            float(rot_action[1]),
+            float(rot_action[2]),
+            float(self.current_gripper),
+        ]
+        self.delta_action_pub.publish(delta_action_msg)
+        self.pending_delta_pos = np.zeros(3, dtype=float)
+        self.pending_delta_rot = Rotation.identity()
+
+        if self.franka_gripper_pub is not None:
+            franka_gripper_msg = Float64MultiArray()
+            franka_gripper_msg.data = [float(self.current_gripper)]
+            self.franka_gripper_pub.publish(franka_gripper_msg)
+
+        if self.target_pose_pub is None:
+            return
+
+        if self.target_pos is None or self.target_rot is None:
+            if not self.warned_missing_current_pose:
+                self.get_logger().warning(
+                    "Waiting for current_pose before publishing target_pose."
+                )
+                self.warned_missing_current_pose = True
+            return
+
+        target_pose_msg = PoseStamped()
+        target_pose_msg.header.stamp = stamp
+        target_pose_msg.header.frame_id = self.target_frame_id
+        target_pose_msg.pose.position.x = float(self.target_pos[0])
+        target_pose_msg.pose.position.y = float(self.target_pos[1])
+        target_pose_msg.pose.position.z = float(self.target_pos[2])
+        target_quat = self.target_rot.as_quat()
+        target_pose_msg.pose.orientation.x = float(target_quat[0])
+        target_pose_msg.pose.orientation.y = float(target_quat[1])
+        target_pose_msg.pose.orientation.z = float(target_quat[2])
+        target_pose_msg.pose.orientation.w = float(target_quat[3])
+        self.target_pose_pub.publish(target_pose_msg)
+
+
+def main() -> None:
+    rclpy.init()
+    node = Quest3StreamAdapter()
+    try:
+        rclpy.spin(node)
+    except (KeyboardInterrupt, ExternalShutdownException):
+        pass
+    finally:
+        node.destroy_node()
+        if rclpy.ok():
+            rclpy.shutdown()
+
+
+if __name__ == "__main__":
+    main()
